# OpenAI-compatible Chat Completions endpoint base URL (ending in /v1)
KROMA_BASE_URL=https://api.openai.com/v1
KROMA_API_KEY=your-api-key
KROMA_MODEL=your-model-id

# Optional settings
# KROMA_WORKDIR=/path/to/project
# KROMA_SHELL=/c/Program Files/Git/bin/bash.exe  # optional Windows shell override (bash.exe or cmd)
# KROMA_SESSION_FILE=/path/to/conversation.json
# KROMA_DEEPSEEK_THINKING=high  # optional: enabled, high, max (DeepSeek-compatible APIs only)
# KROMA_PROFILE=1  # optional per-task latency and JSON-size diagnostics
# KROMA_CONFIG_FILE=/private/path/config.json # optional provider-profile JSON path
# KROMA_PROVIDER_PROFILE=workbuddy # optional saved provider profile selection
# KROMA_CONTEXT_WINDOW=128000
# KROMA_OUTPUT_RESERVE_TOKENS=4096
