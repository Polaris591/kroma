/target/
/.env
/.env.*
!/.env.example
*.swp
# Python benchmark caches
__pycache__/
*.py[cod]
# Local runtime and conversation artifacts (may contain private data)
/.kroma/
/sessions/
*.json.wal
*.log
# Environment-specific Cargo source mirror; not part of project config
/.cargo/config.toml

# Generated review artifacts: screenshots and exported HTML studies are
# reproducible locally and never belong to a source commit.
/reviews/**/*.html
/reviews/**/*.png

# Generated npm package staging and tarballs
/.npm-dist*/
/npm/.npm-dist*/
