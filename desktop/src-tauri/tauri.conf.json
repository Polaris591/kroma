{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kroma Desktop",
  "version": "0.3.0",
  "identifier": "dev.kroma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kroma Desktop",
        "width": 1280,
        "height": 850,
        "minWidth": 780,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#19191e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
