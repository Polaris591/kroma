digraph {

    graph [
        label="kroma",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "kroma" [label="crate|kroma", fillcolor="#5397c8"]; // "crate" node
    "kroma::agent" [label="pub mod|agent", fillcolor="#81c169"]; // "mod" node
    "kroma::shell" [label="pub mod|shell", fillcolor="#81c169"]; // "mod" node

    "kroma" -> "kroma::agent" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "kroma" -> "kroma::shell" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "kroma::agent" -> "kroma" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "kroma::agent" -> "kroma::shell" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "kroma::shell" -> "kroma" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge

}
