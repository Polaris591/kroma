+/// Killing the client process does not end the daemon's workload — which is exactly why cleanup is
+/// addressed by name. This test demonstrates the defect and then the fix.
+#[test]
+fn kill_cli_still_cleans_daemon_workload() {
+    if !docker_ready() {
+        eprintln!(
+            "SKIP kill_cli_still_cleans_daemon_workload: docker or {} is unavailable",
+            IMAGE
+        );
+        return;
+    }
+    let root = scratch("killcli");
+    let state = root.join("state");
+    std::fs::create_dir_all(&state).unwrap();
+    let name = format!("kroma-killtest-{}", std::process::id());
+    let mut client = std::process::Command::new("docker")
+        .args(["run", "--name", &name, IMAGE, "sleep", "300"])
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .expect("spawn the docker run client");
+    std::thread::sleep(Duration::from_millis(1500));
+
+    // Kill the client the way a supervisor kills a timed-out process group.
+    client.kill().expect("kill the client");
+    let _ = client.wait();
+
+    let workload = ContainerWorkload::adopt("docker", IMAGE, &name, &state).unwrap();
+    let transport = kroma_core::sandbox::ProcessProbeTransport;
+    assert!(
+        workload
+            .exists(&transport, Duration::from_secs(10))
+            .unwrap(),
+        "the daemon workload outlives its client (this is the reason cleanup is by name)"
+    );
+
+    let outcome = workload.cancel(&transport, Duration::from_secs(30));
+    assert!(
+        outcome.is_cleaned(),
+        "expected a confirmed cleanup: {outcome:?}"
+    );
+    assert!(
+        !workload
+            .exists(&transport, Duration::from_secs(10))
+            .unwrap(),
+        "the daemon workload must be gone"
+    );
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A read-only mount (the grading oracle) cannot be modified from inside the container.
+#[test]
+fn container_cannot_modify_oracle_mount() {
+    if !docker_ready() {
+        eprintln!(
+            "SKIP container_cannot_modify_oracle_mount: docker or {} is unavailable",
+            IMAGE
+        );
+        return;
+    }
+    let root = scratch("oracle");
+    let ws = root.join("ws");
+    let oracle = root.join("oracle");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::create_dir_all(&oracle).unwrap();
+    let oracle_file = oracle.join("expected.txt");
+    std::fs::write(&oracle_file, b"oracle").unwrap();
+
+    let mut spec = SandboxSpec::container("docker", IMAGE, &ws);
+    spec = spec.with_ro_extra(&oracle);
+    let out = kroma_core::sandbox::run_bounded(
+        "docker",
+        &spec
+            .wrap_argv(
+                "sh",
+                &[
+                    "-c".to_string(),
+                    format!("printf hacked > {}/expected.txt", oracle.display()),
+                ],
+            )
+            .unwrap(),
+        Duration::from_secs(60),
+    )
+    .expect("run");
+    assert!(
+        !out.success,
+        "writing to the read-only oracle mount must fail, stdout={} stderr={}",
+        out.stdout, out.stderr
+    );
+    assert_eq!(
+        std::fs::read(&oracle_file).unwrap(),
+        b"oracle",
+        "the oracle file must be untouched"
+    );
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Two workloads never collide on a name or a cidfile, so cleanup can never hit the wrong container.
+#[test]
+fn workload_names_and_cidfiles_are_unique() {
+    let state = scratch("unique");
+    let mut names = BTreeSet::new();
+    let mut cidfiles = BTreeSet::new();
+    let seen = Mutex::new(0usize);
+    for _ in 0..32 {
+        let workload = ContainerWorkload::new("docker", IMAGE, "kroma-test", &state).unwrap();
+        assert!(names.insert(workload.name().to_string()), "duplicate name");
+        assert!(
+            cidfiles.insert(workload.cidfile().to_path_buf()),
+            "duplicate cidfile"
+        );
+        *seen.lock().unwrap() += 1;
+    }
+    assert_eq!(*seen.lock().unwrap(), 32);
+    assert_eq!(DEFAULT_CONTROL_BUDGET, Duration::from_secs(15));
+    let _ = std::fs::remove_dir_all(&state);
+}
diff --git a/crates/kroma-core/tests/t11_assembly.rs b/crates/kroma-core/tests/t11_assembly.rs
new file mode 100644
index 0000000..41a4705
--- /dev/null
+++ b/crates/kroma-core/tests/t11_assembly.rs
@@ -0,0 +1,229 @@
+//! T11 (KR-08, KR-33): one assembly path for every door, and accounting that cannot invent a gain.
+//!
+//! The claim being tested is narrow and checkable: for one resolved configuration, the CLI, RPC,
+//! bench, worker and resume doors must produce the *same* plan (same budget, policy, execution
+//! boundary, feature eligibility), and a mechanism that is configured but cannot run must be a
+//! configuration error at start rather than a run that quietly does nothing.
+
+use kroma_core::assembly::{
+    eligible_features, AssemblyError, Feature, FeatureLedger, PlanEnvironment, RunPlan, Surface,
+};
+use kroma_core::config_file::{ConfigOverrides, KromaConfigFile, ResolvedConfig};
+use std::path::PathBuf;
+
+fn resolve(user_toml: &str, workspace_toml: &str) -> ResolvedConfig {
+    let user = KromaConfigFile::parse_str(user_toml).expect("user config");
+    let workspace = KromaConfigFile::parse_str(workspace_toml).expect("workspace config");
+    ResolvedConfig::resolve(
+        &user,
+        &workspace,
+        &Default::default(),
+        &ConfigOverrides::default(),
+        None,
+        PathBuf::from("/tmp/ws/.kroma.toml"),
+    )
+}
+
+/// The matrix the task card names: every door, one digest.
+#[test]
+fn feature_matrix_covers_cli_rpc_bench_worker_resume() {
+    let config = resolve(
+        "model = \"m\"\nmax_tokens = 200000\nmax_subagents = 4\npolicy = \"workspace_write\"\nprojection_profile = \"p2\"\nexecution_sandbox = \"bwrap\"\nadaptive_tournament = 2\n",
+        "",
+    );
+
+    let mut digests = std::collections::BTreeSet::new();
+    let mut eligible_sets = std::collections::BTreeSet::new();
+    for surface in Surface::all() {
+        let plan = RunPlan::from_resolved(&config, surface).expect("plan");
+        assert_eq!(plan.surface, surface, "the plan must record its door");
+        digests.insert(plan.digest());
+        eligible_sets.insert(
+            eligible_features(&plan)
+                .into_iter()
+                .map(Feature::as_str)
+                .collect::<Vec<_>>()
+                .join(","),
+        );
+    }
+    assert_eq!(
+        digests.len(),
+        1,
+        "the same configuration produced {} different plans across surfaces",
+        digests.len()
+    );
+    assert_eq!(
+        eligible_sets.len(),
+        1,
+        "surfaces disagreed on which features are eligible"
+    );
+    let eligible = eligible_sets.into_iter().next().unwrap();
+    assert!(
+        eligible.contains("counterfactual_arm")
+            && eligible.contains("context_compaction")
+            && eligible.contains("snapshot_store"),
+        "expected the configured mechanisms to be eligible, got {eligible}"
+    );
+}
+
+/// Same name, sharper claim: policy fields specifically must not differ per surface.
+#[test]
+fn same_run_plan_has_same_policy_across_all_surfaces() {
+    let config = resolve(
+        "policy = \"read_only\"\nverify_command = \"cargo test\"\nexecution_sandbox = \"bwrap\"\nmax_tokens = 5000\n",
+        "",
+    );
+    let baseline = RunPlan::from_resolved(&config, Surface::Cli).expect("plan");
+    for surface in [
+        Surface::Rpc,
+        Surface::Bench,
+        Surface::Worker,
+        Surface::Resume,
+    ] {
+        let plan = RunPlan::from_resolved(&config, surface).expect("plan");
+        assert_eq!(
+            plan.policy, baseline.policy,
+            "policy differs for {surface:?}"
+        );
+        assert_eq!(
+            plan.budget, baseline.budget,
+            "budget differs for {surface:?}"
+        );
+        assert_eq!(
+            plan.digest(),
+            baseline.digest(),
+            "digest differs for {surface:?}"
+        );
+    }
+
+    // The digest must actually depend on the configuration, or the equality above is vacuous.
+    let other = resolve("policy = \"read_only\"\nmax_tokens = 5001\n", "");
+    assert_ne!(
+        RunPlan::from_resolved(&other, Surface::Cli)
+            .unwrap()
+            .digest(),
+        baseline.digest(),
+        "a different max_tokens must change the plan digest"
+    );
+}
+
+/// A mechanism whose dependency is missing fails at configuration time.
+#[test]
+fn missing_feature_dependency_fails_at_start() {
+    // Counterfactual arm on the host: it would race candidates outside any boundary.
+    let config = resolve("adaptive_tournament = 2\n", "");
+    match RunPlan::from_resolved(&config, Surface::Cli) {
+        Err(AssemblyError::MissingDependency { feature, requires }) => {
+            assert_eq!(feature, Feature::CounterfactualArm);
+            assert!(
+                requires.contains("isolated execution backend"),
+                "unexpected requirement: {requires}"
+            );
+        }
+        other => panic!("expected a missing-dependency error, got {other:?}"),
+    }
+
+    // The same configuration with an isolated backend is accepted.
+    let ok = resolve(
+        "adaptive_tournament = 2\nexecution_sandbox = \"bwrap\"\n",
+        "",
+    );
+    assert!(RunPlan::from_resolved(&ok, Surface::Cli).is_ok());
+
+    // An unknown projection profile is a configuration error, not a silent baseline. The file parser
+    // already refuses `p9`, so this mutates the resolved value directly: the plan is a second,
+    // independent gate (a caller can build a `ResolvedConfig` without going through the parser).
+    let mut bad = resolve("", "");
+    bad.projection_profile = Some("p9".to_string());
+    match RunPlan::from_resolved(&bad, Surface::Cli) {
+        Err(AssemblyError::InvalidValue { key, .. }) => assert_eq!(key, "projection_profile"),
+        other => panic!("expected an invalid-value error, got {other:?}"),
+    }
+}
+
+/// The counterfactual arm also needs the snapshot store it probes against.
+#[test]
+fn missing_snapshot_dependency_is_configuration_error() {
+    let config = resolve(
+        "adaptive_tournament = 3\nexecution_sandbox = \"bwrap\"\n",
+        "",
+    );
+    let env = PlanEnvironment {
+        snapshot_store_available: false,
+        experience_file: None,
+    };
+    match RunPlan::from_resolved_with_env(&config, Surface::Bench, &env) {
+        Err(AssemblyError::MissingDependency { feature, requires }) => {
+            assert_eq!(feature, Feature::CounterfactualArm);
+            assert_eq!(requires, "the revision snapshot store");
+        }
+        other => panic!("expected a snapshot-dependency error, got {other:?}"),
+    }
+    // With the store available the same configuration assembles.
+    assert!(
+        RunPlan::from_resolved_with_env(&config, Surface::Bench, &PlanEnvironment::default())
+            .is_ok()
+    );
+
+    // Experience is only eligible when an operator file was actually supplied.
+    let with_file = PlanEnvironment {
+        snapshot_store_available: true,
+        experience_file: Some("/etc/kroma/experience.json".to_string()),
+    };
+    let plan = RunPlan::from_resolved_with_env(&config, Surface::Cli, &with_file).unwrap();
+    assert!(plan.features[&Feature::Experience].eligible);
+    let without = RunPlan::from_resolved(&config, Surface::Cli).unwrap();
+    assert!(!without.features[&Feature::Experience].eligible);
+}
+
+/// Configured is not executed. A report may only present `executed` counts as a gain.
+#[test]
+fn zero_eligible_events_is_reported_not_invented_gain() {
+    let mut ledger = FeatureLedger::new();
+    // Configured, never eligible: e.g. a counterfactual arm whose candidates were all rejected
+    // before any probe ran.
+    ledger.record_configured(Feature::CounterfactualArm);
+    ledger.record_skipped(
+        Feature::CounterfactualArm,
+        "no candidate reached the probe stage",
+    );
+
+    assert!(
+        ledger.headline_gains().is_empty(),
+        "a configured-but-unexecuted feature must not appear as a gain: {:?}",
+        ledger.headline_gains()
+    );
+    let zero = ledger.zero_execution_report();
+    assert_eq!(zero.len(), 1);
+    assert_eq!(zero[0].0, Feature::CounterfactualArm);
+    assert_eq!(
+        zero[0]
+            .1
+            .skipped
+            .get("no candidate reached the probe stage"),
+        Some(&1)
+    );
+    assert!(ledger.summary().contains("executed=0"));
+
+    // Eligible and executed is a gain; eligible and skipped is still not.
+    ledger.record_eligible(Feature::ContextCompaction);
+    ledger.record_executed(Feature::ContextCompaction);
+    ledger.record_eligible(Feature::Experience);
+    ledger.record_skipped(Feature::Experience, "operator file rejected at import");
+    let gains = ledger.headline_gains();
+    assert_eq!(gains, vec![(Feature::ContextCompaction, 1)]);
+    assert!(
+        !gains.iter().any(|(f, _)| *f == Feature::Experience),
+        "an eligible-but-skipped feature is not a gain"
+    );
+    // executed can never exceed eligible in a well-formed ledger, and the counters keep them apart.
+    let compaction = ledger.counters(Feature::ContextCompaction).unwrap();
+    assert_eq!(
+        (
+            compaction.configured,
+            compaction.eligible,
+            compaction.executed
+        ),
+        (0, 1, 1)
+    );
+}
diff --git a/crates/kroma-core/tests/t12_tool_discovery_loop.rs b/crates/kroma-core/tests/t12_tool_discovery_loop.rs
new file mode 100644
index 0000000..04a6ab8
--- /dev/null
+++ b/crates/kroma-core/tests/t12_tool_discovery_loop.rs
@@ -0,0 +1,434 @@
+//! T12 (KR-09): discovery → activation → call → result → unmount, as a real round trip.
+//!
+//! The defect this pins: `discover_tools` used to print a catalog into a tool *result* while the next
+//! request's `tools` array still held only the core set. A provider that enforces "you may only call
+//! a declared tool" — which is what the wire protocols do — could therefore never call what it had
+//! just discovered. The loop was open exactly where it mattered.
+
+use kroma_core::budget::BudgetConfig;
+use kroma_core::events::EventLogger;
+use kroma_core::messages::{AssistantTurn, FinishReason, TokenUsage, ToolCall};
+use kroma_core::provider::{ModelProvider, ProviderCompletion, ProviderError, ProviderRequest};
+use kroma_core::session::SessionJournal;
+use kroma_core::tool::activation::{
+    ActivationError, ToolActivation, MAX_ACTIVE_SCHEMA_BYTES, MAX_ACTIVE_TOOLS,
+};
+use kroma_core::tool::definition::{RegisteredTool, ToolDefinition, ToolMetadata};
+use kroma_core::tool::policy::{NonInteractiveApprovalHandler, PolicyEngine, PolicyMode};
+use kroma_core::tool::registry::ToolRegistry;
+use kroma_core::tool::runtime::ToolRuntime;
+use kroma_core::types::EffectClass;
+use kroma_core::types::ToolCallId;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+
+fn tool(name: &str, schema_bytes: usize) -> RegisteredTool {
+    let mut parameters = serde_json::json!({"type": "object", "properties": {}});
+    if schema_bytes > 0 {
+        parameters["properties"]["pad"] = serde_json::json!({
+            "type": "string",
+            "description": "p".repeat(schema_bytes)
+        });
+    }
+    RegisteredTool {
+        definition: ToolDefinition {
+            name: name.to_string(),
+            description: format!("{} tool", name),
+            parameters,
+        },
+        metadata: ToolMetadata {
+            effect_class: EffectClass::ReadOnly,
+            default_timeout_sec: 30,
+            inline_output_cap_bytes: 4096,
+        },
+    }
+}
+
+fn activation_for(tools: &[RegisteredTool]) -> ToolActivation {
+    let mut state = ToolActivation::new();
+    for t in tools {
+        state.activate(t, true).unwrap();
+    }
+    state
+}
+
+/// Discovery must never widen authority: a policy-denied tool cannot be activated.
+#[test]
+fn discover_never_activates_denied_tool() {
+    let registry = ToolRegistry::new(None);
+    let runtime = ToolRuntime::new(
+        registry,
+        PolicyEngine::new(
+            PolicyMode::ReadOnly,
+            Arc::new(NonInteractiveApprovalHandler),
+        ),
+        Arc::new(
+            kroma_core::env::LocalHostEnv::new(
+                std::env::temp_dir(),
+                std::env::temp_dir().join("kroma-t12-state"),
+            )
+            .unwrap(),
+        ),
+        BudgetConfig::default(),
+    );
+
+    // `write` exists but is denied under ReadOnly.
+    let results = runtime.activate_tools(&["write".to_string()]);
+    assert_eq!(results.len(), 1);
+    match &results[0].1 {
+        Err(ActivationError::DeniedByPolicy(name)) => assert_eq!(name, "write"),
+        other => panic!("expected a policy refusal, got {other:?}"),
+    }
+    assert!(
+        runtime.active_tool_names().is_empty(),
+        "a refused activation must not appear in the active set"
+    );
+    assert!(
+        !runtime
+            .activated_tool_definitions()
+            .iter()
+            .any(|d| d.name == "write"),
+        "a denied tool must not gain a schema"
+    );
+
+    // An unknown name is refused as unknown, not silently ignored.
+    let unknown = runtime.activate_tools(&["no_such_tool".to_string()]);
+    assert!(matches!(unknown[0].1, Err(ActivationError::UnknownTool(_))));
+
+    // A permitted, non-core tool activates and gets a schema.
+    let ok = runtime.activate_tools(&["code_graph".to_string()]);
+    assert!(ok[0].1.is_ok(), "code_graph should activate: {:?}", ok[0].1);
+    assert!(runtime
+        .activated_tool_definitions()
+        .iter()
+        .any(|d| d.name == "code_graph"));
+}
+
+/// Budgets are enforced, and the schema hash of what was activated is recorded.
+#[test]
+fn schema_activation_budget_and_cache_transition_are_logged() {
+    let tools: Vec<RegisteredTool> = (0..(MAX_ACTIVE_TOOLS + 2))
+        .map(|i| tool(&format!("t{}", i), 0))
+        .collect();
+    let mut state = ToolActivation::new();
+    for t in tools.iter().take(MAX_ACTIVE_TOOLS) {
+        state.activate(t, true).unwrap();
+    }
+    let before_digest = state.digest();
+    // The count cap is a refusal, not a silent truncation.
+    match state.activate(&tools[MAX_ACTIVE_TOOLS], true) {
+        Err(ActivationError::TooManyActive { limit }) => assert_eq!(limit, MAX_ACTIVE_TOOLS),
+        other => panic!("expected TooManyActive, got {other:?}"),
+    }
+    assert_eq!(state.len(), MAX_ACTIVE_TOOLS);
+
+    // Every activation records a schema hash and byte count.
+    for record in state.records() {
+        assert_eq!(record.schema_hash.len(), 64);
+        assert!(record.schema_bytes > 0);
+    }
+    // Order is monotonic and stable, so two requests can be diffed.
+    let orders: Vec<u64> = state.records().iter().map(|r| r.order).collect();
+    assert_eq!(orders, (0..MAX_ACTIVE_TOOLS as u64).collect::<Vec<_>>());
+
+    // One tool whose schema alone is over the byte budget is refused.
+    let huge = tool("huge", MAX_ACTIVE_SCHEMA_BYTES);
+    let mut fresh = ToolActivation::new();
+    match fresh.activate(&huge, true) {
+        Err(ActivationError::SchemaTooLarge { .. })
+        | Err(ActivationError::SchemaBudgetExceeded { .. }) => {}
+        other => panic!("expected a byte-budget refusal, got {other:?}"),
+    }
+
+    // Deactivation changes the digest: the cache boundary moved.
+    let mut state = activation_for(&tools[..2]);
+    let with_two = state.digest();
+    state.deactivate("t0");
+    assert_ne!(state.digest(), with_two);
+    assert_ne!(state.digest(), before_digest);
+    assert!(!state.is_active("t0"));
+}
+
+/// Unmounting removes the schema *and* the dispatch: there is no second copy to go stale.
+#[test]
+fn unmount_removes_schema_and_dispatch() {
+    let registry = ToolRegistry::new(None);
+    let probe = tool("t12_probe", 0);
+    let extension =
+        kroma_core::extensions::ScopedExtension::new(kroma_core::extensions::ExtensionManifest {
+            name: "t12-ext".to_string(),
+            version: "1.0.0".to_string(),
+            api_version: "1.0.0".to_string(),
+            capabilities: vec!["tools".to_string()],
+            trust_level: kroma_core::extensions::ExtensionTrustLevel::OperatorTrusted,
+            source: "test".to_string(),
+            checksum: None,
+        })
+        .with_tool(kroma_core::extensions::ScopedToolDefinition {
+            definition: probe.definition.clone(),
+            metadata: probe.metadata,
+            handler: Arc::new(
+                |_raw: &str, _ctx: &kroma_core::extensions::CustomToolContext<'_>| {
+                    kroma_core::tools::ToolExecutionOutput::success(
+                        "probe".to_string(),
+                        kroma_core::messages::ToolResultMeta::default(),
+                    )
+                },
+            ),
+        });
+    let id = registry.register_extension(extension).expect("register");
+    let runtime = ToolRuntime::new(
+        registry,
+        PolicyEngine::new(
+            PolicyMode::AllowWrite,
+            Arc::new(NonInteractiveApprovalHandler),
+        ),
+        Arc::new(
+            kroma_core::env::LocalHostEnv::new(
+                std::env::temp_dir(),
+                std::env::temp_dir().join("kroma-t12-unmount"),
+            )
+            .unwrap(),
+        ),
+        BudgetConfig::default(),
+    );
+
+    let activated = runtime.activate_tools(&["t12_probe".to_string()]);
+    assert!(activated[0].1.is_ok(), "{:?}", activated[0].1);
+    assert!(runtime
+        .activated_tool_definitions()
+        .iter()
+        .any(|d| d.name == "t12_probe"));
+
+    runtime
+        .registry()
+        .unregister_extension(&id)
+        .expect("unmount");
+
+    assert!(
+        !runtime
+            .activated_tool_definitions()
+            .iter()
+            .any(|d| d.name == "t12_probe"),
+        "an unmounted tool must not keep a schema"
+    );
+    assert!(
+        runtime.active_tool_names().is_empty(),
+        "the stale activation must be pruned"
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// The whole loop through a real run, against a provider that only permits declared tools
+// ---------------------------------------------------------------------------------------------
+
+/// A provider that behaves like the wire protocols: calling a tool that was not declared in this
+/// request is a protocol error, not something the harness quietly tolerates.
+struct StrictProvider {
+    turns: Mutex<std::collections::VecDeque<AssistantTurn>>,
+    seen_tools: Arc<Mutex<Vec<Vec<String>>>>,
+    violations: Arc<Mutex<Vec<String>>>,
+}
+
+impl ModelProvider for StrictProvider {
+    fn complete<'a>(
+        &'a self,
+        req: ProviderRequest,
+        _budget: &'a BudgetConfig,
+        _cancel_rx: tokio::sync::watch::Receiver<bool>,
+    ) -> Pin<Box<dyn Future<Output = Result<ProviderCompletion, ProviderError>> + Send + 'a>> {
+        let declared: Vec<String> = req.tools.iter().map(|t| t.name.clone()).collect();
+        self.seen_tools.lock().unwrap().push(declared.clone());
+        let turn = self
+            .turns
+            .lock()
+            .unwrap()
+            .pop_front()
+            .expect("scripted turn");
+        for call in &turn.tool_calls {
+            if !declared.iter().any(|name| name == &call.name) {
+                self.violations
+                    .lock()
+                    .unwrap()
+                    .push(format!("{} called but not declared", call.name));
+            }
+        }
+        Box::pin(async move {
+            Ok(ProviderCompletion {
+                turn,
+                request_body_bytes: 1,
+                latency_ms: 1,
+                ttft_ms: None,
+                attempts_used: 1,
+                reported_model: None,
+            })
+        })
+    }
+}
+
+fn usage() -> Option<TokenUsage> {
+    Some(TokenUsage {
+        input_tokens: 100,
+        cache_creation_input_tokens: None,
+        output_tokens: 10,
+        reasoning_tokens: None,
+        cached_input_tokens: None,
+    })
+}
+
+fn call(id: &str, name: &str, args: serde_json::Value) -> ToolCall {
+    ToolCall {
+        call_id: ToolCallId::new(id),
+        name: name.to_string(),
+        raw_arguments: args.to_string(),
+    }
+}
+
+#[tokio::test]
+async fn strict_provider_can_call_newly_discovered_tool() {
+    use kroma_core::agent_loop::{build_default_runtime, AgentRunConfig, AgentRunner};
+
+    let root = std::env::temp_dir().join(format!("kroma-t12-loop-{}", uuid::Uuid::new_v4()));
+    let ws = root.join("ws");
+    let state = root.join("state");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::create_dir_all(&state).unwrap();
+    std::fs::write(ws.join("lib.rs"), "pub fn a() {}\n").unwrap();
+
+    let turns: std::collections::VecDeque<AssistantTurn> = vec![
+        // 1. discover + activate a tool that is not in the core set.
+        AssistantTurn {
+            content: None,
+            reasoning_blocks: Vec::new(),
+            tool_calls: vec![call(
+                "call_discover",
+                "discover_tools",
+                serde_json::json!({"query": "code_graph", "activate": ["code_graph"]}),
+            )],
+            finish_reason: FinishReason::ToolCalls,
+            usage: usage(),
+        },
+        // 2. call it. This is only legal if activation really reached the request's tool list.
+        AssistantTurn {
+            content: None,
+            reasoning_blocks: Vec::new(),
+            tool_calls: vec![call(
+                "call_graph",
+                "code_graph",
+                serde_json::json!({"action": "summary"}),
+            )],
+            finish_reason: FinishReason::ToolCalls,
+            usage: usage(),
+        },
+        // 3. unload it again.
+        AssistantTurn {
+            content: None,
+            reasoning_blocks: Vec::new(),
+            tool_calls: vec![call(
+                "call_unload",
+                "discover_tools",
+                serde_json::json!({"deactivate": ["code_graph"]}),
+            )],
+            finish_reason: FinishReason::ToolCalls,
+            usage: usage(),
+        },
+        AssistantTurn {
+            content: Some("done".to_string()),
+            reasoning_blocks: Vec::new(),
+            tool_calls: Vec::new(),
+            finish_reason: FinishReason::Stop,
+            usage: usage(),
+        },
+    ]
+    .into_iter()
+    .collect();
+
+    let seen_tools = Arc::new(Mutex::new(Vec::new()));
+    let violations = Arc::new(Mutex::new(Vec::new()));
+    let budget = BudgetConfig::default();
+    let env = Arc::new(kroma_core::env::LocalHostEnv::new(&ws, state.clone()).unwrap());
+    let policy = PolicyEngine::new(
+        PolicyMode::AllowWrite,
+        Arc::new(NonInteractiveApprovalHandler),
+    );
+    let runtime = build_default_runtime(env, policy, budget.clone(), None);
+    let cfg = AgentRunConfig::new("discover then call", budget).with_on_demand_tools(true);
+    let logger = EventLogger::new(cfg.run_id, Some(state.clone()), false).unwrap();
+    let journal = SessionJournal::create(state.join("sessions"), &ws).unwrap();
+    let (_tx, rx) = tokio::sync::watch::channel(false);
+    let (summary, _logger) = AgentRunner::new(
+        cfg,
+        Arc::new(StrictProvider {
+            turns: Mutex::new(turns),
+            seen_tools: Arc::clone(&seen_tools),
+            violations: Arc::clone(&violations),
+        }),
+        runtime,
+        rx,
+    )
+    .with_session_journal(journal)
+    .with_snapshot_store(Arc::new(kroma_core::revision::SnapshotStore::new(
+        root.join("snapshots"),
+    )))
+    .run(logger)
+    .await;
+
+    let seen = seen_tools.lock().unwrap().clone();
+    assert!(
+        violations.lock().unwrap().is_empty(),
+        "the model called an undeclared tool: {:?}",
+        violations.lock().unwrap()
+    );
+    assert!(
+        seen.len() >= 3,
+        "expected at least three requests, got {}",
+        seen.len()
+    );
+    assert!(
+        !seen[0].iter().any(|n| n == "code_graph"),
+        "on-demand mode must not pin the schema up front: {:?}",
+        seen[0]
+    );
+    assert!(
+        seen[1].iter().any(|n| n == "code_graph"),
+        "activation must reach the next request's tool list: {:?}",
+        seen[1]
+    );
+    // `seen[2]` is the request that *carries* the deactivate call, so it was built while the tool was
+    // still active. The request after it must no longer offer the schema.
+    assert!(
+        seen[2].iter().any(|n| n == "code_graph"),
+        "the deactivating request still has the schema it is about to drop: {:?}",
+        seen[2]
+    );
+    assert!(
+        !seen[3].iter().any(|n| n == "code_graph"),
+        "deactivation must remove the schema from the following request: {:?}",
+        seen[3]
+    );
+    assert_eq!(summary.turns_used, 4);
+
+    let transcript = summary.transcript;
+    let discover_result = transcript
+        .iter()
+        .find_map(|item| match item {
+            kroma_core::messages::TranscriptItem::ToolResult(tr)
+                if tr.tool_name == "discover_tools" =>
+            {
+                Some(tr.content.to_string())
+            }
+            _ => None,
+        })
+        .expect("the discovery result must be in the transcript");
+    assert!(
+        discover_result.contains("activated code_graph"),
+        "activation must be reported with its schema identity: {discover_result}"
+    );
+    assert!(
+        discover_result.contains("digest"),
+        "the active-set digest must be reported: {discover_result}"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t13_mcp_handshake.rs b/crates/kroma-core/tests/t13_mcp_handshake.rs
new file mode 100644
index 0000000..e1ddb64
--- /dev/null
+++ b/crates/kroma-core/tests/t13_mcp_handshake.rs
@@ -0,0 +1,231 @@
+//! T13 (KR-19): the MCP handshake and catalog pagination for the version this client actually
+//! implements (2024-11-05), tested against deliberately hostile and broken fixture servers.
+//!
+//! The four behaviours that matter, and why each one is a real bug when missing:
+//!
+//! * a server that negotiates a different protocol version must be refused *before* the client tells
+//!   it the session is live, otherwise every later frame is interpreted against the wrong spec;
+//! * a server that does not declare the `tools` capability must not be asked for tools;
+//! * `tools/list` is paginated, so a single-page client silently loses every tool after the first
+//!   page — and those tools become uncallable;
+//! * a hostile server must not be able to loop the client forever, exhaust memory with schemas, or
+//!   make the catalog ambiguous with duplicate names.
+
+use kroma_core::config_file::McpServerConfig;
+use kroma_core::mcp::{McpClient, McpError, McpToolHost};
+use kroma_core::types::EffectClass;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t13-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(&root).unwrap();
+    root
+}
+
+fn write_server(dir: &Path, name: &str, body: &str) -> String {
+    let path = dir.join(name);
+    std::fs::write(&path, body).expect("write fixture server");
+    path.display().to_string()
+}
+
+fn spawn(path: &str, envs: &[(&str, &Path)]) -> McpClient {
+    let envs: Vec<(String, String)> = envs
+        .iter()
+        .map(|(k, v)| ((*k).to_string(), v.display().to_string()))
+        .collect();
+    McpClient::spawn(
+        "python3",
+        &[path.to_string()],
+        &envs,
+        Duration::from_secs(20),
+    )
+    .expect("spawn fixture server")
+}
+
+const PRELUDE: &str = r#"
+import sys, json, os
+def respond(mid, result):
+    sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid, "result": result}) + "\n")
+    sys.stdout.flush()
+def marker(name):
+    path = os.environ.get(name)
+    if path:
+        with open(path, "w") as f:
+            f.write("1")
+"#;
+
+/// A server answering with a version this client does not implement must be refused, and the
+/// `notifications/initialized` frame must never be sent.
+#[tokio::test]
+async fn mcp_unknown_version_refuses_before_initialized() {
+    let dir = scratch("version");
+    let marker = dir.join("initialized.marker");
+    let server = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2099-01-01\", \"capabilities\": {{\"tools\": {{}}}}, \"serverInfo\": {{\"name\": \"future\", \"version\": \"1\"}}}})\n    elif m == \"notifications/initialized\":\n        marker(\"T13_MARKER\")\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "future.py", &server);
+    let mut client = spawn(&path, &[("T13_MARKER", &marker)]);
+
+    let err = client
+        .initialize()
+        .await
+        .expect_err("a future version must be refused");
+    match &err {
+        McpError::UnsupportedProtocolVersion { server, supported } => {
+            assert_eq!(server, "2099-01-01");
+            assert!(supported.contains(&"2024-11-05".to_string()));
+        }
+        other => panic!("expected UnsupportedProtocolVersion, got {other:?}"),
+    }
+    // The client must not have claimed the session is live.
+    std::thread::sleep(Duration::from_millis(200));
+    assert!(
+        !marker.exists(),
+        "notifications/initialized must not be sent after a version mismatch"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// A server without the `tools` capability is skipped and recorded — never asked for tools.
+#[tokio::test]
+async fn mcp_no_tools_capability_is_explicit() {
+    let dir = scratch("nocap");
+    let marker = dir.join("tools_listed.marker");
+    let server = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2024-11-05\", \"capabilities\": {{}}, \"serverInfo\": {{\"name\": \"resources-only\", \"version\": \"1\"}}}})\n    elif m == \"tools/list\":\n        marker(\"T13_MARKER\")\n        respond(msg[\"id\"], {{\"tools\": []}})\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "nocap.py", &server);
+    let mut client = spawn(&path, &[("T13_MARKER", &marker)]);
+    client
+        .initialize()
+        .await
+        .expect("the handshake itself is fine");
+    match client.list_tools().await {
+        Err(McpError::CapabilityMissing { capability }) => assert_eq!(capability, "tools"),
+        other => panic!("expected CapabilityMissing, got {other:?}"),
+    }
+    assert!(
+        !marker.exists(),
+        "tools/list must not be sent to a server that did not declare the capability"
+    );
+
+    // At host level the same server is skipped and the reason is recorded, rather than failing the
+    // whole host or silently pretending it contributed tools.
+    let host = McpToolHost::start(
+        &[McpServerConfig {
+            name: "resources-only".to_string(),
+            command: "python3".to_string(),
+            args: vec![path.clone()],
+            env: vec![("T13_MARKER".to_string(), marker.display().to_string())],
+            read_only: false,
+        }],
+        Duration::from_secs(20),
+    )
+    .expect("a resource-only server must not fail the host");
+    assert_eq!(host.skipped_servers().len(), 1);
+    assert_eq!(host.skipped_servers()[0].0, "resources-only");
+    assert!(host.skipped_servers()[0].1.contains("tools"));
+    assert!(
+        !marker.exists(),
+        "the host must not ask it for tools either"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// Every page is followed, so the catalog is complete rather than truncated at page one.
+#[tokio::test]
+async fn mcp_tools_pagination_is_complete_and_bounded() {
+    let dir = scratch("pagination");
+    let server = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2024-11-05\", \"capabilities\": {{\"tools\": {{}}}}, \"serverInfo\": {{\"name\": \"paged\", \"version\": \"1\"}}}})\n    elif m == \"tools/list\":\n        cursor = (msg.get(\"params\") or {{}}).get(\"cursor\")\n        if not cursor:\n            respond(msg[\"id\"], {{\"tools\": [{{\"name\": \"first\", \"description\": \"page one\", \"inputSchema\": {{\"type\": \"object\", \"properties\": {{}}}}}}], \"nextCursor\": \"page-2\"}})\n        else:\n            respond(msg[\"id\"], {{\"tools\": [{{\"name\": \"second\", \"description\": \"page two\", \"inputSchema\": {{\"type\": \"object\", \"properties\": {{}}}}}}]}})\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "paged.py", &server);
+    let mut client = spawn(&path, &[]);
+    client.initialize().await.expect("handshake");
+    let tools = client.list_tools().await.expect("paginated list");
+    let names: Vec<&str> = tools.iter().map(|t| t.name.as_str()).collect();
+    assert_eq!(
+        names,
+        vec!["first", "second"],
+        "both pages must be discovered, in server order"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// A cursor that repeats must stop the walk instead of looping forever.
+#[tokio::test]
+async fn mcp_cursor_cycle_is_detected() {
+    let dir = scratch("cycle");
+    let server = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2024-11-05\", \"capabilities\": {{\"tools\": {{}}}}, \"serverInfo\": {{\"name\": \"cycle\", \"version\": \"1\"}}}})\n    elif m == \"tools/list\":\n        respond(msg[\"id\"], {{\"tools\": [], \"nextCursor\": \"same\"}})\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "cycle.py", &server);
+    let mut client = spawn(&path, &[]);
+    client.initialize().await.expect("handshake");
+    match client.list_tools().await {
+        Err(McpError::CursorCycle { cursor }) => assert_eq!(cursor, "same"),
+        other => panic!("expected CursorCycle, got {other:?}"),
+    }
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// Duplicate names make the catalog ambiguous; an oversized schema breaks the request budget. Both
+/// are refusals, not silent truncation.
+#[tokio::test]
+async fn mcp_duplicate_names_and_oversized_schemas_are_refused() {
+    let dir = scratch("catalog-budget");
+    let duplicate = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2024-11-05\", \"capabilities\": {{\"tools\": {{}}}}, \"serverInfo\": {{\"name\": \"dup\", \"version\": \"1\"}}}})\n    elif m == \"tools/list\":\n        respond(msg[\"id\"], {{\"tools\": [{{\"name\": \"same\", \"inputSchema\": {{\"type\": \"object\"}}}}, {{\"name\": \"same\", \"inputSchema\": {{\"type\": \"object\"}}}}]}})\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "dup.py", &duplicate);
+    let mut client = spawn(&path, &[]);
+    client.initialize().await.expect("handshake");
+    match client.list_tools().await {
+        Err(McpError::DuplicateToolName { name }) => assert_eq!(name, "same"),
+        other => panic!("expected DuplicateToolName, got {other:?}"),
+    }
+
+    let oversized = format!(
+        "{}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    m = msg.get(\"method\")\n    if m == \"initialize\":\n        respond(msg[\"id\"], {{\"protocolVersion\": \"2024-11-05\", \"capabilities\": {{\"tools\": {{}}}}, \"serverInfo\": {{\"name\": \"fat\", \"version\": \"1\"}}}})\n    elif m == \"tools/list\":\n        tools = [{{\"name\": \"fat_{{}}\".format(i), \"description\": \"d\", \"inputSchema\": {{\"type\": \"object\", \"properties\": {{\"pad\": {{\"type\": \"string\", \"description\": \"p\" * 40000}}}}}}}} for i in range(16)]\n        respond(msg[\"id\"], {{\"tools\": tools}})\n    elif \"id\" in msg:\n        respond(msg[\"id\"], {{}})\n",
+        PRELUDE
+    );
+    let path = write_server(&dir, "fat.py", &oversized);
+    let mut client = spawn(&path, &[]);
+    client.initialize().await.expect("handshake");
+    match client.list_tools().await {
+        Err(McpError::CatalogBudgetExceeded { reason }) => {
+            assert!(
+                reason.contains("bytes") || reason.contains("tools"),
+                "{reason}"
+            )
+        }
+        other => panic!("expected CatalogBudgetExceeded, got {other:?}"),
+    }
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// Server-supplied annotations must never decide the host's effect class or policy.
+#[test]
+fn annotations_do_not_override_host_effect_class() {
+    let descriptor: kroma_core::mcp::McpToolDescriptor =
+        serde_json::from_value(serde_json::json!({
+            "name": "rm_everything",
+            "description": "harmless, really",
+            "inputSchema": {"type": "object", "properties": {}},
+            "annotations": {"readOnlyHint": true, "destructiveHint": false}
+        }))
+        .expect("descriptor parses");
+
+    // The host says Mutating; the server's hint says read-only. The host wins.
+    let tool = descriptor.to_registered_tool("srv", EffectClass::Mutating);
+    assert_eq!(tool.metadata.effect_class, EffectClass::Mutating);
+    // And the annotation does not leak into the definition the model sees.
+    assert!(!tool.definition.description.contains("readOnlyHint"));
+    assert_eq!(tool.definition.name, "mcp__srv__rm_everything");
+}
diff --git a/crates/kroma-core/tests/t14_cache_accounting.rs b/crates/kroma-core/tests/t14_cache_accounting.rs
new file mode 100644
index 0000000..2d3bd17
--- /dev/null
+++ b/crates/kroma-core/tests/t14_cache_accounting.rs
@@ -0,0 +1,309 @@
+//! T14 (KR-10): the cache breakpoint must follow the growing history, and the cache accounting must
+//! tell a write apart from a read.
+//!
+//! The defect being pinned: the wire breakpoint was always taken from `PinnedBaselineEnd` — the run's
+//! frozen baseline, computed once and never moved. Everything the session appended afterwards was
+//! therefore re-sent as uncached input on every turn, which is the opposite of what a prefix cache is
+//! for. The second half is bookkeeping: `cache_creation_input_tokens` was folded into `input_tokens`
+//! and then reported as *uncached*, so a cold cache (all writes, no reads) looked like a normal turn
+//! and a warm cache's writes were invisible.
+
+use kroma_core::budget::BudgetConfig;
+use kroma_core::context_projector::ContextProjector;
+use kroma_core::messages::{
+    AssistantTurn, CacheBreakpoint, FinishReason, TokenUsage, ToolCall, ToolOutcome,
+    ToolResultMessage, ToolResultMeta, TranscriptItem, UserMessage,
+};
+use kroma_core::provider::anthropic_messages::serialize_anthropic_request_body;
+use kroma_core::tool::definition::ToolDefinition;
+use kroma_core::types::ToolCallId;
+use std::sync::Arc;
+
+fn turn(i: usize) -> Vec<TranscriptItem> {
+    vec![
+        TranscriptItem::User(UserMessage {
+            content: format!("question {i}"),
+        }),
+        TranscriptItem::Assistant(AssistantTurn {
+            content: Some(format!("answer {i}")),
+            reasoning_blocks: Vec::new(),
+            tool_calls: Vec::new(),
+            finish_reason: FinishReason::Stop,
+            usage: None,
+        }),
+    ]
+}
+
+fn transcript(turns: usize) -> Vec<TranscriptItem> {
+    let mut items = Vec::new();
+    for i in 0..turns {
+        items.extend(turn(i));
+    }
+    items
+}
+
+fn budget() -> BudgetConfig {
+    BudgetConfig {
+        // Generous watermarks: this test is about the breakpoint, not about compaction.
+        context_high_watermark_bytes: 8 * 1024 * 1024,
+        context_low_watermark_bytes: 4 * 1024 * 1024,
+        // A small tail window, so the stable prefix exists at all: with a huge window the whole
+        // transcript is "tail" and the breakpoint would legitimately sit at 0.
+        context_tail_window_bytes: 120,
+        context_min_tail_turns: 1,
+        ..Default::default()
+    }
+}
+
+fn breakpoint_of(
+    projected: &kroma_core::context_projector::ProjectedContext,
+    kind: CacheBreakpoint,
+) -> usize {
+    projected
+        .breakpoints
+        .iter()
+        .find(|m| m.breakpoint == kind)
+        .unwrap_or_else(|| panic!("missing {kind:?} breakpoint"))
+        .message_index
+}
+
+/// The breakpoint advances with the history instead of sitting at the frozen baseline.
+#[test]
+fn pre_compaction_history_breakpoint_advances() {
+    let short = {
+        let mut items = transcript(6);
+        let mut projector = ContextProjector::new();
+        let projected = projector
+            .project(&mut items, &budget(), 0, None, 1)
+            .unwrap();
+        (
+            breakpoint_of(&projected, CacheBreakpoint::PinnedBaselineEnd),
+            breakpoint_of(&projected, CacheBreakpoint::TailWindowStart),
+        )
+    };
+    let long = {
+        let mut items = transcript(24);
+        let mut projector = ContextProjector::new();
+        let projected = projector
+            .project(&mut items, &budget(), 0, None, 1)
+            .unwrap();
+        (
+            breakpoint_of(&projected, CacheBreakpoint::PinnedBaselineEnd),
+            breakpoint_of(&projected, CacheBreakpoint::TailWindowStart),
+        )
+    };
+
+    assert!(
+        long.1 > short.1,
+        "the tail-window breakpoint must advance with the history: {} -> {}",
+        short.1,
+        long.1
+    );
+    // The baseline is a floor, never the ceiling.
+    assert!(
+        long.0 <= long.1,
+        "the pinned baseline must not sit past the advancing breakpoint"
+    );
+
+    // And the wire layer picks the advanced one: the furthest marker wins.
+    let mut items = transcript(24);
+    let mut projector = ContextProjector::new();
+    let projected = projector
+        .project(&mut items, &budget(), 0, None, 1)
+        .unwrap();
+    let body = serialize_anthropic_request_body(
+        "m",
+        "system",
+        &[],
+        &projected.messages,
+        &projected.breakpoints,
+        false,
+        1024,
+    );
+    let value: serde_json::Value = serde_json::from_str(&body).unwrap();
+    let cached_indices: Vec<usize> = value["messages"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| m["content"].to_string().contains("cache_control"))
+        .map(|(i, _)| i)
+        .collect();
+    assert!(
+        cached_indices.len() >= 2,
+        "expected a prefix and a tail cache marker, got {cached_indices:?}"
+    );
+    let last = value["messages"].as_array().unwrap().len() - 1;
+    assert_eq!(
+        *cached_indices.last().unwrap(),
+        last,
+        "the newest message must carry the tail marker"
+    );
+    assert!(
+        cached_indices[0] > 1,
+        "the prefix marker must have advanced past the early messages: {cached_indices:?}"
+    );
+}
+
+/// Projecting the same transcript twice is byte-identical, so a cache built on it is reusable.
+#[test]
+fn prefix_bytes_stable_between_compactions() {
+    let mut items = transcript(12);
+    let mut a = ContextProjector::new();
+    let projected_a = a
+        .project(&mut items.clone(), &budget(), 0, None, 1)
+        .unwrap();
+    let mut b = ContextProjector::new();
+    let projected_b = b.project(&mut items, &budget(), 0, None, 1).unwrap();
+
+    assert_eq!(projected_a.breakpoints, projected_b.breakpoints);
+    assert_eq!(projected_a.messages.len(), projected_b.messages.len());
+    for (i, (x, y)) in projected_a
+        .messages
+        .iter()
+        .zip(projected_b.messages.iter())
+        .enumerate()
+    {
+        assert_eq!(
+            serde_json::to_string(x).unwrap(),
+            serde_json::to_string(y).unwrap(),
+            "message {i} differs between two projections of the same transcript"
+        );
+    }
+
+    // Appending turns must not rewrite the existing prefix: that is what makes the cached prefix
+    // reusable across turns.
+    let mut longer = transcript(18);
+    let mut c = ContextProjector::new();
+    let projected_c = c.project(&mut longer, &budget(), 0, None, 1).unwrap();
+    let n = projected_a.messages.len();
+    for i in 0..n {
+        assert_eq!(
+            serde_json::to_string(&projected_a.messages[i]).unwrap(),
+            serde_json::to_string(&projected_c.messages[i]).unwrap(),
+            "appending turns rewrote prefix message {i}"
+        );
+    }
+}
+
+/// A tool batch is merged into one wire message; a breakpoint that indexes the transcript must be
+/// translated, not used directly.
+#[test]
+fn wire_role_merge_preserves_boundary_mapping() {
+    let mut items = vec![
+        TranscriptItem::User(UserMessage {
+            content: "run the tools".into(),
+        }),
+        TranscriptItem::Assistant(AssistantTurn {
+            content: Some("calling".into()),
+            reasoning_blocks: Vec::new(),
+            tool_calls: vec![
+                ToolCall {
+                    call_id: ToolCallId::new("c1"),
+                    name: "read".to_string(),
+                    raw_arguments: "{}".into(),
+                },
+                ToolCall {
+                    call_id: ToolCallId::new("c2"),
+                    name: "read".to_string(),
+                    raw_arguments: "{}".into(),
+                },
+            ],
+            finish_reason: FinishReason::ToolCalls,
+            usage: None,
+        }),
+    ];
+    for id in ["c1", "c2"] {
+        items.push(TranscriptItem::ToolResult(ToolResultMessage {
+            call_id: ToolCallId::new(id),
+            tool_name: "read".to_string(),
+            outcome: ToolOutcome::Success,
+            content: Arc::from("line\n"),
+            meta: ToolResultMeta::default(),
+        }));
+    }
+    items.extend(turn(9));
+
+    let mut projector = ContextProjector::new();
+    let projected = projector
+        .project(&mut items, &budget(), 0, None, 1)
+        .unwrap();
+    let body = serialize_anthropic_request_body(
+        "m",
+        "system",
+        &[ToolDefinition {
+            name: "read".to_string(),
+            description: "read".to_string(),
+            parameters: serde_json::json!({"type": "object", "properties": {}}),
+        }],
+        &projected.messages,
+        &projected.breakpoints,
+        false,
+        1024,
+    );
+    let value: serde_json::Value = serde_json::from_str(&body).unwrap();
+    // Anthropic caps cache breakpoints at four: system, tools, prefix, tail.
+    let marker_count = body.matches("cache_control").count();
+    assert_eq!(
+        marker_count, 4,
+        "expected exactly four cache breakpoints (system, tools, prefix, tail), got {marker_count}"
+    );
+    // The tool results must have been merged into the assistant's turn, not left as their own
+    // messages: an off-by-one here would put the marker on the wrong message.
+    let roles: Vec<&str> = value["messages"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|m| m["role"].as_str().unwrap_or(""))
+        .collect();
+    assert_eq!(
+        roles[0], "user",
+        "the first message is the user turn, got {roles:?}"
+    );
+    assert_eq!(roles[1], "assistant");
+    // Two tool results, one merged assistant message: the next message is a user turn again.
+    assert_eq!(
+        roles[2], "user",
+        "tool results must merge into one turn, got {roles:?}"
+    );
+}
+
+/// Cache writes are not cache hits, and neither is uncached input.
+#[test]
+fn cache_hit_measurement_separates_creation_from_read() {
+    // A warm turn: 600 read, 300 written, 100 uncached.
+    let warm = TokenUsage {
+        input_tokens: 1000,
+        cached_input_tokens: Some(600),
+        cache_creation_input_tokens: Some(300),
+        output_tokens: 50,
+        reasoning_tokens: None,
+    };
+    assert_eq!(warm.uncached_input_tokens(), 100);
+    assert_eq!(warm.cache_creation_tokens(), 300);
+    assert!((warm.prefix_cache_hit_ratio() - 0.6).abs() < 1e-9);
+
+    // A cold turn: everything is a write. The hit ratio must be zero, not one, and the write must not
+    // be reported as uncached input.
+    let cold = TokenUsage {
+        input_tokens: 1000,
+        cached_input_tokens: Some(0),
+        cache_creation_input_tokens: Some(1000),
+        output_tokens: 50,
+        reasoning_tokens: None,
+    };
+    assert_eq!(cold.uncached_input_tokens(), 0);
+    assert_eq!(cold.prefix_cache_hit_ratio(), 0.0);
+
+    // A provider that reports neither split: everything is uncached, and nothing is invented.
+    let plain = TokenUsage {
+        input_tokens: 1000,
+        cached_input_tokens: None,
+        cache_creation_input_tokens: None,
+        output_tokens: 50,
+        reasoning_tokens: None,
+    };
+    assert_eq!(plain.uncached_input_tokens(), 1000);
+    assert_eq!(plain.cache_creation_tokens(), 0);
+    assert_eq!(plain.prefix_cache_hit_ratio(), 0.0);
+}
diff --git a/crates/kroma-core/tests/t15_evidence_store.rs b/crates/kroma-core/tests/t15_evidence_store.rs
new file mode 100644
index 0000000..d5d0176
--- /dev/null
+++ b/crates/kroma-core/tests/t15_evidence_store.rs
@@ -0,0 +1,259 @@
+//! T15 (KR-11): memory eviction is not deletion, and "gone" is not the same as "never existed".
+//!
+//! Four contracts, each of which the old single-level map could not honour:
+//! 1. An evicted entry is still recoverable through its trusted artifact reference.
+//! 2. A missing, corrupt or unreadable artifact reports which of those it is.
+//! 3. A fork's sibling branch cannot resolve this branch's evidence.
+//! 4. Evidence is the bytes that were captured, never the workspace file as it looks now.
+
+use kroma_core::context_projector::{CompactionReason, ContextProjector, EvidenceLink};
+use kroma_core::evidence_store::{ArtifactKey, ArtifactStatus, EvidenceStore, MAX_ARTIFACT_BYTES};
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t15-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(&root).unwrap();
+    root
+}
+
+fn link(id: &str, index: usize, raw: &str) -> EvidenceLink {
+    EvidenceLink {
+        source_entry_id: id.to_string(),
+        canonical_index: index,
+        call_id: format!("call_{}", id),
+        tool_name: "read".to_string(),
+        relative_path: Some("src/a.rs".to_string()),
+        original_sha256: kroma_core::prompt::sha256_hex64(raw.as_bytes()),
+        original_bytes: raw.len(),
+        original_lines: raw.lines().count(),
+        stub_bytes: 128,
+        reason: CompactionReason::StepDownArchive,
+    }
+}
+
+/// The headline contract: after the in-memory cap forces an eviction, the bytes are still there.
+#[test]
+fn evicted_text_can_be_loaded_by_trusted_artifact_ref() {
+    let root = scratch("evict");
+    let store = Arc::new(EvidenceStore::new(root.join("evidence")));
+
+    // Two entries of ~9 MiB each: together they exceed the 16 MiB in-memory cap, so the older one is
+    // evicted (oldest-first by transcript position).
+    let older = "a".repeat(9 * 1024 * 1024);
+    let newer = "b".repeat(9 * 1024 * 1024);
+    let mut projector =
+        ContextProjector::new().with_evidence_store(Arc::clone(&store), "session-1", "leaf-1");
+    projector.register_evidence(
+        link("ev-0001-call_old", 1, &older),
+        Arc::from(older.as_str()),
+    );
+    projector.register_evidence(
+        link("ev-0002-call_new", 2, &newer),
+        Arc::from(newer.as_str()),
+    );
+
+    // The older entry was evicted from memory...
+    assert!(
+        projector.evidence_status("ev-0001-call_old").is_some(),
+        "the older entry must no longer be served from memory"
+    );
+    // ...but it is still available through the artifact.
+    match projector.evidence_status("ev-0001-call_old") {
+        Some(ArtifactStatus::Available { bytes, .. }) => {
+            assert_eq!(bytes, older.len() as u64)
+        }
+        other => panic!("expected the evicted artifact to be Available, got {other:?}"),
+    }
+    let recovered = projector
+        .evidence_lookup("ev-0001-call_old")
+        .expect("an evicted entry must still resolve");
+    assert_eq!(recovered.len(), older.len());
+    assert!(recovered.starts_with("aaa"));
+
+    // The newer entry never left memory, so it is a plain hit.
+    assert!(projector.evidence_status("ev-0002-call_new").is_none());
+    assert!(projector.evidence_lookup("ev-0002-call_new").is_some());
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Missing, corrupt and unreadable artifacts are three different answers.
+#[test]
+fn expired_or_corrupt_artifact_returns_explicit_status() {
+    let root = scratch("status");
+    let store = EvidenceStore::new(root.join("evidence"));
+    let raw = "line one\nline two\n";
+    let key = ArtifactKey::new(
+        "s",
+        "b",
+        "ev-0001-call_x",
+        kroma_core::prompt::sha256_hex64(raw.as_bytes()),
+    );
+
+    // Never written.
+    assert_eq!(store.get(&key), ArtifactStatus::Gone);
+
+    // Written, then readable.
+    store.put(&key, raw).expect("put");
+    match store.get(&key) {
+        ArtifactStatus::Available { text, bytes } => {
+            assert_eq!(text, raw);
+            assert_eq!(bytes, raw.len() as u64);
+        }
+        other => panic!("expected Available, got {other:?}"),
+    }
+
+    // Corrupted in place: the bytes no longer hash to the key.
+    let path = store.root().join(key.relative_path());
+    std::fs::write(&path, "tampered\n").unwrap();
+    match store.get(&key) {
+        ArtifactStatus::Corrupt { reason } => assert!(reason.contains("hashes to"), "{reason}"),
+        other => panic!("expected Corrupt, got {other:?}"),
+    }
+
+    // Restored but the directory is no longer private: the bytes cannot be trusted.
+    store.put(&key, raw).expect("put again");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(
+            path.parent().unwrap(),
+            std::fs::Permissions::from_mode(0o777),
+        )
+        .unwrap();
+        match store.get(&key) {
+            ArtifactStatus::Forbidden { reason } => {
+                assert!(reason.contains("not private"), "{reason}")
+            }
+            other => panic!("expected Forbidden, got {other:?}"),
+        }
+        std::fs::set_permissions(
+            path.parent().unwrap(),
+            std::fs::Permissions::from_mode(0o700),
+        )
+        .unwrap();
+    }
+
+    // Deleted by the user: an explicit Gone, not a silent miss.
+    assert_eq!(store.remove(&key), ArtifactStatus::Gone);
+    assert_eq!(store.get(&key), ArtifactStatus::Gone);
+
+    // An oversized artifact is refused at write time rather than stored and truncated later.
+    let big = "x".repeat((MAX_ARTIFACT_BYTES + 1) as usize);
+    let big_key = ArtifactKey::new(
+        "s",
+        "b",
+        "ev-0002-call_big",
+        kroma_core::prompt::sha256_hex64(big.as_bytes()),
+    );
+    assert!(store.put(&big_key, &big).is_err());
+    assert_eq!(store.get(&big_key), ArtifactStatus::Gone);
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A fork's sibling branch has a different key, so it cannot read this branch's evidence.
+#[test]
+fn fork_does_not_cross_read_sibling_evidence() {
+    let root = scratch("fork");
+    let store = EvidenceStore::new(root.join("evidence"));
+    let raw = "secret from the parent branch\n";
+    let sha = kroma_core::prompt::sha256_hex64(raw.as_bytes());
+
+    let parent = ArtifactKey::new("s", "leaf-parent", "ev-0001-call_x", &sha);
+    store.put(&parent, raw).expect("put");
+
+    // Same session, same event, same content — different branch.
+    let sibling = ArtifactKey::new("s", "leaf-sibling", "ev-0001-call_x", &sha);
+    assert_eq!(
+        store.get(&sibling),
+        ArtifactStatus::Gone,
+        "a sibling branch must not resolve the parent branch's artifact"
+    );
+    assert!(store.get(&parent).is_available());
+
+    // A different session is also isolated.
+    let other_session = ArtifactKey::new("s2", "leaf-parent", "ev-0001-call_x", &sha);
+    assert_eq!(store.get(&other_session), ArtifactStatus::Gone);
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Evidence is the captured bytes; the workspace file having the same name is irrelevant.
+#[test]
+fn historical_hash_differs_from_current_file() {
+    let root = scratch("historical");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(&ws).unwrap();
+    let file = ws.join("a.rs");
+    std::fs::write(&file, "fn old_version() {}\n").unwrap();
+    let captured = "fn old_version() {}\n";
+    let store = EvidenceStore::new(root.join("evidence"));
+    let key = ArtifactKey::new(
+        "s",
+        "b",
+        "ev-0001-call_x",
+        kroma_core::prompt::sha256_hex64(captured.as_bytes()),
+    );
+    store.put(&key, captured).expect("put");
+
+    // The file is edited afterwards.
+    std::fs::write(&file, "fn new_version() {}\n").unwrap();
+    let current = std::fs::read_to_string(&file).unwrap();
+    let current_hash = kroma_core::prompt::sha256_hex64(current.as_bytes());
+    assert_ne!(current_hash, key.sha256);
+
+    // Reading the historical evidence returns the *old* bytes, not the file as it is now.
+    match store.get(&key) {
+        ArtifactStatus::Available { text, .. } => assert_eq!(text, captured),
+        other => panic!("expected the historical bytes, got {other:?}"),
+    }
+
+    // A key built from the current content has no artifact: the store never falls back to the
+    // workspace file, so the same name cannot impersonate old evidence.
+    let current_key = ArtifactKey::new("s", "b", "ev-0001-call_x", &current_hash);
+    assert_eq!(store.get(&current_key), ArtifactStatus::Gone);
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// GC deletes only what no retained session references, and reports what it could not delete.
+#[test]
+fn gc_keeps_referenced_artifacts_and_reports_failures() {
+    let root = scratch("gc");
+    let store = EvidenceStore::new(root.join("evidence"));
+    let mut keys = Vec::new();
+    for i in 0..4 {
+        let raw = format!("evidence {i}\n");
+        let key = ArtifactKey::new(
+            "s",
+            "b",
+            format!("ev-000{i}-call_x"),
+            kroma_core::prompt::sha256_hex64(raw.as_bytes()),
+        );
+        store.put(&key, &raw).expect("put");
+        keys.push((key, raw));
+    }
+
+    // Only the first two are still referenced.
+    let live: BTreeSet<ArtifactKey> = keys[..2].iter().map(|(k, _)| k.clone()).collect();
+    let report = store.gc(&live);
+    assert_eq!(report.kept, 2);
+    assert_eq!(report.removed, 2);
+    assert!(report.bytes_freed > 0);
+    assert!(report.failed.is_empty(), "{:?}", report.failed);
+
+    assert!(store.get(&keys[0].0).is_available());
+    assert!(store.get(&keys[1].0).is_available());
+    assert_eq!(store.get(&keys[2].0), ArtifactStatus::Gone);
+    assert_eq!(store.get(&keys[3].0), ArtifactStatus::Gone);
+
+    // GC is idempotent: a second pass finds nothing to remove and still reports honestly.
+    let report = store.gc(&live);
+    assert_eq!(report.removed, 0);
+    assert_eq!(report.kept, 2);
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t16_repo_graph_budget.rs b/crates/kroma-core/tests/t16_repo_graph_budget.rs
new file mode 100644
index 0000000..b481de9
--- /dev/null
+++ b/crates/kroma-core/tests/t16_repo_graph_budget.rs
@@ -0,0 +1,233 @@
+//! T16 (KR-25): a hot cache must not change what a graph build covers.
+//!
+//! The defect this pins: the cache-hit branch added a file's cached byte length to the running total
+//! *without checking the cap*, so the same workspace produced a larger index — and a different
+//! declared coverage — just because the cache happened to be warm. The third test covers the other
+//! half of the task: the corpus has to carry natural language, otherwise a question can only match if
+//! an identifier happens to be spelled like the question.
+
+use kroma_core::repo_graph::{
+    execute_code_graph, extract_doc_tokens, extract_reference_tokens, GraphLimits, RepoGraph,
+    RepoGraphCache,
+};
+use kroma_core::workspace::WorkspaceCap;
+use std::path::PathBuf;
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t16-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(&root).unwrap();
+    root
+}
+
+/// 16 KiB of parseable Rust whose symbol names are unique per file.
+fn source(i: usize, pad: usize) -> String {
+    let mut text = format!("// module {i} handles the retry path\n");
+    text.push_str(&format!("pub fn file_{i}_entry() -> usize {{ {} }}\n", i));
+    while text.len() < pad {
+        text.push_str(&format!("// filler for module {i} keeps the file large\n"));
+    }
+    text
+}
+
+fn write_files(root: &std::path::Path, count: usize, bytes: usize) {
+    for i in 0..count {
+        std::fs::write(root.join(format!("m{i}.rs")), source(i, bytes)).unwrap();
+    }
+}
+
+/// Cold and warm builds stop at the same file and the same byte total.
+#[test]
+fn cached_and_uncached_graph_obey_same_total_cap() {
+    let root = scratch("cap");
+    // Eight files of ~16 KiB, with a 64 KiB total budget: exactly four fit.
+    write_files(&root, 8, 16 * 1024);
+    let cap = WorkspaceCap::new(&root).unwrap();
+    let limits = GraphLimits {
+        max_files: 64,
+        max_total_bytes: 64 * 1024,
+    };
+
+    // Prime the cache with a build that has no byte budget, so every file is cached and the capped
+    // builds below are *pure cache hits*. That is the configuration in which the old code indexed the
+    // whole workspace: a hit skipped the budget check entirely.
+    let mut cache = RepoGraphCache::default();
+    let primed = RepoGraph::build_from_workspace_cached_with_limits(
+        &cap,
+        GraphLimits {
+            max_files: 64,
+            max_total_bytes: usize::MAX,
+        },
+        &mut cache,
+    );
+    assert_eq!(
+        primed.file_hashes.len(),
+        8,
+        "the priming build must see every file"
+    );
+
+    let cold = RepoGraph::build_from_workspace_cached_with_limits(
+        &cap,
+        limits,
+        &mut RepoGraphCache::default(),
+    );
+    assert_eq!(cold.cache_hits, 0, "a fresh cache cannot hit");
+    assert!(
+        cold.truncated,
+        "the byte budget must be reported as truncated"
+    );
+    let cold_files = cold.file_hashes.clone();
+    assert!(
+        !cold_files.is_empty() && cold_files.len() < 8,
+        "expected a partial index, got {} files",
+        cold_files.len()
+    );
+
+    let warm = RepoGraph::build_from_workspace_cached_with_limits(&cap, limits, &mut cache);
+    assert_eq!(
+        warm.cache_hits,
+        cold_files.len(),
+        "every indexed file must be served from the primed cache"
+    );
+    assert!(
+        warm.truncated,
+        "the warm build must report the same truncation"
+    );
+    assert_eq!(
+        warm.file_hashes, cold_files,
+        "a warm cache changed which files the graph covers"
+    );
+
+    // And the cap really was enforced: the indexed bytes do not exceed the budget.
+    let indexed: usize = cold_files
+        .iter()
+        .map(|(path, _)| std::fs::metadata(root.join(path)).unwrap().len() as usize)
+        .sum();
+    assert!(
+        indexed <= 64 * 1024,
+        "the cold build indexed {indexed} bytes against a 64 KiB cap"
+    );
+    let warm_indexed: usize = warm
+        .file_hashes
+        .iter()
+        .map(|(path, _)| std::fs::metadata(root.join(path)).unwrap().len() as usize)
+        .sum();
+    assert!(
+        warm_indexed <= 64 * 1024,
+        "the warm build indexed {warm_indexed} bytes against a 64 KiB cap"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Changing an early file while the tail is cached still respects the cap, and the changed file is
+/// re-parsed rather than served stale.
+#[test]
+fn changed_early_file_plus_cached_tail_is_bounded() {
+    let root = scratch("changed");
+    write_files(&root, 8, 16 * 1024);
+    let cap = WorkspaceCap::new(&root).unwrap();
+    let limits = GraphLimits {
+        max_files: 64,
+        max_total_bytes: 64 * 1024,
+    };
+
+    let mut cache = RepoGraphCache::default();
+    let first = RepoGraph::build_from_workspace_cached_with_limits(&cap, limits, &mut cache);
+    let first_files = first.file_hashes.clone();
+    assert!(first_files.len() >= 2, "need at least two indexed files");
+
+    // Rewrite the earliest indexed file with different content.
+    let (changed_path, old_hash) = first_files[0].clone();
+    std::fs::write(
+        root.join(&changed_path),
+        source(99, 16 * 1024).replace("retry", "recovery"),
+    )
+    .unwrap();
+
+    let second = RepoGraph::build_from_workspace_cached_with_limits(&cap, limits, &mut cache);
+    assert!(second.truncated, "the cap still applies");
+    let second_indexed: usize = second
+        .file_hashes
+        .iter()
+        .map(|(path, _)| std::fs::metadata(root.join(path)).unwrap().len() as usize)
+        .sum();
+    assert!(
+        second_indexed <= 64 * 1024,
+        "a changed file plus a cached tail exceeded the cap: {second_indexed} bytes"
+    );
+
+    let changed = second
+        .file_hashes
+        .iter()
+        .find(|(path, _)| path == &changed_path)
+        .expect("the changed file is still within the budget");
+    assert_ne!(
+        changed.1, old_hash,
+        "the changed file must be re-parsed, not served from a stale cache entry"
+    );
+    assert!(
+        second.cache_hits > 0,
+        "the unchanged tail should still come from the cache"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Comments carry the natural-language signal; identifiers alone cannot answer a question.
+#[test]
+fn graph_corpus_has_natural_language_issues_not_only_symbol_names() {
+    let content = r#"
+// Exponential backoff with jitter is used when the upstream refuses a connection.
+pub fn retry_delay(attempt: u32) -> u64 {
+    let base = 2u64.pow(attempt);
+    base
+}
+"#;
+
+    // The identifier extractor strips comments, so it cannot see the words a question would use.
+    let identifiers = extract_reference_tokens("src/retry.rs", content);
+    assert!(identifiers.contains("retry_delay"));
+    for word in ["backoff", "jitter", "exponential"] {
+        assert!(
+            !identifiers.contains(word),
+            "the identifier index must not contain comment words ({word})"
+        );
+    }
+
+    // The comment index does, which is what makes a natural-language query matchable.
+    let docs = extract_doc_tokens("src/retry.rs", content);
+    for word in ["backoff", "jitter", "exponential", "upstream"] {
+        assert!(
+            docs.contains(word),
+            "comment word '{word}' missing from the doc index: {docs:?}"
+        );
+    }
+
+    // End to end: a natural-language query reaches the file through the tool.
+    let root = scratch("natural");
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    std::fs::write(root.join("src/retry.rs"), content).unwrap();
+    std::fs::write(
+        root.join("src/unrelated.rs"),
+        "pub fn parse_config() -> usize { 1 }\n",
+    )
+    .unwrap();
+    let cap = WorkspaceCap::new(&root).unwrap();
+    let out = execute_code_graph(
+        &cap,
+        &serde_json::json!({"query": "exponential backoff jitter", "max_nodes": 5}).to_string(),
+    );
+    assert_eq!(
+        out.outcome,
+        kroma_core::messages::ToolOutcome::Success,
+        "code_graph failed: {:?}",
+        out.content
+    );
+    assert!(
+        out.content.contains("retry.rs"),
+        "a natural-language query must reach the file whose comment answers it: {}",
+        out.content
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t17_experiment_manifest.rs b/crates/kroma-core/tests/t17_experiment_manifest.rs
new file mode 100644
index 0000000..7daa39c
--- /dev/null
+++ b/crates/kroma-core/tests/t17_experiment_manifest.rs
@@ -0,0 +1,385 @@
+//! T17 (KR-12/13/14): a frozen experiment manifest that cannot be quietly reinterpreted.
+//!
+//! Each test pins one way the old setup could lie: duplicate ids, an empty or unknown holdout, a
+//! matrix nobody checked the size of, a lossy job directory, an effective manifest that was never
+//! exported, and a development-set win being promoted as if it were a holdout result.
+
+use kroma_core::experiment::{
+    promotion_verdict, ArmKind, DecisionBasis, ExperimentManifest, JobId, ManifestError, Promotion,
+    EXPERIMENT_MANIFEST_VERSION, MAX_EXPERIMENT_JOBS,
+};
+
+fn manifest_json(arms: &str, tasks: &str, extra: &str) -> String {
+    format!(
+        r#"{{
+            "version": {EXPERIMENT_MANIFEST_VERSION},
+            "id": "exp-1",
+            "arms": {arms},
+            "tasks": {tasks},
+            "repeats": 2,
+            "sandbox": "bwrap",
+            "oracle": "cargo test",
+            {extra}
+            "max_total_tokens": 1000000
+        }}"#
+    )
+}
+
+fn valid_json() -> String {
+    manifest_json(
+        r#"[
+            {"id": "base", "kind": "baseline", "model": "m-a", "price_table": "p1"},
+            {"id": "cand", "kind": "candidate", "model": "m-b", "price_table": "p1"}
+        ]"#,
+        r#"[
+            {"id": "t1", "source": "prompt 1"},
+            {"id": "t2", "source": "prompt 2"},
+            {"id": "t3", "source": "prompt 3"}
+        ]"#,
+        r#""holdout": ["t3"],"#,
+    )
+}
+
+#[test]
+fn duplicate_task_or_arm_id_fails_before_provider_call() {
+    // Duplicate arm id.
+    let dup_arm = manifest_json(
+        r#"[
+            {"id": "base", "kind": "baseline", "model": "m-a", "price_table": "p1"},
+            {"id": "base", "kind": "candidate", "model": "m-b", "price_table": "p1"}
+        ]"#,
+        r#"[{"id": "t1", "source": "s"}]"#,
+        "",
+    );
+    match ExperimentManifest::from_json(&dup_arm) {
+        Err(ManifestError::DuplicateArmId(id)) => assert_eq!(id, "base"),
+        other => panic!("expected DuplicateArmId, got {other:?}"),
+    }
+
+    // Duplicate task id.
+    let dup_task = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t1", "source": "b"}]"#,
+        "",
+    );
+    match ExperimentManifest::from_json(&dup_task) {
+        Err(ManifestError::DuplicateTaskId(id)) => assert_eq!(id, "t1"),
+        other => panic!("expected DuplicateTaskId, got {other:?}"),
+    }
+}
+
+/// A declared-but-empty holdout must never be read as "compare on everything".
+#[test]
+fn declared_but_empty_holdout_never_accepts() {
+    let empty_holdout = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t2", "source": "b"}]"#,
+        r#""holdout": [],"#,
+    );
+    match ExperimentManifest::from_json(&empty_holdout) {
+        Err(ManifestError::DeclaredButEmptyHoldout) => {}
+        other => panic!("expected DeclaredButEmptyHoldout, got {other:?}"),
+    }
+
+    // Omitting the field entirely is the legitimate "no split" case, and it is reported as such.
+    let no_holdout = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t2", "source": "b"}]"#,
+        "",
+    );
+    let resolved = ExperimentManifest::from_json(&no_holdout).expect("valid manifest");
+    assert_eq!(resolved.decision_basis, DecisionBasis::AllTasks);
+    assert_eq!(resolved.decision_basis.as_str(), "all_tasks");
+
+    // A holdout that covers everything leaves nothing for development.
+    let everything = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t2", "source": "b"}]"#,
+        r#""holdout": ["t1", "t2"],"#,
+    );
+    match ExperimentManifest::from_json(&everything) {
+        Err(ManifestError::HoldoutOverlapsEverything) => {}
+        other => panic!("expected HoldoutOverlapsEverything, got {other:?}"),
+    }
+}
+
+#[test]
+fn unknown_holdout_id_is_configuration_error() {
+    let json = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t2", "source": "b"}]"#,
+        r#""holdout": ["t9"],"#,
+    );
+    match ExperimentManifest::from_json(&json) {
+        Err(ManifestError::UnknownHoldoutId(id)) => assert_eq!(id, "t9"),
+        other => panic!("expected UnknownHoldoutId, got {other:?}"),
+    }
+
+    // Duplicated holdout ids are also refused: the split size would silently differ from the declared
+    // one, which changes the estimator's n.
+    let dup = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}, {"id": "t2", "source": "b"}, {"id": "t3", "source": "c"}]"#,
+        r#""holdout": ["t3", "t3"],"#,
+    );
+    match ExperimentManifest::from_json(&dup) {
+        Err(ManifestError::DuplicateHoldoutId(id)) => assert_eq!(id, "t3"),
+        other => panic!("expected DuplicateHoldoutId, got {other:?}"),
+    }
+}
+
+#[test]
+fn oversized_experiment_matrix_is_refused() {
+    // 200 arms x 60 tasks x 2 repeats = 24,000 jobs, over the 10,000 cap.
+    let arms: Vec<String> = (0..200)
+        .map(|i| {
+            let kind = if i == 0 { "baseline" } else { "candidate" };
+            format!(r#"{{"id": "a{i}", "kind": "{kind}", "model": "m", "price_table": "p"}}"#)
+        })
+        .collect();
+    let tasks: Vec<String> = (0..60)
+        .map(|i| format!(r#"{{"id": "t{i}", "source": "s"}}"#))
+        .collect();
+    let json = manifest_json(
+        &format!("[{}]", arms.join(",")),
+        &format!("[{}]", tasks.join(",")),
+        "",
+    );
+    match ExperimentManifest::from_json(&json) {
+        Err(ManifestError::MatrixTooLarge { jobs, limit }) => {
+            assert_eq!(jobs, 200 * 60 * 2);
+            assert_eq!(limit, MAX_EXPERIMENT_JOBS);
+        }
+        other => panic!("expected MatrixTooLarge, got {other:?}"),
+    }
+
+    // A budget below one request per job is a typo, not a budget.
+    let tiny_budget = format!(
+        r#"{{
+            "version": {EXPERIMENT_MANIFEST_VERSION}, "id": "e",
+            "arms": [{{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}}],
+            "tasks": [{{"id": "t1", "source": "a"}}, {{"id": "t2", "source": "b"}}],
+            "repeats": 4, "oracle": "true", "max_total_tokens": 10
+        }}"#
+    );
+    match ExperimentManifest::from_json(&tiny_budget) {
+        Err(ManifestError::BudgetTooSmallForMatrix { required, declared }) => {
+            assert_eq!(required, 8 * 256);
+            assert_eq!(declared, 10);
+        }
+        other => panic!("expected BudgetTooSmallForMatrix, got {other:?}"),
+    }
+}
+
+#[test]
+fn effective_manifest_is_exported_and_hashed() {
+    let resolved = ExperimentManifest::from_json(&valid_json()).expect("valid manifest");
+    // 2 arms x 3 tasks x 2 repeats.
+    assert_eq!(resolved.jobs.len(), 12);
+    assert_eq!(resolved.decision_basis, DecisionBasis::Holdout);
+
+    let exported = resolved.effective_manifest_json();
+    let reparsed = ExperimentManifest::from_json(&exported).expect("the export round-trips");
+    assert_eq!(
+        reparsed.digest, resolved.digest,
+        "the exported manifest must hash to the same digest"
+    );
+    assert_eq!(reparsed.jobs, resolved.jobs);
+    // The digest covers the settings that decide what runs, not just the ids.
+    let mut changed = resolved.clone();
+    changed.manifest.repeats = 3;
+    let changed = changed.manifest.resolve().expect("valid");
+    assert_ne!(changed.digest, resolved.digest);
+    assert_eq!(resolved.digest.len(), 64);
+}
+
+#[test]
+fn unknown_or_unused_manifest_field_is_rejected() {
+    let typo = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        r#""holdout_tasks": ["t1"],"#,
+    );
+    match ExperimentManifest::from_json(&typo) {
+        Err(ManifestError::Malformed(msg)) => {
+            assert!(msg.contains("unknown field"), "unexpected message: {msg}")
+        }
+        other => panic!("expected Malformed for an unknown field, got {other:?}"),
+    }
+
+    // A misspelled key inside an arm is refused for the same reason.
+    let bad_arm = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_tabel": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        "",
+    );
+    assert!(matches!(
+        ExperimentManifest::from_json(&bad_arm),
+        Err(ManifestError::Malformed(_))
+    ));
+
+    // An unknown version is refused rather than guessed at.
+    let future = valid_json().replace(
+        &format!("\"version\": {}", EXPERIMENT_MANIFEST_VERSION),
+        "\"version\": 99",
+    );
+    match ExperimentManifest::from_json(&future) {
+        Err(ManifestError::UnsupportedVersion { found, .. }) => assert_eq!(found, 99),
+        other => panic!("expected UnsupportedVersion, got {other:?}"),
+    }
+}
+
+/// Job directories are encoded, not sanitized: two ids that sanitize to the same string stay distinct.
+#[test]
+fn sanitization_collision_cannot_reuse_workspace() {
+    let a = JobId {
+        task_id: "a/b".to_string(),
+        arm_id: "x".to_string(),
+        repetition: 0,
+    };
+    let b = JobId {
+        task_id: "a_b".to_string(),
+        arm_id: "x".to_string(),
+        repetition: 0,
+    };
+    assert_ne!(
+        a.dir_name(),
+        b.dir_name(),
+        "two ids that sanitize identically must not share a directory"
+    );
+    // And the encoding is reversible in the sense that distinct ids never collide at all.
+    let mut seen = std::collections::BTreeSet::new();
+    for task in ["a/b", "a_b", "a.b", "a b", "a\\b"] {
+        for arm in ["cand", "cand_1"] {
+            for repetition in 0..3 {
+                let job = JobId {
+                    task_id: task.to_string(),
+                    arm_id: arm.to_string(),
+                    repetition,
+                };
+                assert!(seen.insert(job.dir_name()), "collision for {job:?}");
+            }
+        }
+    }
+}
+
+#[test]
+fn each_pair_has_exactly_one_baseline_and_candidate() {
+    // Two baselines: there is no single reference point.
+    let two_baselines = manifest_json(
+        r#"[
+            {"id": "b1", "kind": "baseline", "model": "m", "price_table": "p"},
+            {"id": "b2", "kind": "baseline", "model": "m", "price_table": "p"}
+        ]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        "",
+    );
+    match ExperimentManifest::from_json(&two_baselines) {
+        Err(ManifestError::BaselineCount { found }) => assert_eq!(found, 2),
+        other => panic!("expected BaselineCount, got {other:?}"),
+    }
+
+    // No baseline at all.
+    let no_baseline = manifest_json(
+        r#"[{"id": "c1", "kind": "candidate", "model": "m", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        "",
+    );
+    match ExperimentManifest::from_json(&no_baseline) {
+        Err(ManifestError::BaselineCount { found }) => assert_eq!(found, 0),
+        other => panic!("expected BaselineCount, got {other:?}"),
+    }
+
+    // A candidate without a sandbox is refused: it would race on the host.
+    let unsandboxed = format!(
+        r#"{{
+            "version": {EXPERIMENT_MANIFEST_VERSION}, "id": "e",
+            "arms": [
+                {{"id": "base", "kind": "baseline", "model": "m", "price_table": "p"}},
+                {{"id": "cand", "kind": "candidate", "model": "m", "price_table": "p"}}
+            ],
+            "tasks": [{{"id": "t1", "source": "a"}}],
+            "repeats": 1, "oracle": "true"
+        }}"#
+    );
+    assert!(matches!(
+        ExperimentManifest::from_json(&unsandboxed),
+        Err(ManifestError::MissingSandboxForCandidate)
+    ));
+
+    // Missing model / price table are refused, not defaulted.
+    let no_model = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "", "price_table": "p"}]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        "",
+    );
+    assert!(matches!(
+        ExperimentManifest::from_json(&no_model),
+        Err(ManifestError::MissingModel(_))
+    ));
+    let no_price = manifest_json(
+        r#"[{"id": "base", "kind": "baseline", "model": "m", "price_table": " "}]"#,
+        r#"[{"id": "t1", "source": "a"}]"#,
+        "",
+    );
+    assert!(matches!(
+        ExperimentManifest::from_json(&no_price),
+        Err(ManifestError::MissingPriceTable(_))
+    ));
+}
+
+/// A development-set win is not a promotion.
+#[test]
+fn development_only_gain_does_not_promote() {
+    // Great on development, negative on the holdout: reject.
+    assert_eq!(
+        promotion_verdict(
+            DecisionBasis::Holdout,
+            Some((0.40, 0.30, 0.50)),
+            Some((-0.05, -0.12, 0.02)),
+        ),
+        Promotion::Reject
+    );
+    // Great on development, holdout indistinguishable from zero: not a promotion either.
+    assert_eq!(
+        promotion_verdict(
+            DecisionBasis::Holdout,
+            Some((0.40, 0.30, 0.50)),
+            Some((0.01, -0.02, 0.04)),
+        ),
+        Promotion::Inconclusive
+    );
+    // A real holdout win promotes, regardless of development.
+    assert_eq!(
+        promotion_verdict(
+            DecisionBasis::Holdout,
+            Some((0.01, -0.01, 0.02)),
+            Some((0.08, 0.03, 0.13)),
+        ),
+        Promotion::Promote
+    );
+    // No holdout declared: nothing can be promoted.
+    assert_eq!(
+        promotion_verdict(DecisionBasis::AllTasks, Some((0.5, 0.4, 0.6)), None),
+        Promotion::CannotPromoteWithoutHoldout
+    );
+}
+
+/// The cost/quality split is stated, not implied.
+#[test]
+fn cost_and_quality_split_basis_is_explicit() {
+    let resolved = ExperimentManifest::from_json(&valid_json()).expect("valid manifest");
+    assert_eq!(resolved.decision_basis, DecisionBasis::Holdout);
+    assert_eq!(resolved.decision_basis.as_str(), "holdout");
+    assert!(resolved.is_holdout("t3"));
+    assert!(!resolved.is_holdout("t1"));
+    // The baseline is identifiable without scanning arms by hand.
+    assert_eq!(resolved.baseline_arm().kind, ArmKind::Baseline);
+    assert_eq!(resolved.baseline_arm().id, "base");
+    // Every job carries an arm and a repetition, so a cost comparison can pair them.
+    for job in &resolved.jobs {
+        assert!(!job.arm_id.is_empty());
+        assert!(job.repetition < resolved.manifest.repeats);
+        assert!(resolved.manifest.tasks.iter().any(|t| t.id == job.task_id));
+    }
+}
diff --git a/crates/kroma-core/tests/t18_provenance_identity.rs b/crates/kroma-core/tests/t18_provenance_identity.rs
new file mode 100644
index 0000000..ac4eebd
--- /dev/null
+++ b/crates/kroma-core/tests/t18_provenance_identity.rs
@@ -0,0 +1,369 @@
+//! T18 (KR-23, KR-24): build/repo identity that is bounded, separable, and honest about gaps.
+//!
+//! What was wrong: the VCS probe used an unbounded `Command::output()`, so `git status` on a large or
+//! network-backed tree could hang a run; the source hash read whole files with `std::fs::read`, so a
+//! file that grew after the size check could blow the budget; a file that could not be read was
+//! skipped silently, producing a "complete" hash that identified less than it claimed; and the
+//! executable bit was not part of the identity, so `chmod +x` left it unchanged.
+
+use kroma_core::messages::{AssistantTurn, FinishReason, TokenUsage};
+use kroma_core::provenance::{fingerprint, fingerprint_explicit, git_probe, GIT_PROBE_BUDGET};
+use kroma_core::provider::{ModelProvider, ProviderCompletion, ProviderError, ProviderRequest};
+use std::future::Future;
+use std::path::{Path, PathBuf};
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t18-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(&root).unwrap();
+    root
+}
+
+/// A slow VCS probe is reported as a timeout within its budget instead of hanging the run.
+#[test]
+fn git_probe_timeout_is_observable() {
+    let root = scratch("git-timeout");
+    let script = root.join("slow-git.sh");
+    std::fs::write(&script, "#!/bin/sh\nsleep 30\n").unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let work = root.join("ws");
+    std::fs::create_dir_all(&work).unwrap();
+
+    let started = Instant::now();
+    let probe = git_probe(
+        script.to_str().unwrap(),
+        &work,
+        &["status", "--porcelain"],
+        Duration::from_millis(300),
+    );
+    let elapsed = started.elapsed();
+
+    assert!(
+        probe.timed_out,
+        "a hung probe must be reported as a timeout"
+    );
+    assert_eq!(
+        probe.stdout, None,
+        "a timed-out probe has no output to trust"
+    );
+    assert!(
+        elapsed < Duration::from_secs(5),
+        "the probe waited {elapsed:?} instead of honouring its 300ms budget"
+    );
+    // The production budget is a real, finite number.
+    assert!(GIT_PROBE_BUDGET <= Duration::from_secs(30));
+
+    // A command that merely fails is *not* a timeout: "not a repository" is a legitimate answer.
+    let failing = git_probe("/bin/false", &work, &["status"], Duration::from_secs(5));
+    assert!(!failing.timed_out);
+    assert_eq!(failing.stdout, None);
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// The source hash never reads more than its budget, even for a file larger than the whole budget.
+#[test]
+fn growing_source_cannot_exceed_hash_read_budget() {
+    let root = scratch("hash-budget");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::write(ws.join("small.rs"), "fn a() {}\n").unwrap();
+    // A sparse file bigger than the 256 MiB source budget: creating it costs no blocks, and reading it
+    // would be the bug. The walk must stop at the bound and say so.
+    let huge = ws.join("huge.bin");
+    let file = std::fs::File::create(&huge).unwrap();
+    file.set_len(300 * 1024 * 1024).unwrap();
+    drop(file);
+
+    let started = Instant::now();
+    let fingerprint = fingerprint_explicit(&ws, None);
+    let elapsed = started.elapsed();
+
+    assert!(
+        elapsed < Duration::from_secs(20),
+        "hashing took {elapsed:?}: the read budget was not enforced"
+    );
+    assert!(
+        fingerprint.source_hash_capped,
+        "a tree over the byte budget must be reported as capped"
+    );
+    assert!(
+        fingerprint.source_identity_incomplete,
+        "a capped hash does not identify the whole tree"
+    );
+    assert!(
+        fingerprint
+            .incomplete_reason
+            .as_deref()
+            .unwrap_or("")
+            .contains("bound"),
+        "the reason must say why: {:?}",
+        fingerprint.incomplete_reason
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A binary from somewhere else is a *separate* identity: it must not perturb the source hash.
+#[test]
+fn running_binary_from_other_repo_does_not_change_build_id() {
+    let root = scratch("binary-separate");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::write(ws.join("lib.rs"), "pub fn a() {}\n").unwrap();
+
+    let without_binary = fingerprint_explicit(&ws, None);
+    // The "running binary" lives outside the source tree and has nothing to do with it.
+    let binary = root.join("kroma-from-elsewhere");
+    std::fs::write(&binary, b"not really an executable").unwrap();
+    let with_binary = fingerprint_explicit(&ws, Some(&binary));
+
+    assert_eq!(
+        without_binary.source_sha256, with_binary.source_sha256,
+        "a binary from another tree changed the source identity"
+    );
+    assert!(
+        with_binary.binary_sha256.is_some(),
+        "the binary identity must be recorded separately"
+    );
+    assert_ne!(
+        with_binary.binary_sha256, with_binary.source_sha256,
+        "build identity and repo identity are different things"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// The executable bit is part of the identity: `chmod +x` changes what the tree builds into.
+#[test]
+fn executable_mode_change_changes_reproducibility_identity() {
+    let root = scratch("mode");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(&ws).unwrap();
+    let script = ws.join("run.sh");
+    std::fs::write(&script, "#!/bin/sh\necho hi\n").unwrap();
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o644)).unwrap();
+        let plain = fingerprint_explicit(&ws, None);
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let executable = fingerprint_explicit(&ws, None);
+        assert_ne!(
+            plain.source_sha256, executable.source_sha256,
+            "the executable bit must be part of the source identity"
+        );
+        assert_eq!(plain.source_files, executable.source_files);
+    }
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A source tree that cannot be fully read reports an incomplete identity rather than a complete one.
+#[test]
+fn unreadable_source_never_yields_complete_identity() {
+    // NOTE: the test process runs as root here, so `chmod 000` would still be readable. The
+    // deterministic trigger for the same code path is a tree whose size exceeds the read budget: the
+    // hash stops, and the fingerprint must say the identity is partial instead of presenting the hash
+    // as complete. The read-error branch itself is exercised by the same `incomplete` assignment.
+    let root = scratch("incomplete");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::write(ws.join("a.rs"), "fn a() {}\n").unwrap();
+    let sparse = ws.join("big.bin");
+    let file = std::fs::File::create(&sparse).unwrap();
+    file.set_len(260 * 1024 * 1024).unwrap();
+    drop(file);
+
+    let fingerprint = fingerprint_explicit(&ws, None);
+    assert!(fingerprint.source_identity_incomplete);
+    assert!(
+        fingerprint.incomplete_reason.is_some(),
+        "an incomplete identity must say why"
+    );
+    // The summary must show it too, not just the struct field.
+    assert!(fingerprint.summary().contains("capped"));
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// The cheap entry point still produces a usable identity for a normal tree.
+#[test]
+fn ordinary_source_tree_still_identifies_completely() {
+    let root = scratch("ordinary");
+    let ws = root.join("ws");
+    std::fs::create_dir_all(ws.join("src")).unwrap();
+    std::fs::write(ws.join("src/lib.rs"), "pub fn a() {}\n").unwrap();
+    std::fs::write(ws.join("Cargo.toml"), "[package]\nname='x'\n").unwrap();
+
+    // `fingerprint` deliberately refuses to walk a tree without VCS metadata (a process started from
+    // `/` must not hash the filesystem), so the explicit entry point is the one that identifies a
+    // release tarball or an exported directory.
+    assert!(
+        fingerprint(&ws, None).source_sha256.is_none(),
+        "the heuristic entry point must not walk a non-repository tree"
+    );
+    let fingerprint = fingerprint_explicit(&ws, None);
+    assert!(fingerprint.source_sha256.is_some());
+    assert!(
+        !fingerprint.source_identity_incomplete,
+        "{:?}",
+        fingerprint.incomplete_reason
+    );
+    assert_eq!(fingerprint.source_files, Some(2));
+    assert!(!fingerprint.git_probe_timeout);
+
+    // Two runs over the same tree agree.
+    let again = fingerprint_explicit(&ws, None);
+    assert_eq!(fingerprint.source_sha256, again.source_sha256);
+
+    let _ = std::fs::remove_dir_all(&root);
+    let _ = Path::new("/nonexistent");
+}
+
+// ---------------------------------------------------------------------------------------------
+// Wire-request identity: the recorded hash must be the request that was actually sent
+// ---------------------------------------------------------------------------------------------
+
+/// A provider that records exactly what it was handed, then answers without tool calls.
+struct RecordingProvider {
+    seen: Arc<Mutex<Vec<ProviderRequest>>>,
+}
+
+impl ModelProvider for RecordingProvider {
+    fn complete<'a>(
+        &'a self,
+        req: ProviderRequest,
+        _budget: &'a kroma_core::budget::BudgetConfig,
+        _cancel_rx: tokio::sync::watch::Receiver<bool>,
+    ) -> Pin<Box<dyn Future<Output = Result<ProviderCompletion, ProviderError>> + Send + 'a>> {
+        self.seen.lock().unwrap().push(req);
+        Box::pin(async move {
+            Ok(ProviderCompletion {
+                turn: AssistantTurn {
+                    content: Some("done".to_string()),
+                    reasoning_blocks: Vec::new(),
+                    tool_calls: Vec::new(),
+                    finish_reason: FinishReason::Stop,
+                    usage: Some(TokenUsage {
+                        input_tokens: 100,
+                        cached_input_tokens: Some(10),
+                        cache_creation_input_tokens: Some(5),
+                        output_tokens: 10,
+                        reasoning_tokens: None,
+                    }),
+                },
+                request_body_bytes: 1,
+                latency_ms: 1,
+                ttft_ms: None,
+                attempts_used: 1,
+                reported_model: Some("model-a".to_string()),
+            })
+        })
+    }
+}
+
+#[tokio::test]
+async fn on_demand_report_hash_matches_captured_wire_request() {
+    use kroma_core::agent_loop::{build_default_runtime, AgentRunConfig, AgentRunner};
+    use kroma_core::budget::BudgetConfig;
+    use kroma_core::events::EventLogger;
+    use kroma_core::session::SessionJournal;
+    use kroma_core::tool::policy::{NonInteractiveApprovalHandler, PolicyEngine, PolicyMode};
+
+    let root = scratch("wire-identity");
+    let ws = root.join("ws");
+    let state = root.join("state");
+    std::fs::create_dir_all(&ws).unwrap();
+    std::fs::create_dir_all(&state).unwrap();
+    std::fs::write(ws.join("lib.rs"), "pub fn a() {}\n").unwrap();
+
+    let budget = BudgetConfig::default();
+    let env = Arc::new(kroma_core::env::LocalHostEnv::new(&ws, state.clone()).unwrap());
+    let policy = PolicyEngine::new(
+        PolicyMode::ReadOnly,
+        Arc::new(NonInteractiveApprovalHandler),
+    );
+    // On-demand tools: the final tool list differs from the configured one, which is exactly why the
+    // identity has to be computed after assembly.
+    let runtime = build_default_runtime(env, policy, budget.clone(), None);
+    let cfg = AgentRunConfig::new("say done", budget).with_on_demand_tools(true);
+    let run_id = cfg.run_id;
+    let logger = EventLogger::new(run_id, Some(state.clone()), false).unwrap();
+    let journal = SessionJournal::create(state.join("sessions"), &ws).unwrap();
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let (_tx, rx) = tokio::sync::watch::channel(false);
+
+    let (summary, _logger) = AgentRunner::new(
+        cfg,
+        Arc::new(RecordingProvider {
+            seen: Arc::clone(&seen),
+        }),
+        runtime,
+        rx,
+    )
+    .with_session_journal(journal)
+    .run(logger)
+    .await;
+    assert_eq!(summary.turns_used, 1);
+
+    let requests = seen.lock().unwrap().clone();
+    assert_eq!(
+        requests.len(),
+        1,
+        "expected exactly one transmitted request"
+    );
+    let captured = &requests[0];
+    let expected = kroma_core::provenance::request_identity(
+        &captured.system_prompt,
+        &captured.tools,
+        &captured.messages,
+    );
+
+    // Read the event log the run wrote and find the recorded identity.
+    let log_path = state.join(format!("{}.jsonl", run_id));
+    let text = std::fs::read_to_string(&log_path).expect("event log");
+    let recorded = text
+        .lines()
+        .filter_map(|line| serde_json::from_str::<serde_json::Value>(line).ok())
+        .find_map(|event| {
+            // Events are internally tagged: {"event_type": "ModelRequestCompleted", "payload": {...}}.
+            let kind = event.get("event_type").and_then(|v| v.as_str())?;
+            if kind != "ModelRequestCompleted" {
+                return None;
+            }
+            event
+                .get("payload")
+                .and_then(|v| v.get("request_identity_sha256"))
+                .and_then(|v| v.as_str())
+                .map(str::to_string)
+        })
+        .expect("the run must record a request identity");
+
+    assert_eq!(
+        recorded, expected,
+        "the recorded hash must correspond to the request that was actually sent"
+    );
+    assert_eq!(recorded.len(), 64);
+
+    // Changing one byte of the request changes the identity.
+    let mut tampered = captured.clone();
+    tampered.system_prompt.push(' ');
+    assert_ne!(
+        kroma_core::provenance::request_identity(
+            &tampered.system_prompt,
+            &tampered.tools,
+            &tampered.messages
+        ),
+        expected
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t18_usage_cost.rs b/crates/kroma-core/tests/t18_usage_cost.rs
new file mode 100644
index 0000000..228a120
--- /dev/null
+++ b/crates/kroma-core/tests/t18_usage_cost.rs
@@ -0,0 +1,256 @@
+//! T18 (KR-15): request-level cost, priced per attempt, with incompleteness made explicit.
+//!
+//! The defects pinned here:
+//! * cache *writes* were priced as if they were uncached input (the rate table had no write rate at
+//!   all), so every warm-up turn was under-charged;
+//! * a whole run was priced with one model name, so a retry that landed on a different checkpoint, or
+//!   a child running a different model, was priced at the last model's rates;
+//! * an estimate or a missing usage could quietly become a number, which reads as measured spend.
+
+use kroma_core::messages::TokenUsage;
+use kroma_core::usage_cost::{CostLedger, PriceTable, TokenRates, UsageBasis};
+use std::collections::BTreeMap;
+
+fn table_with_creation(creation: Option<u64>) -> PriceTable {
+    let mut models = BTreeMap::new();
+    models.insert(
+        "model-a".to_string(),
+        TokenRates {
+            uncached_input_nano_usd: 100,
+            cached_input_nano_usd: 10,
+            cache_creation_input_nano_usd: creation,
+            output_nano_usd: 400,
+        },
+    );
+    models.insert(
+        "model-b".to_string(),
+        TokenRates {
+            uncached_input_nano_usd: 200,
+            cached_input_nano_usd: 20,
+            cache_creation_input_nano_usd: Some(250),
+            output_nano_usd: 800,
+        },
+    );
+    PriceTable {
+        version: "prices-v1".to_string(),
+        source: "operator table".to_string(),
+        models,
+    }
+}
+
+fn usage(input: u64, cached: u64, creation: u64, output: u64) -> TokenUsage {
+    TokenUsage {
+        input_tokens: input,
+        cached_input_tokens: Some(cached),
+        cache_creation_input_tokens: Some(creation),
+        output_tokens: output,
+        reasoning_tokens: None,
+    }
+}
+
+/// Writes and reads are different line items with different rates.
+#[test]
+fn cache_creation_and_read_have_distinct_rates() {
+    let table = table_with_creation(Some(125));
+    // 1000 input = 100 uncached + 600 read + 300 written; 100 output.
+    // 100×100 + 600×10 + 300×125 + 100×400 = 10000 + 6000 + 37500 + 40000 = 93500
+    let estimate = table.estimate(Some("model-a"), Some(usage(1000, 600, 300, 100)));
+    assert_eq!(
+        estimate.estimated_nano_usd,
+        Some(93_500),
+        "reason: {:?}",
+        estimate.unknown_reason
+    );
+
+    // Charging the write at the read rate would be 10000 + 6000 + 3000 + 40000 = 59000 — a 37%
+    // understatement, which is exactly the old behaviour.
+    assert_ne!(estimate.estimated_nano_usd, Some(59_000));
+
+    // A table without a write rate cannot price a turn that wrote to the cache: it is unknown, not
+    // free and not "same as read".
+    let no_write_rate = table_with_creation(None);
+    let unknown = no_write_rate.estimate(Some("model-a"), Some(usage(1000, 600, 300, 100)));
+    assert_eq!(unknown.estimated_nano_usd, None);
+    assert!(
+        unknown
+            .unknown_reason
+            .as_deref()
+            .unwrap_or("")
+            .contains("cache-creation"),
+        "unexpected reason: {:?}",
+        unknown.unknown_reason
+    );
+
+    // With no cache write at all the same table is fine.
+    let clean = no_write_rate.estimate(Some("model-a"), Some(usage(1000, 600, 0, 100)));
+    // 400 uncached × 100 + 600 cached × 10 + 100 output × 400 = 86_000
+    assert_eq!(clean.estimated_nano_usd, Some(86_000));
+}
+
+/// Each attempt is priced at the model *it* reported, not at the run's last model.
+#[test]
+fn mixed_returned_models_are_priced_per_attempt() {
+    let table = table_with_creation(Some(125));
+    let mut ledger = CostLedger::new();
+
+    // Attempt 0: the requested alias resolved to model-a.
+    ledger.record_attempt(
+        Some("alias"),
+        Some("model-a"),
+        Some(usage(1000, 0, 0, 100)),
+        UsageBasis::Measured,
+        None,
+        &table,
+    );
+    // Attempt 1 is a retry that landed on model-b (a different checkpoint, twice the rates).
+    ledger.record_attempt(
+        Some("alias"),
+        Some("model-b"),
+        Some(usage(1000, 0, 0, 100)),
+        UsageBasis::Measured,
+        Some(0),
+        &table,
+    );
+
+    let summary = ledger.summary();
+    assert_eq!(summary.attempts, 2);
+    assert_eq!(summary.measured_attempts, 2);
+    assert!(
+        !summary.incomplete,
+        "both attempts were measured and priced"
+    );
+    // model-a: 1000×100 + 100×400 = 140000; model-b: 1000×200 + 100×800 = 280000.
+    assert_eq!(summary.by_model_nano_usd["model-a"], 140_000);
+    assert_eq!(summary.by_model_nano_usd["model-b"], 280_000);
+    assert_eq!(summary.measured_nano_usd, 420_000);
+    assert_eq!(summary.total_nano_usd(), Some(420_000));
+
+    // Pricing the whole 2000 input tokens at the *last* model would have been 2000×200 + 200×800 =
+    // 560000, or at the first 280000 — either way not the real 420000.
+    assert_ne!(summary.measured_nano_usd, 560_000);
+    assert_ne!(summary.measured_nano_usd, 280_000);
+    assert_eq!(ledger.attempts()[1].retry_of, Some(0));
+}
+
+/// An estimate is not a measurement.
+#[test]
+fn byte_estimate_cannot_claim_provider_measured_cost() {
+    let table = table_with_creation(Some(125));
+    let mut ledger = CostLedger::new();
+    // No provider usage at all: the host estimated the tokens.
+    ledger.record_attempt(
+        Some("model-a"),
+        Some("model-a"),
+        Some(usage(500, 0, 0, 50)),
+        UsageBasis::Estimated,
+        None,
+        &table,
+    );
+    let summary = ledger.summary();
+    assert_eq!(summary.measured_attempts, 0);
+    assert_eq!(
+        summary.measured_nano_usd, 0,
+        "an estimate must not land in measured spend"
+    );
+    assert_eq!(summary.estimated_attempts, 1);
+    assert!(summary.estimated_nano_usd > 0);
+    assert!(
+        summary.incomplete,
+        "the total is not a complete measured cost"
+    );
+    assert_eq!(
+        summary.total_nano_usd(),
+        None,
+        "a report must not be handed a number that looks measured"
+    );
+    assert!(!summary.unknown_reasons.is_empty());
+}
+
+/// A retry whose usage never arrived makes the total incomplete instead of silently smaller.
+#[test]
+fn unknown_retry_usage_makes_total_cost_incomplete() {
+    let table = table_with_creation(Some(125));
+    let mut ledger = CostLedger::new();
+    ledger.record_attempt(
+        Some("model-a"),
+        Some("model-a"),
+        Some(usage(1000, 600, 0, 100)),
+        UsageBasis::Measured,
+        None,
+        &table,
+    );
+    // The retry failed after dispatch; no usage is known.
+    ledger.record_attempt(
+        Some("model-a"),
+        None,
+        None,
+        UsageBasis::Unknown,
+        Some(0),
+        &table,
+    );
+
+    let summary = ledger.summary();
+    assert_eq!(summary.attempts, 2);
+    assert_eq!(summary.measured_attempts, 1);
+    assert_eq!(summary.unknown_attempts, 1);
+    assert!(
+        summary.incomplete,
+        "a missing retry usage makes the total incomplete"
+    );
+    assert_eq!(summary.total_nano_usd(), None);
+    // The known part is still reported, so an operator can see the floor.
+    assert_eq!(summary.measured_nano_usd, 86_000);
+    assert!(
+        summary
+            .unknown_reasons
+            .iter()
+            .any(|r| r.contains("attempt 1")),
+        "the reason must name the attempt: {:?}",
+        summary.unknown_reasons
+    );
+
+    // An unknown *price* (model not in the table) is also incomplete, not zero.
+    let mut unpriced = CostLedger::new();
+    unpriced.record_attempt(
+        Some("model-z"),
+        Some("model-z"),
+        Some(usage(10, 0, 0, 1)),
+        UsageBasis::Measured,
+        None,
+        &table,
+    );
+    let summary = unpriced.summary();
+    assert_eq!(summary.measured_nano_usd, 0);
+    assert!(summary.incomplete);
+    assert!(summary
+        .unknown_reasons
+        .iter()
+        .any(|r| r.contains("no exact rate")));
+}
+
+/// The basis labels are distinct and survive into the record.
+#[test]
+fn usage_basis_labels_are_distinct() {
+    assert_ne!(UsageBasis::Measured, UsageBasis::Estimated);
+    assert_ne!(UsageBasis::Estimated, UsageBasis::Unknown);
+    assert_eq!(UsageBasis::Measured.as_str(), "measured");
+    assert_eq!(UsageBasis::Estimated.as_str(), "estimated");
+    assert_eq!(UsageBasis::Unknown.as_str(), "unknown");
+
+    let table = table_with_creation(Some(125));
+    let mut ledger = CostLedger::new();
+    ledger.record_attempt(
+        Some("m"),
+        Some("model-a"),
+        Some(usage(10, 0, 0, 1)),
+        UsageBasis::Measured,
+        None,
+        &table,
+    );
+    assert_eq!(ledger.attempts()[0].basis, UsageBasis::Measured);
+    assert_eq!(ledger.attempts()[0].requested_model.as_deref(), Some("m"));
+    assert_eq!(
+        ledger.attempts()[0].reported_model.as_deref(),
+        Some("model-a")
+    );
+}
diff --git a/crates/kroma-core/tests/t19_ahe_isolation.rs b/crates/kroma-core/tests/t19_ahe_isolation.rs
new file mode 100644
index 0000000..3e3a85f
--- /dev/null
+++ b/crates/kroma-core/tests/t19_ahe_isolation.rs
@@ -0,0 +1,444 @@
+//! T19 (KR-20/21/22): the self-repair experimenter must not be able to grade itself.
+//!
+//! What was wrong: the baseline was evaluated **in the source tree**, so a verifier that wrote to its
+//! working directory mutated the very workspace the experiment promises to leave alone; the candidate
+//! copy was removed by an explicit call, so any early return leaked it; and every successful
+//! prediction collapsed into one `Accepted`, which meant "I predicted this task would still fail and
+//! it does" counted as a repair.
+
+use kroma_core::ahe::{
+    evaluate_repair, frozen_evaluator_identity, FileChange, Prediction, RepairCandidate,
+    RepairDecision,
+};
+use kroma_core::bench::{BenchTask, VerifyCommandLimits};
+use kroma_core::self_repair_guard::{protected_artifacts, SelfRepairSurface, SelfRepairViolation};
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+/// Serializes the tests in this file: the temp-tree leak check scans `/tmp` for `kroma-ahe-*`, and a
+/// concurrent experiment in another thread would look like a leak.
+static AHE_LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+async fn ahe_guard() -> tokio::sync::MutexGuard<'static, ()> {
+    AHE_LOCK.lock().await
+}
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t19-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    root
+}
+
+fn workspace_files(root: &Path) {
+    std::fs::write(
+        root.join("src/calc.py"),
+        "def total(n):\n    return sum(range(n))\n",
+    )
+    .unwrap();
+    std::fs::write(root.join("src/keep.py"), "def ok():\n    return True\n").unwrap();
+}
+
+fn surface() -> SelfRepairSurface {
+    SelfRepairSurface {
+        allowed_prefixes: vec!["src/".to_string()],
+        extra_protected: Vec::new(),
+    }
+}
+
+fn limits() -> VerifyCommandLimits {
+    VerifyCommandLimits::new(Duration::from_secs(20), 64 * 1024)
+}
+
+fn task(id: &str, verify: &str) -> BenchTask {
+    BenchTask {
+        id: id.to_string(),
+        prompt: "p".to_string(),
+        files: BTreeMap::new(),
+        expect_contains: Vec::new(),
+        expect_absent: Vec::new(),
+        regression_guard: false,
+        verify_command: Some(vec![
+            "python3".to_string(),
+            "-c".to_string(),
+            verify.to_string(),
+        ]),
+    }
+}
+
+fn suite() -> Vec<BenchTask> {
+    vec![
+        task(
+            "sum",
+            "import sys; sys.path.insert(0,'src')\nfrom calc import total\nassert total(3)==6, total(3)",
+        ),
+        task(
+            "keep",
+            "import sys; sys.path.insert(0,'src')\nfrom keep import ok\nassert ok() is True",
+        ),
+    ]
+}
+
+fn fixing_candidate() -> RepairCandidate {
+    RepairCandidate {
+        hypothesis: "total() is off by one".to_string(),
+        prediction: Prediction {
+            task_id: "sum".to_string(),
+            expected_resolved: true,
+        },
+        changes: vec![FileChange {
+            path: "src/calc.py".to_string(),
+            contents: "def total(n):\n    return sum(range(1, n + 1))\n".to_string(),
+        }],
+    }
+}
+
+fn temp_ahe_dirs() -> Vec<PathBuf> {
+    let mut dirs = Vec::new();
+    if let Ok(entries) = std::fs::read_dir(std::env::temp_dir()) {
+        for entry in entries.flatten() {
+            let name = entry.file_name().to_string_lossy().to_string();
+            if name.starts_with("kroma-ahe-") {
+                dirs.push(entry.path());
+            }
+        }
+    }
+    dirs
+}
+
+/// A verifier that writes to its working directory must not reach the source tree: the baseline runs
+/// in a frozen copy, not in place.
+#[tokio::test]
+async fn ahe_baseline_verifier_cannot_mutate_source_root() {
+    let _guard = ahe_guard().await;
+    let root = scratch("baseline-write");
+    workspace_files(&root);
+    let marker = root.join("src/calc.py");
+    let before = std::fs::read_to_string(&marker).unwrap();
+
+    // Both tasks write into their cwd; under the old code the baseline wrote into the source tree.
+    let mut tasks = suite();
+    tasks.push(task(
+        "writer",
+        "open('pwned.txt','w').write('x')\nopen('src/calc.py','w').write('# clobbered')\nprint('ok')",
+    ));
+
+    let outcome = evaluate_repair(&fixing_candidate(), &surface(), &root, &tasks, &limits())
+        .await
+        .expect("the candidate is allowed");
+    assert!(
+        outcome.source_untouched,
+        "the source tree changed: {}",
+        outcome.rationale
+    );
+    assert_eq!(
+        std::fs::read_to_string(&marker).unwrap(),
+        before,
+        "a verifier wrote into the source tree"
+    );
+    assert!(
+        !root.join("pwned.txt").exists(),
+        "a verifier created a file in the source tree"
+    );
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Baseline and candidate start from identical copies of the frozen source.
+#[tokio::test]
+async fn ahe_candidate_and_baseline_start_identical() {
+    let _guard = ahe_guard().await;
+    let root = scratch("identical-start");
+    workspace_files(&root);
+    let log = root
+        .parent()
+        .unwrap()
+        .join(format!("kroma-t19-digests-{}.log", uuid::Uuid::new_v4()));
+    // Each evaluation appends the digest of an untouched file. If the two runs started from different
+    // bytes, the two lines would differ.
+    let digest_task = task(
+        "digest",
+        &format!(
+            "import hashlib, pathlib\n\
+             data = pathlib.Path('src/keep.py').read_bytes()\n\
+             open({:?}, 'a').write(hashlib.sha256(data).hexdigest() + '\\n')",
+            log.display().to_string()
+        ),
+    );
+    let mut tasks = suite();
+    tasks.push(digest_task);
+
+    evaluate_repair(&fixing_candidate(), &surface(), &root, &tasks, &limits())
+        .await
+        .expect("the candidate is allowed");
+
+    let lines: Vec<String> = std::fs::read_to_string(&log)
+        .expect("the digest log")
+        .lines()
+        .map(str::to_string)
+        .collect();
+    assert_eq!(
+        lines.len(),
+        2,
+        "expected one line per evaluation: {lines:?}"
+    );
+    assert_eq!(
+        lines[0], lines[1],
+        "baseline and candidate did not start from identical bytes"
+    );
+    let _ = std::fs::remove_file(&log);
+    let _ = std::fs::remove_dir_all(&root);
+}
