+    assert!(
+        doc.contains("NOT_RUN"),
+        "the doc must say which live checks were not run"
+    );
+    assert!(
+        doc.contains("不是 OS 安全边界") || doc.contains("not an OS security boundary"),
+        "the doc must not imply a worktree is a security boundary"
+    );
+    assert!(
+        doc.contains("许可证"),
+        "the licence decision must be left to the owner, not silently assumed"
+    );
+}
diff --git a/crates/kroma-core/tests/t23_snapshot_identity.rs b/crates/kroma-core/tests/t23_snapshot_identity.rs
new file mode 100644
index 0000000..e17f731
--- /dev/null
+++ b/crates/kroma-core/tests/t23_snapshot_identity.rs
@@ -0,0 +1,396 @@
+//! T23: snapshot identity and recovery invariants — **measurement first**.
+//!
+//! The question the ADR has to answer: is "content identity" being used where "history event
+//! identity" is meant? `RevisionId` is content-addressed, while `WorkspaceRevision` also carries
+//! parent/turn/WAL metadata. When a workspace returns to earlier content (A → B → A), the second `A`
+//! necessarily maps to the same content id — so either the manifest is rewritten (and the parent
+//! chain loses an event), or the design keeps history somewhere else.
+//!
+//! These tests record what the implementation actually does. They are not a claim that undo is
+//! broken; the ADR states exactly which invariants hold and which are not promised.
+
+use kroma_core::revision::{RestoreResult, RevisionId, SnapshotStore};
+use kroma_core::session::SessionJournal;
+use kroma_core::workspace::WorkspaceCap;
+use std::path::{Path, PathBuf};
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t23-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(root.join("ws")).unwrap();
+    std::fs::create_dir_all(root.join("state")).unwrap();
+    root
+}
+
+fn write(ws: &Path, name: &str, contents: &str) {
+    std::fs::write(ws.join(name), contents).unwrap();
+}
+
+/// A → B → A: two history events, one content address.
+#[test]
+fn a_b_a_keeps_every_event_but_rewrites_the_manifest_parent() {
+    let root = scratch("aba");
+    let ws = root.join("ws");
+    let store = SnapshotStore::new(root.join("state/snapshots"));
+    let cap = WorkspaceCap::new(&ws).unwrap();
+    let mut journal = SessionJournal::create(root.join("state/sessions"), &ws).unwrap();
+
+    write(&ws, "a.rs", "fn a() { 1 }\n");
+    let a1 = store
+        .capture_revision(&cap, None, None, 0)
+        .expect("capture A");
+    journal
+        .record_revision_capture(
+            0,
+            a1.revision_id.as_str(),
+            None,
+            a1.changed_paths.clone(),
+            1,
+        )
+        .unwrap();
+
+    write(&ws, "a.rs", "fn a() { 2 }\n");
+    let b = store
+        .capture_revision(&cap, Some(&a1.revision_id), None, 1)
+        .expect("capture B");
+    journal
+        .record_revision_capture(
+            1,
+            b.revision_id.as_str(),
+            Some(a1.revision_id.as_str()),
+            b.changed_paths.clone(),
+            1,
+        )
+        .unwrap();
+
+    // Back to the exact bytes of A.
+    write(&ws, "a.rs", "fn a() { 1 }\n");
+    let a2 = store
+        .capture_revision(&cap, Some(&b.revision_id), None, 2)
+        .expect("capture A again");
+    journal
+        .record_revision_capture(
+            2,
+            a2.revision_id.as_str(),
+            Some(b.revision_id.as_str()),
+            a2.changed_paths.clone(),
+            1,
+        )
+        .unwrap();
+
+    // Measurement 1: the same content yields the same id — this is content addressing working.
+    assert_eq!(
+        a1.revision_id, a2.revision_id,
+        "the same content must map to the same content id"
+    );
+
+    // Measurement 2: the manifest on disk now records A's parent as B, because there is exactly one
+    // manifest per content id. The A→B event (parent = A) is no longer representable in the manifest.
+    let stored = store.load_revision(&a2.revision_id).expect("manifest");
+    assert_eq!(
+        stored.parent_revision_id.as_ref().map(RevisionId::as_str),
+        Some(b.revision_id.as_str()),
+        "the manifest parent was rewritten to the most recent capture"
+    );
+    assert_ne!(
+        stored.parent_revision_id.as_ref(),
+        None,
+        "the second capture kept a parent, it just is not the first one"
+    );
+
+    // Measurement 3: the *session WAL* keeps both A events with their own turn and parent, which is
+    // why undo targets come from the WAL and not from the manifest's parent pointer.
+    let records = journal.revision_records();
+    let a_events: Vec<_> = records
+        .iter()
+        .filter(|record| record.revision_id == a1.revision_id.as_str())
+        .collect();
+    assert_eq!(
+        a_events.len(),
+        2,
+        "both A events must survive in the WAL: {records:?}"
+    );
+    assert_eq!(a_events[0].turn, 0);
+    assert_eq!(a_events[1].turn, 2);
+    assert_eq!(
+        a_events[1].parent_revision_id.as_deref(),
+        Some(b.revision_id.as_str())
+    );
+
+    // Measurement 4: undo targets resolve per turn, so the A→B→A history is still addressable.
+    assert_eq!(
+        journal.revision_at_or_before_turn(0).map(|r| r.revision_id),
+        Some(a1.revision_id.as_str().to_string())
+    );
+    assert_eq!(
+        journal.revision_at_or_before_turn(1).map(|r| r.revision_id),
+        Some(b.revision_id.as_str().to_string())
+    );
+    assert_eq!(
+        journal.revision_at_or_before_turn(2).map(|r| r.revision_id),
+        Some(a1.revision_id.as_str().to_string()),
+        "the third turn is the second A event"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Two different histories that reach the same content share one content id — by design.
+#[test]
+fn two_paths_to_the_same_content_share_a_content_id() {
+    let root = scratch("branches");
+    let store_a = SnapshotStore::new(root.join("state/a"));
+    let store_b = SnapshotStore::new(root.join("state/b"));
+    let ws_a = root.join("ws-a");
+    let ws_b = root.join("ws-b");
+    std::fs::create_dir_all(&ws_a).unwrap();
+    std::fs::create_dir_all(&ws_b).unwrap();
+    write(&ws_a, "x.rs", "fn x() { 1 }\n");
+    write(&ws_b, "x.rs", "fn x() { 1 }\n");
+
+    let cap_a = WorkspaceCap::new(&ws_a).unwrap();
+    let cap_b = WorkspaceCap::new(&ws_b).unwrap();
+    let first = store_a.capture_revision(&cap_a, None, None, 0).unwrap();
+    // The second store reaches the same bytes by a different route (a different parent chain).
+    let other_parent = {
+        write(&ws_a, "x.rs", "fn x() { 2 }\n");
+        let mid = store_a
+            .capture_revision(&cap_a, Some(&first.revision_id), None, 1)
+            .unwrap();
+        write(&ws_a, "x.rs", "fn x() { 1 }\n");
+        store_a
+            .capture_revision(&cap_a, Some(&mid.revision_id), None, 2)
+            .unwrap()
+    };
+    let second = store_b.capture_revision(&cap_b, None, None, 0).unwrap();
+
+    assert_eq!(
+        first.revision_id, second.revision_id,
+        "identical trees must share a content id"
+    );
+    assert_eq!(
+        first.revision_id, other_parent.revision_id,
+        "returning to the same bytes must share a content id"
+    );
+    // But the *manifests* differ in the history metadata they carry, and the store keeps one per
+    // content id, so the last capture wins. That is the documented non-guarantee.
+    let a = store_a.load_revision(&first.revision_id).unwrap();
+    assert!(a.parent_revision_id.is_some(), "store A saw a parent");
+    let b = store_b.load_revision(&second.revision_id).unwrap();
+    assert!(b.parent_revision_id.is_none(), "store B saw no parent");
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Reopening the store and the journal loses nothing: recovery replays committed state.
+#[test]
+fn crash_replay_preserves_revisions_and_undo_targets() {
+    let root = scratch("replay");
+    let ws = root.join("ws");
+    let store_path = root.join("state/snapshots");
+    let journals = root.join("state/sessions");
+    let mut ids = Vec::new();
+    let journal_path;
+    {
+        let store = SnapshotStore::new(&store_path);
+        let cap = WorkspaceCap::new(&ws).unwrap();
+        let mut journal = SessionJournal::create(&journals, &ws).unwrap();
+        let mut parent: Option<RevisionId> = None;
+        for (turn, body) in [
+            (0usize, "fn v() { 0 }\n"),
+            (1, "fn v() { 1 }\n"),
+            (2, "fn v() { 2 }\n"),
+        ] {
+            write(&ws, "v.rs", body);
+            let revision = store
+                .capture_revision(&cap, parent.as_ref(), None, turn)
+                .unwrap();
+            journal
+                .record_revision_capture(
+                    turn,
+                    revision.revision_id.as_str(),
+                    parent.as_ref().map(RevisionId::as_str),
+                    revision.changed_paths.clone(),
+                    1,
+                )
+                .unwrap();
+            ids.push(revision.revision_id.as_str().to_string());
+            parent = Some(revision.revision_id);
+        }
+        journal_path = journal.path().to_path_buf();
+        // Dropped here, as a crash would.
+    }
+
+    let reopened = SessionJournal::open(&journal_path).expect("reopen");
+    let store = SnapshotStore::new(&store_path);
+    assert_eq!(reopened.revision_records().len(), 3);
+    for (turn, id) in ids.iter().enumerate() {
+        assert_eq!(
+            reopened
+                .revision_at_or_before_turn(turn)
+                .map(|r| r.revision_id),
+            Some(id.clone()),
+            "turn {} lost its undo target",
+            turn
+        );
+        assert!(
+            store.load_revision(&RevisionId::new(id.clone())).is_ok(),
+            "revision {} is not loadable after replay",
+            id
+        );
+    }
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// External changes are detected, not silently rolled over.
+#[test]
+fn external_chmod_and_rename_are_detected_before_restore() {
+    let root = scratch("external");
+    let ws = root.join("ws");
+    let store = SnapshotStore::new(root.join("state/snapshots"));
+    let cap = WorkspaceCap::new(&ws).unwrap();
+    write(&ws, "a.rs", "fn a() {}\n");
+    write(&ws, "b.rs", "fn b() {}\n");
+    let base = store.capture_revision(&cap, None, None, 0).unwrap();
+
+    // A rename: the tracked path disappeared and a new one appeared. Conflicts are reported as a
+    // result variant (the caller decides what to tell the user), not as an error - so the invariant
+    // to assert is "a conflict whose path is the renamed one", not "an Err".
+    std::fs::rename(ws.join("b.rs"), ws.join("c.rs")).unwrap();
+    match store
+        .restore_revision(&cap, &base.revision_id, Some(&base.revision_id), false)
+        .expect("a conflict is a result, not an error")
+    {
+        RestoreResult::Conflict {
+            conflicting_paths, ..
+        } => {
+            assert!(
+                conflicting_paths.iter().any(|c| c.path == "b.rs"),
+                "the vanished path must be reported: {conflicting_paths:?}"
+            );
+        }
+        other => panic!("expected a conflict for the renamed path, got {other:?}"),
+    }
+    // Nothing was written while the conflict stood.
+    assert!(ws.join("c.rs").exists(), "the rename must be left alone");
+    assert!(!ws.join("b.rs").exists());
+
+    // A mode change is content change too (the content id hashes the mode).
+    std::fs::rename(ws.join("c.rs"), ws.join("b.rs")).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(ws.join("a.rs"), std::fs::Permissions::from_mode(0o755)).unwrap();
+        match store
+            .restore_revision(&cap, &base.revision_id, Some(&base.revision_id), false)
+            .expect("a conflict is a result, not an error")
+        {
+            RestoreResult::Conflict {
+                conflicting_paths, ..
+            } => assert!(
+                conflicting_paths.iter().any(|c| c.path == "a.rs"),
+                "the chmod must be reported: {conflicting_paths:?}"
+            ),
+            other => panic!("expected a conflict for the chmod, got {other:?}"),
+        }
+        // With force it proceeds and restores the recorded mode.
+        match store
+            .restore_revision(&cap, &base.revision_id, Some(&base.revision_id), true)
+            .expect("force-restore is not an error case")
+        {
+            RestoreResult::Applied { .. } => {}
+            other => panic!("force-restore must apply, got {other:?}"),
+        }
+        let mode = std::fs::metadata(ws.join("a.rs"))
+            .unwrap()
+            .permissions()
+            .mode()
+            & 0o777;
+        assert_eq!(mode, 0o644, "restore must restore the recorded mode");
+    }
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// Multiple undo steps walk the WAL events, not the (rewritten) manifest parent chain.
+#[test]
+fn multiple_undo_steps_follow_the_session_events() {
+    let root = scratch("multi-undo");
+    let ws = root.join("ws");
+    let store = SnapshotStore::new(root.join("state/snapshots"));
+    let cap = WorkspaceCap::new(&ws).unwrap();
+    let mut journal = SessionJournal::create(root.join("state/sessions"), &ws).unwrap();
+
+    // A → B → A, recorded as three events.
+    let mut ids = Vec::new();
+    let mut parent: Option<RevisionId> = None;
+    for (turn, body) in [
+        (0usize, "fn v() { 0 }\n"),
+        (1, "fn v() { 1 }\n"),
+        (2, "fn v() { 0 }\n"),
+    ] {
+        write(&ws, "v.rs", body);
+        let revision = store
+            .capture_revision(&cap, parent.as_ref(), None, turn)
+            .unwrap();
+        journal
+            .record_revision_capture(
+                turn,
+                revision.revision_id.as_str(),
+                parent.as_ref().map(RevisionId::as_str),
+                revision.changed_paths.clone(),
+                1,
+            )
+            .unwrap();
+        ids.push(revision.revision_id.clone());
+        parent = Some(revision.revision_id);
+    }
+    assert_eq!(
+        ids[0], ids[2],
+        "the first and third events share a content id"
+    );
+
+    // Undo to turn 1 (the middle state), then to turn 0.
+    let target_b = journal
+        .revision_at_or_before_turn(1)
+        .expect("turn 1 target")
+        .revision_id;
+    assert_eq!(target_b, ids[1].as_str());
+    // `current_expected_rev` is the revision the caller believes the workspace is at (turn 2 here).
+    // Without it the guard compares live bytes against the *target*, which is the stricter reading and
+    // would refuse a legitimate undo - so pass the recorded state, as the CLI does.
+    let applied = store
+        .restore_revision(&cap, &ids[1], Some(&ids[2]), false)
+        .expect("restore to B");
+    assert!(matches!(applied, RestoreResult::Applied { .. }));
+    assert_eq!(
+        std::fs::read_to_string(ws.join("v.rs")).unwrap(),
+        "fn v() { 1 }\n"
+    );
+
+    let target_a = journal
+        .revision_at_or_before_turn(0)
+        .expect("turn 0 target")
+        .revision_id;
+    assert_eq!(target_a, ids[0].as_str());
+    let applied = store
+        .restore_revision(&cap, &ids[0], Some(&ids[1]), false)
+        .expect("restore to A");
+    assert!(matches!(applied, RestoreResult::Applied { .. }));
+    assert_eq!(
+        std::fs::read_to_string(ws.join("v.rs")).unwrap(),
+        "fn v() { 0 }\n"
+    );
+
+    // Restoring the same target twice is idempotent.
+    let again = store
+        .restore_revision(&cap, &ids[0], Some(&ids[0]), false)
+        .expect("restore to A again");
+    assert!(matches!(again, RestoreResult::Applied { .. }));
+    assert_eq!(
+        std::fs::read_to_string(ws.join("v.rs")).unwrap(),
+        "fn v() { 0 }\n"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t25_task_state.rs b/crates/kroma-core/tests/t25_task_state.rs
new file mode 100644
index 0000000..dbcb646
--- /dev/null
+++ b/crates/kroma-core/tests/t25_task_state.rs
@@ -0,0 +1,254 @@
+//! T25 (KR-31): typed task state survives compaction and resume; claims do not become facts by being
+//! written down.
+//!
+//! Stage 1 of the plan adds structure only — no generated summaries. These tests pin the four things
+//! that could go wrong with a "smart" summary layer:
+//!
+//! * an early user constraint being lost when the context is compacted;
+//! * a path that merely appears in tool output being presented as the cause;
+//! * compression being reported as free because only the compressor call was counted;
+//! * an unsupported claim being promoted to a fact.
+
+use kroma_core::budget::BudgetConfig;
+use kroma_core::context_projector::ContextProjector;
+use kroma_core::messages::{
+    AssistantTurn, FinishReason, ToolCall, ToolOutcome, ToolResultMessage, ToolResultMeta,
+    TranscriptItem, UserMessage,
+};
+use kroma_core::session::SessionJournal;
+use kroma_core::task_state::{
+    CompressionCost, EvidenceKind, EvidenceRef, FailureHypothesis, HypothesisStatus,
+    SemanticCompression, TaskState,
+};
+use kroma_core::types::ToolCallId;
+use std::sync::Arc;
+
+fn scratch(tag: &str) -> std::path::PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t25-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(root.join("ws")).unwrap();
+    std::fs::create_dir_all(root.join("state")).unwrap();
+    root
+}
+
+fn user(text: &str) -> TranscriptItem {
+    TranscriptItem::User(UserMessage {
+        content: text.into(),
+    })
+}
+
+fn tool_result(call_id: &str, tool: &str, content: &str) -> TranscriptItem {
+    TranscriptItem::ToolResult(ToolResultMessage {
+        call_id: ToolCallId::new(call_id),
+        tool_name: tool.to_string(),
+        outcome: ToolOutcome::Success,
+        content: Arc::from(content),
+        meta: ToolResultMeta {
+            relative_path: Some("src/a.rs".to_string()),
+            ..Default::default()
+        },
+    })
+}
+
+fn assistant_with(call_id: &str, tool: &str) -> TranscriptItem {
+    TranscriptItem::Assistant(AssistantTurn {
+        content: None,
+        reasoning_blocks: Vec::new(),
+        tool_calls: vec![ToolCall {
+            call_id: ToolCallId::new(call_id),
+            name: tool.to_string(),
+            raw_arguments: "{}".into(),
+        }],
+        finish_reason: FinishReason::ToolCalls,
+        usage: None,
+    })
+}
+
+/// The constraint the user stated first must survive heavy compaction and a resume.
+#[test]
+fn early_user_constraint_survives_compaction_and_resume() {
+    let root = scratch("constraint");
+    let ws = root.join("ws");
+    std::fs::write(ws.join("lib.rs"), "pub fn a() {}\n").unwrap();
+
+    let mut transcript = vec![user(
+        "Fix the failing test. Do not modify anything under tests/. Verify with cargo test -p kroma-core.",
+    )];
+    // Pad with enough tool output to force compaction of the early turns.
+    for i in 0..8 {
+        transcript.push(assistant_with(&format!("c{i}"), "read"));
+        transcript.push(tool_result(
+            &format!("c{i}"),
+            "read",
+            &format!("src/module{i}.rs line\n").repeat(400),
+        ));
+    }
+
+    let budget = BudgetConfig {
+        context_high_watermark_bytes: 32 * 1024,
+        context_low_watermark_bytes: 16 * 1024,
+        context_tail_window_bytes: 512,
+        context_min_tail_turns: 1,
+        max_total_tool_output_bytes: 8 * 1024 * 1024,
+        ..Default::default()
+    };
+    let mut projector = ContextProjector::new();
+    let projected = projector
+        .project(&mut transcript, &budget, 0, None, 40)
+        .unwrap();
+    assert!(
+        projected.compaction_event.is_some(),
+        "the fixture must actually compact, otherwise this test proves nothing"
+    );
+
+    // The state is derived from the *canonical* transcript, so compaction cannot remove it.
+    let state = TaskState::derive(&transcript);
+    assert_eq!(
+        state.constraints.len(),
+        1,
+        "expected exactly one constraint: {state:?}"
+    );
+    let constraint = &state.constraints[0];
+    assert!(
+        constraint
+            .statement
+            .contains("Do not modify anything under tests/"),
+        "the constraint must be kept verbatim: {}",
+        constraint.statement
+    );
+    assert_eq!(constraint.provenance.canonical_index, 0);
+    assert!(constraint.provenance.quote.contains("Do not modify"));
+    assert!(
+        state.constraint_lines()[0].contains("user:"),
+        "the compacted view must show the user's own words"
+    );
+
+    // Resume: the canonical transcript comes back from the WAL, so the state is identical.
+    let mut journal = SessionJournal::create(root.join("state/sessions"), &ws).unwrap();
+    for (turn, item) in transcript.iter().cloned().enumerate() {
+        journal.append_item(turn, item).unwrap();
+    }
+    let path = journal.path().to_path_buf();
+    drop(journal);
+    let reopened = SessionJournal::open(&path).expect("reopen");
+    let restored = TaskState::derive(&reopened.active_transcript());
+    assert_eq!(
+        restored.constraints, state.constraints,
+        "a resume must not lose or rewrite the user's constraint"
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A path that appears in tool output is a mention, not a cause.
+#[test]
+fn path_mentions_do_not_claim_causal_truth() {
+    let transcript = vec![
+        user("why does the build fail?"),
+        assistant_with("c1", "read"),
+        tool_result(
+            "c1",
+            "read",
+            "error in src/parser.rs: unexpected token\nsee also tests/parse_test.rs\n",
+        ),
+    ];
+    let state = TaskState::derive(&transcript);
+    assert!(
+        state
+            .path_mentions
+            .iter()
+            .any(|m| m.path == "src/parser.rs"),
+        "the path should be recorded: {:?}",
+        state.path_mentions
+    );
+    for mention in &state.path_mentions {
+        assert!(
+            mention.mention_only,
+            "a lexical path match must be tagged mention_only, not presented as a cause"
+        );
+    }
+    // Nothing in the derivation turns a mention into a hypothesis.
+    assert!(state.failure_hypotheses.is_empty());
+    assert!(state.supported_facts().is_empty());
+}
+
+/// An unsupported claim is never promoted to a fact, no matter how often it is repeated.
+#[test]
+fn unsupported_summary_claim_is_not_promoted_to_fact() {
+    let mut state = TaskState::default();
+    let mut hypothesis = FailureHypothesis::new("the failure is a race in the scheduler");
+    assert_eq!(hypothesis.status, HypothesisStatus::Unverified);
+    assert!(!hypothesis.is_fact(), "a fresh hypothesis is not a fact");
+
+    // Writing it down again does not help.
+    state.add_hypothesis(hypothesis.clone());
+    assert!(state.supported_facts().is_empty());
+
+    // "Support" without evidence keeps it unverified.
+    hypothesis.status = HypothesisStatus::Supported;
+    assert!(
+        !hypothesis.is_fact(),
+        "supported with no evidence is still not a fact"
+    );
+
+    // Only supported *with* an evidence reference becomes a fact.
+    hypothesis.support(EvidenceRef {
+        kind: EvidenceKind::ToolResult,
+        reference: "12".to_string(),
+    });
+    assert!(hypothesis.is_fact());
+
+    // Contradiction wins: a contradicted claim is not a fact even with evidence.
+    let mut contradicted = FailureHypothesis::new("the parser is slow");
+    contradicted.support(EvidenceRef {
+        kind: EvidenceKind::Verification,
+        reference: "cargo test".to_string(),
+    });
+    contradicted.contradict(EvidenceRef {
+        kind: EvidenceKind::ToolResult,
+        reference: "13".to_string(),
+    });
+    assert_eq!(contradicted.status, HypothesisStatus::Contradicted);
+    assert!(!contradicted.is_fact());
+}
+
+/// Compression cost includes the compressor *and* the rereads/cache rebuilds it causes.
+#[test]
+fn summary_cost_includes_compressor_and_rereads() {
+    // The default configuration has no compressor at all.
+    assert_eq!(
+        SemanticCompression::default(),
+        SemanticCompression::Disabled
+    );
+    let structural = CompressionCost::structural_only();
+    assert_eq!(structural.total_tokens(), 0);
+    assert!(structural.compressor_disabled);
+    structural.validate().expect("a structural step is valid");
+
+    // A compressor call that causes a reread and a cache rebuild is not free.
+    let real = CompressionCost {
+        compressor_input_tokens: 2_000,
+        compressor_output_tokens: 300,
+        reread_bytes: 64 * 1024,
+        cache_rebuilds: 1,
+        compressor_disabled: false,
+    };
+    assert_eq!(real.total_tokens(), 2_300);
+    let described = real.describe();
+    assert!(described.contains("2300 tokens"), "{described}");
+    assert!(described.contains("reread=65536"), "{described}");
+    assert!(described.contains("cache_rebuilds=1"), "{described}");
+
+    // A disabled compressor that still bills is a bug, not a cheaper variant.
+    let inconsistent = CompressionCost {
+        compressor_input_tokens: 10,
+        compressor_disabled: true,
+        ..CompressionCost::default()
+    };
+    assert!(inconsistent.validate().is_err());
+
+    // The default stays off until holdout evidence exists (see ADR-0002).
+    assert_ne!(
+        SemanticCompression::Disabled,
+        SemanticCompression::SchemaConstrained
+    );
+}
diff --git a/crates/kroma-core/tests/t26_localization.rs b/crates/kroma-core/tests/t26_localization.rs
new file mode 100644
index 0000000..29da257
--- /dev/null
+++ b/crates/kroma-core/tests/t26_localization.rs
@@ -0,0 +1,278 @@
+//! T26 (KR-31): does the index actually locate a file from a natural-language issue?
+//!
+//! The gap this measures: `query` seeded only from **file paths and symbol names**, so an issue that
+//! names no symbol ("where is the retry backoff computed?") could only succeed by accident — and a
+//! symbol-name grep is exactly the baseline the plan says must be beaten. Content tokens (identifiers
+//! plus comment words) are now part of the seeding, so this test scores both strategies on the same
+//! corpus:
+//!
+//! * `symbol baseline` — path substring or symbol-name substring, i.e. grep-by-name;
+//! * `graph` — the real `RepoGraph::query`, which also matches the file's content tokens and expands
+//!   over the file dependency graph.
+//!
+//! Everything here is offline and reproducible: no model, no network. The model-in-the-loop comparison
+//! (EXP-03) is a separate, budget-gated experiment.
+
+use kroma_core::repo_graph::{GraphLimits, RepoGraph, RepoGraphCache};
+use kroma_core::workspace::WorkspaceCap;
+use std::path::{Path, PathBuf};
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t26-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    root
+}
+
+/// A corpus where each issue can only be located by what the file *says*, not what it is called.
+fn corpus(root: &Path) {
+    let files = [
+        (
+            "src/module_one.py",
+            "# Exponential backoff with jitter is used when the upstream refuses a connection.\n\
+             def attempt(limit):\n    return limit\n",
+        ),
+        (
+            "src/module_two.py",
+            "# Reloading the config drops the last line when the file ends without a newline.\n\
+             def read_config(path):\n    return path\n",
+        ),
+        (
+            "src/module_three.py",
+            "# Evict the least recently used entries once the total size exceeds the cap.\n\
+             def evict(entries):\n    return entries\n",
+        ),
+        (
+            "src/module_four.py",
+            "# Refresh the oauth token before it expires, otherwise every request fails.\n\
+             def refresh(token):\n    return token\n",
+        ),
+        (
+            "src/module_five.py",
+            "# Truncate the generated report with an explicit marker once it grows past the cap.\n\
+             def render(rows):\n    return rows\n",
+        ),
+        (
+            "src/module_six.py",
+            "# Path normalisation shared by the loaders.\n\
+             def normalize_path(p):\n    return p\n",
+        ),
+        // Decoys: plausible names, unrelated prose.
+        (
+            "src/module_seven.py",
+            "# Terminal colour palette used by the status line.\n\
+             def paint(text):\n    return text\n",
+        ),
+        (
+            "src/module_eight.py",
+            "# Column widths for the summary table.\n\
+             def widths(rows):\n    return rows\n",
+        ),
+        (
+            "src/module_nine.py",
+            "# Monotonic timestamps for the metrics exporter.\n\
+             def now_ns():\n    return 0\n",
+        ),
+        (
+            "src/module_ten.py",
+            "# Structured log lines with a level and a target.\n\
+             def emit(level):\n    return level\n",
+        ),
+        (
+            "src/module_eleven.py",
+            "# Directory layout for the on-disk state area.\n\
+             def state_dir():\n    return '.'\n",
+        ),
+        (
+            "src/module_twelve.py",
+            "# Semantic version parsing for the updater.\n\
+             def parse(v):\n    return v\n",
+        ),
+    ];
+    for (path, contents) in files {
+        std::fs::write(root.join(path), contents).unwrap();
+    }
+}
+
+fn build(root: &Path, limits: GraphLimits) -> RepoGraph {
+    let cap = WorkspaceCap::new(root).unwrap();
+    let mut cache = RepoGraphCache::default();
+    RepoGraph::build_from_workspace_cached_with_limits(&cap, limits, &mut cache)
+}
+
+/// The strategy the plan says must be beaten: `grep`-by-symbol-name / path (no content).
+fn symbol_baseline_rank(graph: &RepoGraph, terms: &[String]) -> Vec<String> {
+    let lowered: Vec<String> = terms.iter().map(|t| t.to_ascii_lowercase()).collect();
+    let mut scored: Vec<(f64, String)> = graph
+        .files()
+        .iter()
+        .map(|path| {
+            let lower = path.to_ascii_lowercase();
+            let mut score = 0.0;
+            if lowered.iter().any(|t| lower.contains(t)) {
+                score += 1.0;
+            }
+            // Symbols are not exposed per file through the public API, so the baseline uses the
+            // rendered report's symbol names, which is exactly what a name-based grep would see.
+            let report = graph.query(&[], &[path.clone()], 1);
+            if let Some(ranked) = report.ranked.first() {
+                if ranked.symbols.iter().any(|s| {
+                    lowered
+                        .iter()
+                        .any(|t| s.name.to_ascii_lowercase().contains(t))
+                }) {
+                    score += 2.0;
+                }
+            }
+            (score, path.clone())
+        })
+        .collect();
+    scored.sort_by(|a, b| {
+        b.0.partial_cmp(&a.0)
+            .unwrap_or(std::cmp::Ordering::Equal)
+            .then_with(|| a.1.cmp(&b.1))
+    });
+    scored.into_iter().map(|(_, path)| path).collect()
+}
+
+fn query_terms(query: &str) -> Vec<String> {
+    query
+        .split(|c: char| !(c.is_alphanumeric() || c == '_'))
+        .map(str::trim)
+        .filter(|t| t.len() >= 3)
+        .map(|t| t.to_ascii_lowercase())
+        .collect()
+}
+
+fn graph_rank(graph: &RepoGraph, query: &str, k: usize) -> Vec<String> {
+    let terms = query_terms(query);
+    graph
+        .query(&terms, &[], k)
+        .ranked
+        .into_iter()
+        .map(|r| r.path)
+        .collect()
+}
+
+/// The five issues name no symbol; only the content can lead to the right file.
+const ISSUES: &[(&str, &str)] = &[
+    (
+        "retry backoff jitter upstream connection",
+        "src/module_one.py",
+    ),
+    ("config reload drops the last line", "src/module_two.py"),
+    (
+        "evict least recently used over the size cap",
+        "src/module_three.py",
+    ),
+    (
+        "refresh the oauth token before it expires",
+        "src/module_four.py",
+    ),
+    (
+        "truncate the generated report with a marker",
+        "src/module_five.py",
+    ),
+];
+
+/// Natural-language issues are located, and by a clear margin over symbol-name search.
+#[test]
+fn natural_language_issues_beat_symbol_name_search() {
+    let root = scratch("localize");
+    corpus(&root);
+    let graph = build(&root, GraphLimits::default());
+    assert!(!graph.truncated, "the fixture must fit the default budget");
+
+    let mut graph_top1 = 0usize;
+    let mut graph_top3 = 0usize;
+    let mut baseline_top1 = 0usize;
+    for (issue, expected) in ISSUES {
+        let ranked = graph_rank(&graph, issue, 3);
+        if ranked.first().map(String::as_str) == Some(*expected) {
+            graph_top1 += 1;
+        }
+        if ranked.iter().any(|p| p == expected) {
+            graph_top3 += 1;
+        }
+        let baseline = symbol_baseline_rank(&graph, &query_terms(issue));
+        if baseline.first().map(String::as_str) == Some(*expected) {
+            baseline_top1 += 1;
+        }
+    }
+
+    assert!(
+        graph_top1 >= 4,
+        "the graph must locate at least 4 of {} issues at rank 1, got {} (top-3: {})",
+        ISSUES.len(),
+        graph_top1,
+        graph_top3
+    );
+    assert!(
+        graph_top1 > baseline_top1,
+        "content tokens must beat symbol-name search: graph {}/{} vs baseline {}/{}",
+        graph_top1,
+        ISSUES.len(),
+        baseline_top1,
+        ISSUES.len()
+    );
+
+    // Symbol-name queries must not regress: the stronger signal still wins.
+    let by_symbol = [
+        ("compute normalize_path util", "src/module_six.py"),
+        ("version parse updater", "src/module_twelve.py"),
+    ];
+    for (query, expected) in by_symbol {
+        let ranked = graph_rank(&graph, query, 3);
+        assert!(
+            ranked.iter().any(|p| p == expected),
+            "a query naming real symbols must still find {expected}: {ranked:?}"
+        );
+    }
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// When the index is bounded away (truncated), the plain lexical fallback still works — which is what
+/// "failure can fall back to the existing index" has to mean in practice.
+#[test]
+fn truncated_index_falls_back_to_lexical_search() {
+    let root = scratch("fallback");
+    corpus(&root);
+    // Two files only: the answers are very likely outside the index.
+    let graph = build(
+        &root,
+        GraphLimits {
+            max_files: 2,
+            ..GraphLimits::default()
+        },
+    );
+    assert!(
+        graph.truncated,
+        "the fixture must be truncated for this test to mean anything"
+    );
+
+    for (issue, expected) in ISSUES {
+        let terms = query_terms(issue);
+        let ranked = graph_rank(&graph, issue, 3);
+        if ranked.iter().any(|p| p == expected) {
+            continue; // the tiny index happened to cover it; nothing to prove
+        }
+        // Fallback: a lexical scan over the workspace, which always sees every file.
+        let mut found = false;
+        for entry in std::fs::read_dir(root.join("src")).unwrap().flatten() {
+            let path = entry.path();
+            let text = std::fs::read_to_string(&path)
+                .unwrap_or_default()
+                .to_ascii_lowercase();
+            let matches = terms.iter().filter(|t| text.contains(*t)).count();
+            if matches >= 2 && format!("src/{}", entry.file_name().to_string_lossy()) == *expected {
+                found = true;
+            }
+        }
+        assert!(
+            found,
+            "with a truncated index the lexical fallback must still locate {expected}"
+        );
+    }
+
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/crates/kroma-core/tests/t27_control_policy.rs b/crates/kroma-core/tests/t27_control_policy.rs
new file mode 100644
index 0000000..e7b029e
--- /dev/null
+++ b/crates/kroma-core/tests/t27_control_policy.rs
@@ -0,0 +1,207 @@
+//! T27: the control policy's `Probe` action must be the *isolated* probe, and nothing else.
+//!
+//! The policy decides from counters only (no model confidence). This test closes the loop: when the
+//! policy says `Probe`, the only entry point used is
+//! `AttributionEngine::verify_candidate_in_isolated_worktree`, which materialises a throwaway worktree.
+//! The assertions are that the probe never sees the parent path, that the parent's bytes are untouched
+//! afterwards, and that the worktree is gone — plus the negative: an unauthorized policy decision never
+//! invokes the probe at all.
+
+use kroma_core::attribution::{
+    AttributionCandidate, AttributionEngine, MutatedFileSpan, MutationLedger,
+};
+use kroma_core::control_policy::{
+    decide, ControlAction, ControlObservation, ControlPolicyConfig, StopReason,
+};
+use kroma_core::revision::SnapshotStore;
+use kroma_core::workspace::WorkspaceCap;
+use std::cell::{Cell, RefCell};
+use std::path::PathBuf;
+
+fn scratch(tag: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("kroma-t27-{}-{}", tag, uuid::Uuid::new_v4()));
+    std::fs::create_dir_all(root.join("ws")).unwrap();
+    root
+}
+
+fn observation(failures: u32, authorized: bool, isolation: bool) -> ControlObservation {
+    ControlObservation {
+        consecutive_failures: failures,
+        identical_failure_streak: 1,
+        remaining_tokens: 200_000,
+        probes_used: 0,
+        probe_authorized: authorized,
+        isolation_available: isolation,
+    }
+}
+
+/// A `Probe` decision runs on a copy and leaves the live workspace byte-identical.
+#[test]
+fn a_probe_action_runs_only_on_an_isolated_copy() {
+    let root = scratch("probe");
+    let ws_dir = root.join("ws");
+    let ws = WorkspaceCap::new(&ws_dir).unwrap();
+    let store = SnapshotStore::new(root.join("snapshots"));
+
+    std::fs::write(ws_dir.join("lib.rs"), "pub fn compute() -> u32 { 1 }\n").unwrap();
+    let rev_before = store
+        .capture_revision(&ws, None, None, 0)
+        .unwrap()
+        .revision_id;
+    std::fs::write(ws_dir.join("lib.rs"), "pub fn compute_v2() -> u32 { 1 }\n").unwrap();
+    let rev_after = store
+        .capture_revision(&ws, Some(&rev_before), None, 1)
+        .unwrap()
+        .revision_id;
+
+    let mut ledger = MutationLedger::new();
+    ledger.record_mutation(
+        1,
+        "edit",
+        "call_rename",
+        Some("ev-0001-call_rename".to_string()),
+        Some(rev_before.clone()),
+        vec![MutatedFileSpan {
+            relative_path: "lib.rs".to_string(),
+            start_line: 1,
+            end_line: 1,
+            added_symbols: vec!["compute_v2".to_string()],
+            removed_symbols: vec!["compute".to_string()],
+            summary: "edit lib.rs lines 1-1".to_string(),
+        }],
+    );
+    ledger.backfill_revision_after(1, Some(rev_after.clone()));
+    let mut report = AttributionEngine::attribute_failure(
+        &ledger,
+        "error[E0425]: cannot find function `compute` in this scope\n  --> caller.rs:4:5\n",
+        "completion_gate",
+        3,
+    );
+
+    // 1. The policy authorizes a probe at three consecutive failures with an explicit cap.
+    let config = ControlPolicyConfig::with_probes(1);
+    let decision = decide(&config, &observation(3, true, true));
+    assert_eq!(decision.action, ControlAction::Probe, "{decision:?}");
+    assert!(decision.stop_reason.is_none());
+
+    // 2. The only probe entry point is the isolated one, so the decision can be executed as decided.
+    let parent_root = ws.root().to_path_buf();
+    let worktree_root = root.join("wt-t27");
+    let probed_root = RefCell::new(PathBuf::new());
+    let existed_during_probe = Cell::new(false);
+    let verification = AttributionEngine::verify_candidate_in_isolated_worktree(
+        &store,
+        &ws,
+        Some(&rev_after),
+        &mut report.candidates[0],
+        &rev_after,
+        worktree_root.clone(),
+        |probe_ws| {
+            *probed_root.borrow_mut() = probe_ws.root().to_path_buf();
+            existed_during_probe.set(worktree_root.exists());
+            true
+        },
+    )
+    .expect("isolated verification succeeds");
+
+    assert_ne!(
+        *probed_root.borrow(),
+        parent_root,
+        "the probe must run against a copy, not the live workspace"
+    );
+    assert!(
+        existed_during_probe.get(),
+        "the probe ran without a materialised worktree"
+    );
+    assert!(verification.failure_resolved_on_revert);
+    assert_eq!(
+        std::fs::read_to_string(ws_dir.join("lib.rs")).unwrap(),
+        "pub fn compute_v2() -> u32 { 1 }\n",
+        "the live workspace must be byte-identical after the probe"
+    );
+    assert!(!worktree_root.exists(), "the worktree must be cleaned up");
+
+    // 3. The executed probe is recorded as evidence, not just inferred.
+    assert!(
+        report.candidates[0]
+            .rationale
+            .contains("verified in isolated worktree"),
+        "the probe outcome must be recorded: {}",
+        report.candidates[0].rationale
+    );
+
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// An unauthorized decision never reaches the probe, and a missing isolation stops instead.
+#[test]
+fn unauthorized_or_unisolated_probes_are_never_executed() {
+    let config = ControlPolicyConfig::with_probes(2);
+
+    let unauthorized = decide(&config, &observation(5, false, true));
+    assert_eq!(unauthorized.action, ControlAction::Inspect);
+    assert!(unauthorized.stop_reason.is_none());
+
+    let unisolated = decide(&config, &observation(5, true, false));
+    assert_eq!(unisolated.action, ControlAction::Stop);
+    assert_eq!(
+        unisolated.stop_reason,
+        Some(StopReason::IsolationUnavailable)
+    );
+
+    // Probing disabled entirely (the production default): Inspect, never Probe.
+    let disabled = ControlPolicyConfig::default();
+    assert_eq!(
+        decide(&disabled, &observation(9, true, true)).action,
+        ControlAction::Inspect
+    );
+
+    // A budget that cannot cover the probe keeps it at Inspect rather than half-running it.
+    let poor = ControlObservation {
+        remaining_tokens: config.min_remaining_tokens_for_probe - 1,
+        ..observation(9, true, true)
+    };
+    assert_eq!(decide(&config, &poor).action, ControlAction::Inspect);
+}
+
+/// A candidate that never resolved still costs, and the summary says so.
+#[test]
+fn every_candidate_is_accounted_including_the_losers() {
+    use kroma_core::control_policy::{CandidateRecord, CandidateSummary};
+    let records = [
+        CandidateRecord {
+            candidate_id: "winner".to_string(),
+            tokens_spent: 4_000,
+            resolved: true,
+            diversity_score: 30,
+        },
+        CandidateRecord {
+            candidate_id: "loser-a".to_string(),
+            tokens_spent: 5_000,
+            resolved: false,
+            diversity_score: 70,
+        },
+    ];
+    let summary = CandidateSummary::from_records(&records);
+    assert_eq!(summary.total_tokens, 9_000);
+    assert_eq!(
+        summary.wasted_on_losers, 5_000,
+        "the losing candidate cost more than the winner; the total must show it"
+    );
+    assert_eq!(
+        summary.resolved_per_100k_tokens(),
+        Some(100_000.0 / 9_000.0 * 1.0)
+    );
+    let _ = AttributionCandidate {
+        mutation_id: String::new(),
+        turn: 0,
+        tool_name: String::new(),
+        relative_path: None,
+        line_range: None,
+        source_entry_id: None,
+        revision_before: None,
+        revision_after: None,
+        confidence: 0.0,
+        rationale: String::new(),
+    };
+}
diff --git a/crates/kroma-core/tests/t29_harness_evolution.rs b/crates/kroma-core/tests/t29_harness_evolution.rs
new file mode 100644
index 0000000..65aa8f2
--- /dev/null
+++ b/crates/kroma-core/tests/t29_harness_evolution.rs
@@ -0,0 +1,240 @@
+//! T29: a harness change is an experiment, and the experiment must be able to fail.
+//!
+//! The four gates this pins:
+//! * a round declares its hypothesis, editable components, cost cap and failure criteria *before* it runs;
+//! * a candidate cannot move the acceptance criteria (baseline, verifier, holdout, prices);
+//! * promotion needs an improvement that is not a single-task fix, an independent regression, spending
+//!   inside the declared cap, and a named owner — and even then this module only marks it for manual merge;
+//! * the log keeps the rounds that produced nothing, because that cost is part of the search.
+
+use kroma_core::harness_evolution::{
+    review_promotion, EditableComponent, EvolutionRound, FrozenCriteria, PromotionBlock,
+    RoundError, RoundLog, RoundOutcome,
+};
+
+fn frozen() -> FrozenCriteria {
+    FrozenCriteria {
+        baseline_revision: "rev-baseline".to_string(),
+        verifier_sha256: "a".repeat(64),
+        holdout: vec!["holdout-a".to_string(), "holdout-b".to_string()],
+        price_table: "prices-v1".to_string(),
+    }
+}
+
+fn round() -> EvolutionRound {
+    EvolutionRound {
+        id: "EXP-06-round-1".to_string(),
+        hypothesis: "shorter tool descriptions reduce turns on refactor tasks".to_string(),
+        editable: vec![
+            EditableComponent::ToolDescriptions,
+            EditableComponent::Prompt,
+        ],
+        cost_cap_tokens: 500_000,
+        expected_gain: "fewer turns, same pass rate".to_string(),
+        failure_criteria: vec![
+            "any holdout task regresses".to_string(),
+            "spend exceeds the cap".to_string(),
+        ],
+        frozen: frozen(),
+    }
+}
+
+fn outcome(improved: &[&str], regressed: &[&str]) -> RoundOutcome {
+    RoundOutcome {
+        round_id: "EXP-06-round-1".to_string(),
+        improved_tasks: improved.iter().map(|s| s.to_string()).collect(),
+        regressed_tasks: regressed.iter().map(|s| s.to_string()).collect(),
+        independent_regression_passed: true,
+        tokens_spent: 100_000,
+    }
+}
+
+#[test]
+fn a_round_must_declare_hypothesis_components_cap_and_failure_criteria() {
+    assert!(round().validate().is_ok());
+
+    let mut no_hypothesis = round();
+    no_hypothesis.hypothesis = "  ".to_string();
+    assert_eq!(no_hypothesis.validate(), Err(RoundError::MissingHypothesis));
+
+    let mut no_criteria = round();
+    no_criteria.failure_criteria.clear();
+    assert_eq!(
+        no_criteria.validate(),
+        Err(RoundError::MissingFailureCriteria)
+    );
+
+    let mut no_gain = round();
+    no_gain.expected_gain = String::new();
+    assert_eq!(no_gain.validate(), Err(RoundError::MissingExpectedGain));
+
+    let mut no_editable = round();
+    no_editable.editable.clear();
+    assert_eq!(
+        no_editable.validate(),
+        Err(RoundError::NoEditableComponents)
+    );
+
+    let mut no_cap = round();
+    no_cap.cost_cap_tokens = 0;
+    assert_eq!(no_cap.validate(), Err(RoundError::ZeroCostCap));
+}
+
+#[test]
+fn a_candidate_cannot_adjust_the_acceptance_criteria() {
+    let round = round();
+
+    // Unchanged: accepted.
+    round
+        .check_candidate(&[EditableComponent::ToolDescriptions], &frozen())
+        .expect("an unchanged criteria set is valid");
+
+    // A weaker verifier is the classic move: it makes every later number meaningless.
+    let mut weaker = frozen();
+    weaker.verifier_sha256 = "b".repeat(64);
+    match round.check_candidate(&[EditableComponent::ToolDescriptions], &weaker) {
+        Err(RoundError::AcceptanceCriteriaChanged(fields)) => {
+            assert_eq!(fields, vec!["verifier_sha256"])
+        }
+        other => panic!("expected an acceptance-criteria refusal, got {other:?}"),
+    }
+
+    // Dropping a holdout task is the same move in a different disguise.
+    let mut smaller_holdout = frozen();
+    smaller_holdout.holdout.pop();
+    match round.check_candidate(&[], &smaller_holdout) {
+        Err(RoundError::AcceptanceCriteriaChanged(fields)) => assert_eq!(fields, vec!["holdout"]),
+        other => panic!("expected a holdout refusal, got {other:?}"),
+    }
+
+    // Re-pricing changes the cost story.
+    let mut cheaper = frozen();
+    cheaper.price_table = "prices-discount".to_string();
+    match round.check_candidate(&[], &cheaper) {
+        Err(RoundError::AcceptanceCriteriaChanged(fields)) => {
+            assert_eq!(fields, vec!["price_table"])
+        }
+        other => panic!("expected a price-table refusal, got {other:?}"),
+    }
+
+    // A different baseline is a different comparison.
+    let mut other_baseline = frozen();
+    other_baseline.baseline_revision = "rev-other".to_string();
+    assert!(round.check_candidate(&[], &other_baseline).is_err());
+
+    // The frozen digest is stable and order-insensitive over the holdout list.
+    let mut reordered = frozen();
+    reordered.holdout.reverse();
+    assert_eq!(frozen().digest(), reordered.digest());
+    assert_ne!(frozen().digest(), weaker.digest());
+}
+
+#[test]
+fn a_candidate_cannot_edit_undeclared_or_forbidden_components() {
+    let round = round();
+    // Editing a component the round did not declare.
+    match round.check_candidate(&[EditableComponent::ProjectionThresholds], &frozen()) {
+        Err(RoundError::ComponentNotDeclared(name)) => {
+            assert!(name.contains("ProjectionThresholds"))
+        }
+        other => panic!("expected ComponentNotDeclared, got {other:?}"),
+    }
+
+    // The judge and the security chain are never editable by any round.
+    for forbidden in [
+        "crates/kroma-core/src/bench.rs",
+        "crates/kroma-core/src/completion_gate.rs",
+        "crates/kroma-core/src/ahe.rs",
+        "crates/kroma-core/src/experiment.rs",
+        "crates/kroma-core/src/tool/policy.rs",
+        "crates/kroma-core/src/sandbox.rs",
+        "crates/kroma-core/src/usage_cost.rs",
+        "bin/kroma.js",
+        "crates/kroma-core/tests/gate5_controlled_subagents.rs",
+    ] {
+        assert!(
+            EvolutionRound::is_forbidden_component(forbidden),
+            "{forbidden} must be forbidden for every round"
+        );
+    }
+    assert!(!EvolutionRound::is_forbidden_component(
+        "crates/kroma-core/src/prompt.rs"
+    ));
+}
+
+#[test]
+fn promotion_needs_independent_regression_trustworthy_gain_and_owner() {
+    let round = round();
+
+    // The full pass: two tasks improved, nothing regressed, regression run, inside the cap, owner named.
+    let good = review_promotion(&round, &outcome(&["task-a", "task-b"], &[]), Some("owner"));
+    assert!(good.promoted, "blocks: {:?}", good.blocks_as_strings());
+    assert!(
+        good.requires_manual_merge,
+        "a promoted round still needs a human merge; this module never merges"
+    );
+
+    // No improvement.
+    let none = review_promotion(&round, &outcome(&[], &[]), Some("owner"));
+    assert!(!none.promoted);
+    assert_eq!(none.blocks_as_strings(), vec!["no_improvement"]);
+
+    // A gain from a single task is a task fix, not a harness improvement.
+    let single = review_promotion(&round, &outcome(&["task-a"], &[]), Some("owner"));
+    assert!(!single.promoted);
+    assert_eq!(single.blocks_as_strings(), vec!["single_task_gain"]);
+
+    // Any regression blocks, whatever else is true.
+    let regressed = review_promotion(
+        &round,
+        &outcome(&["task-a", "task-b"], &["task-c"]),
+        Some("owner"),
+    );
+    assert!(!regressed.promoted);
+    assert!(regressed.blocks.contains(&PromotionBlock::Regression));
+
+    // No independent regression.
+    let mut no_regression_run = outcome(&["task-a", "task-b"], &[]);
+    no_regression_run.independent_regression_passed = false;
+    let unverified = review_promotion(&round, &no_regression_run, Some("owner"));
+    assert_eq!(
+        unverified.blocks_as_strings(),
+        vec!["independent_regression_not_run"]
+    );
+
+    // Over the declared cap: the round did not run inside its own limits.
+    let mut expensive = outcome(&["task-a", "task-b"], &[]);
+    expensive.tokens_spent = round.cost_cap_tokens + 1;
+    assert_eq!(
+        review_promotion(&round, &expensive, Some("owner")).blocks_as_strings(),
+        vec!["cost_cap_exceeded"]
+    );
+
+    // No owner: promotion is a human decision.
+    assert_eq!(
+        review_promotion(&round, &outcome(&["task-a", "task-b"], &[]), None).blocks_as_strings(),
+        vec!["owner_approval_missing"]
+    );
+    assert_eq!(
+        review_promotion(&round, &outcome(&["task-a", "task-b"], &[]), Some("  "))
+            .blocks_as_strings(),
+        vec!["owner_approval_missing"]
+    );
+}
+
+#[test]
+fn the_round_log_keeps_the_rounds_that_produced_nothing() {
+    let mut log = RoundLog::default();
+    log.record(outcome(&["task-a", "task-b"], &[])); // win
+    log.record(outcome(&[], &[])); // nothing
+    log.record(outcome(&["task-c"], &["task-d"])); // regression
+
+    assert_eq!(log.rounds.len(), 3);
+    assert_eq!(log.total_tokens(), 300_000);
+    let negative = log.negative_rounds();
+    assert_eq!(negative.len(), 2, "no-improvement and regression both stay");
+    assert!(negative.iter().any(|r| r.improved_tasks.is_empty()));
+    assert!(negative.iter().any(|r| !r.regressed_tasks.is_empty()));
+    // The net improvement of the regressing round is visible, not hidden.
+    assert_eq!(log.rounds[2].net_improvements(), 0);
+}
