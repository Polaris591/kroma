diff --git a/scripts/generate-sbom.js b/scripts/generate-sbom.js
new file mode 100644
index 0000000..ff4f1c0
--- /dev/null
+++ b/scripts/generate-sbom.js
@@ -0,0 +1,124 @@
+#!/usr/bin/env node
+"use strict";
+
+/**
+ * T22 (KR-28): SBOM / dependency manifest for a release.
+ *
+ * Generated from `Cargo.lock` rather than `cargo metadata`, on purpose: the lockfile *is* the
+ * resolved dependency graph (name, version, source, checksum), it is already in the repository, and
+ * it needs no registry access — so the SBOM can be recomputed from a checkout with no network and
+ * compared byte for byte. `cargo metadata` would additionally need every crate downloaded.
+ *
+ * Determinism: components are sorted by `(name, version)`, no timestamps, no absolute paths. The
+ * output carries the sha256 of the `Cargo.lock` it was generated from and the sha256 of the SBOM
+ * itself, so a release record can bind the three together.
+ *
+ * Usage: node scripts/generate-sbom.js [--out dist/sbom.json]
+ */
+
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const ROOT = path.join(__dirname, "..");
+
+/** Minimal `[[package]]` reader: Cargo.lock is a TOML subset with flat string keys. */
+function parseLockfile(text) {
+  const packages = [];
+  let current = null;
+  for (const rawLine of text.split("\n")) {
+    const line = rawLine.trim();
+    if (line === "[[package]]") {
+      if (current) packages.push(current);
+      current = {};
+      continue;
+    }
+    if (!current) continue;
+    const match = /^([A-Za-z0-9_]+)\s*=\s*"([^"]*)"$/.exec(line);
+    if (match) {
+      current[match[1]] = match[2];
+      continue;
+    }
+    if (line.startsWith("[") && line.endsWith("]")) {
+      // A nested table (e.g. [package.dependencies]) ends the flat fields we care about.
+      continue;
+    }
+  }
+  if (current) packages.push(current);
+  return packages;
+}
+
+function sha256(text) {
+  return crypto.createHash("sha256").update(text).digest("hex");
+}
+
+function buildSbom({ lockText, packageJsonText, toolchain }) {
+  const packages = parseLockfile(lockText);
+  if (packages.length === 0) {
+    throw new Error("Cargo.lock contains no [[package]] entries");
+  }
+  const components = packages
+    .map((pkg) => {
+      if (!pkg.name || !pkg.version) {
+        throw new Error(`a Cargo.lock package has no name or version: ${JSON.stringify(pkg)}`);
+      }
+      const component = {
+        name: pkg.name,
+        version: pkg.version,
+        kind: pkg.source ? "registry-or-git" : "workspace"
+      };
+      if (pkg.source) component.source = pkg.source;
+      // Registry crates must carry a checksum: without it the component is not pinned.
+      if (pkg.checksum) component.checksum = pkg.checksum;
+      else if (pkg.source && /^registry\+/.test(pkg.source)) {
+        throw new Error(`${pkg.name} ${pkg.version} is a registry crate with no checksum`);
+      }
+      return component;
+    })
+    .sort((a, b) => (a.name === b.name ? a.version.localeCompare(b.version) : a.name.localeCompare(b.name)));
+
+  const packageJson = JSON.parse(packageJsonText);
+  const sbom = {
+    schemaVersion: 1,
+    // The product identity, not the toolchain identity: they are separate facts.
+    product: { name: packageJson.name, version: packageJson.version },
+    toolchain: { channel: toolchain },
+    lockfileSha256: sha256(lockText),
+    componentCount: components.length,
+    components
+  };
+  sbom.sbomSha256 = sha256(JSON.stringify(sbom));
+  return sbom;
+}
+
+function main(argv) {
+  const outIndex = argv.indexOf("--out");
+  const outPath = outIndex > 0 ? argv[outIndex + 1] : path.join(ROOT, "dist", "sbom.json");
+  const lockText = fs.readFileSync(path.join(ROOT, "Cargo.lock"), "utf8");
+  const packageJsonText = fs.readFileSync(path.join(ROOT, "package.json"), "utf8");
+  const toolchainMatch = /channel\s*=\s*"([^"]+)"/.exec(
+    fs.readFileSync(path.join(ROOT, "rust-toolchain.toml"), "utf8")
+  );
+  const sbom = buildSbom({
+    lockText,
+    packageJsonText,
+    toolchain: toolchainMatch ? toolchainMatch[1] : "unknown"
+  });
+  fs.mkdirSync(path.dirname(outPath), { recursive: true });
+  fs.writeFileSync(outPath, `${JSON.stringify(sbom, null, 2)}\n`);
+  console.log(
+    `sbom: ${sbom.componentCount} components, lockfile ${sbom.lockfileSha256.slice(0, 16)}, sbom ${sbom.sbomSha256.slice(0, 16)} -> ${outPath}`
+  );
+  return 0;
+}
+
+module.exports = { parseLockfile, buildSbom, sha256 };
+
+if (require.main === module) {
+  try {
+    process.exitCode = main(process.argv);
+  } catch (err) {
+    console.error(`error: ${err.message}`);
+    process.exitCode = 1;
+  }
+}
diff --git a/scripts/release-gate.js b/scripts/release-gate.js
new file mode 100644
index 0000000..a94f923
--- /dev/null
+++ b/scripts/release-gate.js
@@ -0,0 +1,260 @@
+#!/usr/bin/env node
+"use strict";
+
+/**
+ * T22 (KR-28, KR-29): release/supply-chain gates.
+ *
+ * The rule this encodes: a release may only be published from source that already passed the same
+ * gates, with every third-party input verified before use, and with a hash manifest that can be
+ * recomputed. Every function here is pure so the regressions can be driven from a test without a
+ * release run; `main()` exposes the same checks as a CLI for CI.
+ *
+ * Deliberately NOT encoded here: a real signature. That needs the owner's key (T21, BLOCKED). These
+ * gates run *before* signing and cannot substitute for it.
+ */
+
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+
+class ReleaseGateError extends Error {}
+
+function fail(message) {
+  throw new ReleaseGateError(message);
+}
+
+/**
+ * A downloaded source archive must be verified against a pinned digest **before** it is extracted.
+ *
+ * `expected` is the digest recorded in the repository; `actual` is what arrived. An empty or
+ * missing expected digest is a configuration error, not a pass: "no pin" is how a tampered archive
+ * gets extracted.
+ */
+function verifyPinnedArchive({ name, expected, actual }) {
+  if (typeof expected !== "string" || !/^[0-9a-f]{64}$/.test(expected)) {
+    fail(
+      `${name}: no pinned sha256 in the repository; a release may not extract an unverified archive`
+    );
+  }
+  if (typeof actual !== "string" || !/^[0-9a-f]{64}$/.test(actual)) {
+    fail(`${name}: the downloaded archive has no computable digest`);
+  }
+  if (expected !== actual) {
+    fail(`${name}: archive digest ${actual} does not match the pinned ${expected}`);
+  }
+  return true;
+}
+
+/** sha256 of a file, streaming (archives are not buffered). */
+function sha256File(file) {
+  const hash = crypto.createHash("sha256");
+  const fd = fs.openSync(file, "r");
+  try {
+    const buffer = Buffer.allocUnsafe(1024 * 1024);
+    let read = 0;
+    while ((read = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) {
+      hash.update(buffer.subarray(0, read));
+    }
+  } finally {
+    fs.closeSync(fd);
+  }
+  return hash.digest("hex");
+}
+
+/** The artifacts must come from the commit the gates ran on. */
+function assertSameCommit({ testedCommit, artifactCommit }) {
+  const isSha = (value) => typeof value === "string" && /^[0-9a-f]{40}$/.test(value);
+  if (!isSha(testedCommit)) {
+    fail(`the tested commit is not a full 40-character sha: ${testedCommit}`);
+  }
+  if (!isSha(artifactCommit)) {
+    fail(`the artifact commit is not a full 40-character sha: ${artifactCommit}`);
+  }
+  if (testedCommit !== artifactCommit) {
+    fail(
+      `the artifacts were built from ${artifactCommit} but the gates ran on ${testedCommit}; a release must use one commit`
+    );
+  }
+  return true;
+}
+
+/** A quality gate failure blocks pack and sign. */
+function assertQualityGates({ fmt, clippy, test, crossBuild }) {
+  const gates = { fmt, clippy, test, crossBuild };
+  const failed = Object.keys(gates).filter((key) => gates[key] !== "pass");
+  if (failed.length > 0) {
+    fail(`packing and signing are blocked: ${failed.join(", ")} did not pass`);
+  }
+  return true;
+}
+
+/** Every declared platform needs an artifact; a missing one blocks publishing that release. */
+function assertAllPlatformsPresent({ required, produced }) {
+  const missing = required.filter((platform) => !produced.includes(platform));
+  if (missing.length > 0) {
+    fail(
+      `missing platform artifact(s): ${missing.join(", ")}; a release may not publish without them ` +
+        `(drop the platform explicitly instead of shipping a stub)`
+    );
+  }
+  const unexpected = produced.filter((platform) => !required.includes(platform));
+  if (unexpected.length > 0) {
+    fail(`unexpected platform artifact(s): ${unexpected.join(", ")}`);
+  }
+  return true;
+}
+
+/**
+ * A changed dependency lock is a review event.
+ *
+ * `pinned` is the digest recorded in the repository for `Cargo.lock`; a mismatch means the
+ * dependency graph changed and the cache/evidence from the previous lock no longer describes this
+ * build.
+ */
+function assertDependencyLockUnchanged({ pinned, actual }) {
+  if (typeof pinned !== "string" || !/^[0-9a-f]{64}$/.test(pinned)) {
+    fail("Cargo.lock has no pinned digest; a dependency change would pass unnoticed");
+  }
+  if (pinned !== actual) {
+    fail(
+      `Cargo.lock changed (${pinned} -> ${actual}); this needs review and a re-run of every gate`
+    );
+  }
+  return true;
+}
+
+/**
+ * A rebuild identity: the sorted `name:sha256:length` triples, hashed. Two builds of the same source
+ * with the same toolchain produce the same value; anything else means the build is not reproducible.
+ */
+function rebuildIdentity(artifacts) {
+  const lines = artifacts
+    .map((artifact) => {
+      if (!artifact || typeof artifact.name !== "string" || artifact.name.length === 0) {
+        fail("an artifact has no name");
+      }
+      if (!/^[0-9a-f]{64}$/.test(artifact.sha256 || "")) {
+        fail(`artifact ${artifact.name} has no sha256`);
+      }
+      if (!Number.isInteger(artifact.length) || artifact.length <= 0) {
+        fail(`artifact ${artifact.name} has no length`);
+      }
+      return `${artifact.name}:${artifact.sha256}:${artifact.length}`;
+    })
+    .sort();
+  return crypto.createHash("sha256").update(lines.join("\n")).digest("hex");
+}
+
+/**
+ * The signed manifest and the artifacts must agree.
+ *
+ * This is the check that catches "we signed a manifest for a tarball we then rebuilt".
+ */
+function assertManifestMatchesArtifacts({ manifest, artifacts }) {
+  const byName = new Map(artifacts.map((artifact) => [artifact.name, artifact]));
+  const entries = Array.isArray(manifest.artifacts) ? manifest.artifacts : [];
+  if (entries.length === 0) {
+    fail("the manifest lists no artifacts");
+  }
+  for (const entry of entries) {
+    const artifact = byName.get(entry.name);
+    if (!artifact) {
+      fail(`the manifest names ${entry.name}, which was not produced`);
+    }
+    if (artifact.sha256 !== entry.sha256) {
+      fail(`${entry.name}: manifest sha256 ${entry.sha256} != artifact ${artifact.sha256}`);
+    }
+    if (artifact.length !== entry.length) {
+      fail(`${entry.name}: manifest length ${entry.length} != artifact ${artifact.length}`);
+    }
+    if (entry.version !== manifest.version) {
+      fail(`${entry.name}: artifact version ${entry.version} != manifest version ${manifest.version}`);
+    }
+  }
+  return true;
+}
+
+/**
+ * Third-party actions must be pinned to a commit, not a mutable tag.
+ *
+ * A `@v4` reference is a moving target: the code that runs in a release job can change without any
+ * commit in this repository.
+ */
+function assertActionsPinned(workflowText) {
+  const usesLines = workflowText
+    .split("\n")
+    .map((line) => line.trim())
+    .filter((line) => line.startsWith("- uses:") || line.startsWith("uses:"));
+  const unpinned = [];
+  for (const line of usesLines) {
+    const reference = line.replace(/^(-\s*)?uses:\s*/, "").trim();
+    if (reference.startsWith("./") || reference.startsWith(".github/")) continue;
+    const at = reference.lastIndexOf("@");
+    if (at < 0) {
+      unpinned.push(reference);
+      continue;
+    }
+    const pin = reference.slice(at + 1);
+    if (!/^[0-9a-f]{40}$/.test(pin)) {
+      unpinned.push(reference);
+    }
+  }
+  if (unpinned.length > 0) {
+    fail(`actions must be pinned to a 40-character commit sha: ${unpinned.join(", ")}`);
+  }
+  return usesLines.length;
+}
+
+// ---------------------------------------------------------------------------------------------
+// CLI: run the checks CI can run from a checkout.
+// ---------------------------------------------------------------------------------------------
+
+function main(argv) {
+  const command = argv[2];
+  const root = path.join(__dirname, "..");
+  try {
+    if (command === "actions") {
+      const files = [".github/workflows/ci.yml", ".github/workflows/release.yml"];
+      for (const file of files) {
+        const text = fs.readFileSync(path.join(root, file), "utf8");
+        const count = assertActionsPinned(text);
+        console.log(`ok  ${file}: ${count} uses: entries are commit-pinned`);
+      }
+      return 0;
+    }
+    if (command === "lock") {
+      const pinnedFile = path.join(root, "docs/release/Cargo.lock.sha256");
+      if (!fs.existsSync(pinnedFile)) {
+        console.error(`no pinned Cargo.lock digest at ${pinnedFile}`);
+        return 2;
+      }
+      const pinned = fs.readFileSync(pinnedFile, "utf8").trim().split(/\s+/)[0];
+      const actual = sha256File(path.join(root, "Cargo.lock"));
+      assertDependencyLockUnchanged({ pinned, actual });
+      console.log(`ok  Cargo.lock matches the pinned digest ${pinned}`);
+      return 0;
+    }
+    console.error("usage: release-gate.js <actions|lock>");
+    return 2;
+  } catch (err) {
+    console.error(`error: ${err.message}`);
+    return 1;
+  }
+}
+
+module.exports = {
+  ReleaseGateError,
+  verifyPinnedArchive,
+  sha256File,
+  assertSameCommit,
+  assertQualityGates,
+  assertAllPlatformsPresent,
+  assertDependencyLockUnchanged,
+  rebuildIdentity,
+  assertManifestMatchesArtifacts,
+  assertActionsPinned
+};
+
+if (require.main === module) {
+  process.exitCode = main(process.argv);
+}
diff --git a/scripts/test-release-pipeline.js b/scripts/test-release-pipeline.js
new file mode 100644
index 0000000..9008d0f
--- /dev/null
+++ b/scripts/test-release-pipeline.js
@@ -0,0 +1,322 @@
+#!/usr/bin/env node
+"use strict";
+
+/**
+ * T22 (KR-28, KR-29) — release/supply-chain gates.
+ *
+ * Each check pins one way a release can claim more than it verified: an archive extracted before its
+ * digest was checked, artifacts from a different commit than the gates ran on, a platform quietly
+ * missing, a pack produced after a failing gate, a changed dependency graph, a manifest that no
+ * longer matches the bytes, or an SBOM that cannot be recomputed.
+ *
+ * Run: node scripts/test-release-pipeline.js
+ */
+
+const assert = require("node:assert");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const {
+  verifyPinnedArchive,
+  sha256File,
+  assertSameCommit,
+  assertQualityGates,
+  assertAllPlatformsPresent,
+  assertDependencyLockUnchanged,
+  rebuildIdentity,
+  assertManifestMatchesArtifacts,
+  assertActionsPinned,
+  ReleaseGateError
+} = require(path.join(__dirname, "release-gate.js"));
+const { buildSbom, parseLockfile } = require(path.join(__dirname, "generate-sbom.js"));
+
+const ROOT = path.join(__dirname, "..");
+let checks = 0;
+
+function ok(name, fn) {
+  try {
+    fn();
+    checks += 1;
+    console.log(`  ok  ${name}`);
+  } catch (err) {
+    console.error(`  FAIL ${name}\n       ${err && err.message}`);
+    process.exitCode = 1;
+  }
+}
+
+function refuses(fn, needle) {
+  try {
+    fn();
+  } catch (err) {
+    assert.ok(err instanceof ReleaseGateError, `expected a ReleaseGateError, got ${err}`);
+    assert.ok(
+      String(err.message).includes(needle),
+      `expected ${JSON.stringify(needle)} in ${JSON.stringify(err.message)}`
+    );
+    return;
+  }
+  assert.fail(`expected a refusal containing ${JSON.stringify(needle)}`);
+}
+
+const sha = (text) => crypto.createHash("sha256").update(text).digest("hex");
+
+console.log("tampered_source_archive_fails_before_extract");
+ok("a matching digest passes", () => {
+  const digest = sha("openssl-3.5.7.tar.gz bytes");
+  assert.strictEqual(
+    verifyPinnedArchive({ name: "openssl-3.5.7.tar.gz", expected: digest, actual: digest }),
+    true
+  );
+});
+
+ok("a tampered archive is refused before extraction", () => {
+  const pinned = sha("openssl-3.5.7.tar.gz bytes");
+  const tampered = sha("openssl-3.5.7.tar.gz bytes with a backdoor");
+  refuses(
+    () => verifyPinnedArchive({ name: "openssl", expected: pinned, actual: tampered }),
+    "does not match the pinned"
+  );
+});
+
+ok("no pin in the repository is a configuration error, not a pass", () => {
+  refuses(
+    () => verifyPinnedArchive({ name: "openssl", expected: "", actual: sha("x") }),
+    "no pinned sha256"
+  );
+  refuses(
+    () => verifyPinnedArchive({ name: "openssl", expected: undefined, actual: sha("x") }),
+    "no pinned sha256"
+  );
+});
+
+ok("the workflow verifies the digest before extracting", () => {
+  const workflow = fs.readFileSync(path.join(ROOT, ".github/workflows/release.yml"), "utf8");
+  const verifyAt = workflow.indexOf("sha256sum -c -");
+  const extractAt = workflow.indexOf("tar -xzf openssl.tar.gz");
+  assert.ok(verifyAt > 0, "the workflow must verify a digest");
+  assert.ok(extractAt > 0, "the workflow must extract the archive");
+  assert.ok(verifyAt < extractAt, "the digest must be verified before extraction");
+  assert.ok(
+    workflow.includes("if [ -z \"${OPENSSL_SHA256}\" ]"),
+    "an unset digest must fail the step instead of skipping verification"
+  );
+});
+
+console.log("release_uses_same_commit_for_tests_and_artifacts");
+ok("the same commit passes", () => {
+  const commit = "a".repeat(40);
+  assert.strictEqual(assertSameCommit({ testedCommit: commit, artifactCommit: commit }), true);
+});
+
+ok("artifacts from another commit are refused", () => {
+  refuses(
+    () => assertSameCommit({ testedCommit: "a".repeat(40), artifactCommit: "b".repeat(40) }),
+    "a release must use one commit"
+  );
+  // A short sha is not evidence of identity.
+  refuses(
+    () => assertSameCommit({ testedCommit: "abc1234", artifactCommit: "abc1234" }),
+    "not a full 40-character sha"
+  );
+});
+
+console.log("release_quality_failure_blocks_pack_and_sign");
+ok("all gates passing allows packing", () => {
+  assert.strictEqual(
+    assertQualityGates({ fmt: "pass", clippy: "pass", test: "pass", crossBuild: "pass" }),
+    true
+  );
+});
+
+ok("any failing gate blocks pack and sign", () => {
+  for (const failing of ["fmt", "clippy", "test", "crossBuild"]) {
+    const gates = { fmt: "pass", clippy: "pass", test: "pass", crossBuild: "pass" };
+    gates[failing] = "fail";
+    refuses(() => assertQualityGates(gates), "packing and signing are blocked");
+  }
+  // A skipped gate is not a pass either.
+  refuses(
+    () => assertQualityGates({ fmt: "pass", clippy: "pass", test: "skipped", crossBuild: "pass" }),
+    "packing and signing are blocked"
+  );
+});
+
+console.log("missing_platform_artifact_cannot_publish");
+ok("every declared platform present allows publishing", () => {
+  const required = ["linux-x64", "linux-arm64", "win32-x64"];
+  assert.strictEqual(assertAllPlatformsPresent({ required, produced: required }), true);
+});
+
+ok("a missing platform blocks the release", () => {
+  refuses(
+    () =>
+      assertAllPlatformsPresent({
+        required: ["linux-x64", "darwin-arm64"],
+        produced: ["linux-x64"]
+      }),
+    "missing platform artifact"
+  );
+  // An artifact nobody declared is also refused: it would ship without a gate.
+  refuses(
+    () => assertAllPlatformsPresent({ required: ["linux-x64"], produced: ["linux-x64", "freebsd"] }),
+    "unexpected platform artifact"
+  );
+});
+
+console.log("cargo_lock_change_requires_review");
+ok("the checked-in lock matches its pinned digest", () => {
+  const pinnedFile = path.join(ROOT, "docs/release/Cargo.lock.sha256");
+  assert.ok(fs.existsSync(pinnedFile), "the lock digest must be pinned in the repository");
+  const pinned = fs.readFileSync(pinnedFile, "utf8").trim().split(/\s+/)[0];
+  const actual = sha256File(path.join(ROOT, "Cargo.lock"));
+  assert.strictEqual(assertDependencyLockUnchanged({ pinned, actual }), true);
+});
+
+ok("a changed lock is refused (and so is a missing pin)", () => {
+  refuses(
+    () => assertDependencyLockUnchanged({ pinned: "a".repeat(64), actual: "b".repeat(64) }),
+    "Cargo.lock changed"
+  );
+  refuses(
+    () => assertDependencyLockUnchanged({ pinned: "", actual: "b".repeat(64) }),
+    "no pinned digest"
+  );
+});
+
+console.log("rebuild_identity_is_comparable");
+ok("the same artifacts produce the same identity regardless of order", () => {
+  const artifacts = [
+    { name: "kroma-linux-x64", sha256: "a".repeat(64), length: 10 },
+    { name: "kroma-win32-x64", sha256: "b".repeat(64), length: 20 }
+  ];
+  const forward = rebuildIdentity(artifacts);
+  const backward = rebuildIdentity([...artifacts].reverse());
+  assert.strictEqual(forward, backward);
+  assert.strictEqual(forward.length, 64);
+});
+
+ok("any byte or length change changes the identity", () => {
+  const base = [{ name: "kroma", sha256: "a".repeat(64), length: 10 }];
+  const identity = rebuildIdentity(base);
+  assert.notStrictEqual(
+    rebuildIdentity([{ name: "kroma", sha256: "c".repeat(64), length: 10 }]),
+    identity
+  );
+  assert.notStrictEqual(rebuildIdentity([{ name: "kroma", sha256: "a".repeat(64), length: 11 }]), identity);
+});
+
+ok("an artifact without a digest cannot contribute to an identity", () => {
+  refuses(() => rebuildIdentity([{ name: "kroma", sha256: "", length: 10 }]), "has no sha256");
+  refuses(() => rebuildIdentity([{ name: "", sha256: "a".repeat(64), length: 10 }]), "has no name");
+});
+
+console.log("release artifacts and the signed manifest agree");
+ok("matching manifest passes", () => {
+  const artifacts = [{ name: "kroma-cli.tgz", sha256: "a".repeat(64), length: 100 }];
+  assert.strictEqual(
+    assertManifestMatchesArtifacts({
+      manifest: { version: "1.5.0", artifacts: [{ name: "kroma-cli.tgz", sha256: "a".repeat(64), length: 100, version: "1.5.0" }] },
+      artifacts
+    }),
+    true
+  );
+});
+
+ok("a manifest for different bytes is refused", () => {
+  const artifacts = [{ name: "kroma-cli.tgz", sha256: "a".repeat(64), length: 100 }];
+  refuses(
+    () =>
+      assertManifestMatchesArtifacts({
+        manifest: { version: "1.5.0", artifacts: [{ name: "kroma-cli.tgz", sha256: "b".repeat(64), length: 100, version: "1.5.0" }] },
+        artifacts
+      }),
+    "manifest sha256"
+  );
+  refuses(
+    () =>
+      assertManifestMatchesArtifacts({
+        manifest: { version: "1.5.0", artifacts: [{ name: "kroma-cli.tgz", sha256: "a".repeat(64), length: 100, version: "1.4.0" }] },
+        artifacts
+      }),
+    "artifact version"
+  );
+  refuses(
+    () => assertManifestMatchesArtifacts({ manifest: { version: "1.5.0", artifacts: [] }, artifacts }),
+    "lists no artifacts"
+  );
+});
+
+console.log("SBOM is recomputable");
+ok("the SBOM is deterministic and every component is pinned", () => {
+  const lockText = fs.readFileSync(path.join(ROOT, "Cargo.lock"), "utf8");
+  const packageJsonText = fs.readFileSync(path.join(ROOT, "package.json"), "utf8");
+  const first = buildSbom({ lockText, packageJsonText, toolchain: "1.85.1" });
+  const second = buildSbom({ lockText, packageJsonText, toolchain: "1.85.1" });
+  assert.strictEqual(JSON.stringify(first), JSON.stringify(second), "the SBOM must be reproducible");
+  assert.ok(first.componentCount > 50, `expected a real dependency set, got ${first.componentCount}`);
+  assert.strictEqual(first.product.version, JSON.parse(packageJsonText).version);
+  for (const component of first.components) {
+    assert.ok(component.name && component.version, "every component needs a name and version");
+    if (component.source && component.source.startsWith("registry+")) {
+      assert.ok(/^[0-9a-f]{64}$/.test(component.checksum || ""), `${component.name} has no checksum`);
+    }
+  }
+  // The lockfile digest binds the SBOM to the graph it describes.
+  assert.strictEqual(first.lockfileSha256, sha(lockText));
+});
+
+ok("a registry crate without a checksum is refused", () => {
+  const broken = '[[package]]\nname = "x"\nversion = "1.0.0"\nsource = "registry+https://example.invalid"\n';
+  assert.throws(
+    () => buildSbom({ lockText: broken, packageJsonText: '{"name":"k","version":"1"}', toolchain: "t" }),
+    /no checksum/
+  );
+});
+
+console.log("third-party actions are pinned");
+ok("an unpinned action reference is detected", () => {
+  refuses(
+    () => assertActionsPinned("      - uses: actions/checkout@v4\n"),
+    "must be pinned to a 40-character commit sha"
+  );
+  refuses(
+    () => assertActionsPinned("      - uses: actions/checkout\n"),
+    "must be pinned to a 40-character commit sha"
+  );
+  // Local composite actions are fine: they are this repository's own code.
+  assert.strictEqual(assertActionsPinned("      - uses: ./.github/actions/build\n"), 1);
+  // A commit-pinned reference passes.
+  assert.strictEqual(
+    assertActionsPinned(`      - uses: actions/checkout@${"a".repeat(40)}\n`),
+    1
+  );
+});
+
+// Report (do not fail on) the repository's current pinning state: the owner has to supply the
+// reviewed commit SHAs, and the acceptance document records this as an open release-gate item.
+ok("the repository's current action pinning state is reported", () => {
+  const workflow = fs.readFileSync(path.join(ROOT, ".github/workflows/release.yml"), "utf8");
+  let pinned = 0;
+  let unpinned = 0;
+  for (const line of workflow.split("\n")) {
+    const trimmed = line.trim();
+    if (!trimmed.startsWith("- uses:") && !trimmed.startsWith("uses:")) continue;
+    const reference = trimmed.replace(/^(-\s*)?uses:\s*/, "");
+    if (reference.startsWith("./") || reference.startsWith(".github/")) continue;
+    const pin = reference.slice(reference.lastIndexOf("@") + 1);
+    if (/^[0-9a-f]{40}$/.test(pin)) pinned += 1;
+    else unpinned += 1;
+  }
+  console.log(
+    `       release.yml: ${pinned} pinned, ${unpinned} on mutable tags (owner must supply reviewed SHAs)`
+  );
+  assert.ok(pinned + unpinned > 0, "the workflow should reference at least one action");
+});
+
+console.log("");
+if (process.exitCode) {
+  console.error(`release pipeline suite FAILED after ${checks} passing check(s)`);
+} else {
+  console.log(`all ${checks} checks passed`);
+}
diff --git a/scripts/test-release-trust-root.js b/scripts/test-release-trust-root.js
new file mode 100644
index 0000000..70738d3
--- /dev/null
+++ b/scripts/test-release-trust-root.js
@@ -0,0 +1,267 @@
+#!/usr/bin/env node
+"use strict";
+
+/**
+ * T21 (KR-27) — release trust-root regressions, **test channel only**.
+ *
+ * This suite deliberately generates an ephemeral Ed25519 key pair in memory. It never writes the
+ * private key anywhere, never commits one, and never claims to be a production fixture: it exists to
+ * pin the *verification* behaviour that must hold once the owner supplies a real key.
+ *
+ * It also asserts the negative that matters most right now: `PRODUCTION_TRUSTED_KEYS` is empty and
+ * frozen, so a manifest signed by this test key is refused by the production entry. That is why T21's
+ * "real release candidate verifies" acceptance is BLOCKED — see docs/review/phase1_test_results/T21_acceptance.md.
+ *
+ * Run: node scripts/test-release-trust-root.js
+ */
+
+const assert = require("node:assert");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+
+const {
+  PRODUCTION_TRUSTED_KEYS,
+  buildCanonicalSigningPayload,
+  signManifest,
+  serializeManifest,
+  verifyManifest,
+  downloadBinaryIfNeeded
+} = require(path.join(__dirname, "..", "bin", "kroma.js"));
+
+let checks = 0;
+function ok(name, fn) {
+  return Promise.resolve()
+    .then(fn)
+    .then(() => {
+      checks += 1;
+      console.log(`  ok  ${name}`);
+    })
+    .catch((err) => {
+      console.error(`  FAIL ${name}\n       ${err && err.message}`);
+      process.exitCode = 1;
+    });
+}
+
+function throwsWith(fn, needle) {
+  try {
+    fn();
+  } catch (err) {
+    assert.ok(
+      String(err.message).includes(needle),
+      `expected error containing ${JSON.stringify(needle)}, got ${JSON.stringify(err.message)}`
+    );
+    return;
+  }
+  assert.fail(`expected an error containing ${JSON.stringify(needle)}, but nothing was thrown`);
+}
+
+/** An ephemeral test key pair. Never persisted. */
+function testKey(keyId) {
+  const { publicKey, privateKey } = crypto.generateKeyPairSync("ed25519");
+  // kroma.js accepts a raw 32-byte key as 64 hex characters (or PEM / KeyObject). The JWK export is
+  // the portable way to get exactly those 32 bytes out of a generated pair.
+  const raw = Buffer.from(publicKey.export({ format: "jwk" }).x, "base64url");
+  assert.strictEqual(raw.length, 32, "an ed25519 public key is 32 bytes");
+  return {
+    keyId,
+    privateKey,
+    trusted: { [keyId]: raw.toString("hex") }
+  };
+}
+
+function manifestFields(overrides = {}) {
+  return Object.assign(
+    {
+      schemaVersion: 1,
+      keyId: "test-channel",
+      version: "1.5.0",
+      target: "cli",
+      tarballUrl: "https://cobblemon.asia/releases/kroma-cli-1.5.0.tgz",
+      sha256: "a".repeat(64),
+      length: 1024,
+      expires: Math.floor(Date.now() / 1000) + 3600,
+      antirollback: "1.0.0"
+    },
+    overrides
+  );
+}
+
+function signed(key, overrides) {
+  const fields = manifestFields(Object.assign({ keyId: key.keyId }, overrides));
+  return serializeManifest(signManifest(fields, key.privateKey));
+}
+
+async function main() {
+  const key = testKey("test-channel");
+
+  console.log("Trust root state");
+  await ok("production trust root is empty and frozen (no placeholder keys)", () => {
+    assert.ok(Object.isFrozen(PRODUCTION_TRUSTED_KEYS), "PRODUCTION_TRUSTED_KEYS must be frozen");
+    assert.strictEqual(
+      Object.keys(PRODUCTION_TRUSTED_KEYS).length,
+      0,
+      "a placeholder key in the production trust root would be worse than none"
+    );
+  });
+
+  await ok("a test-key manifest is refused by the production entry", () => {
+    const text = signed(key);
+    throwsWith(() => verifyManifest(text), "trust root is unconfigured");
+    // ...and the test key does not accidentally appear in production.
+    assert.strictEqual(PRODUCTION_TRUSTED_KEYS[key.keyId], undefined);
+  });
+
+  console.log("manifest_binds_platform_version_and_artifact_hash");
+  await ok("the test-channel manifest verifies with the test key", () => {
+    const text = signed(key);
+    const manifest = verifyManifest(text, { trustedKeys: key.trusted, currentTarget: "cli" });
+    assert.strictEqual(manifest.version, "1.5.0");
+    assert.strictEqual(manifest.target, "cli");
+    assert.strictEqual(manifest.sha256, "a".repeat(64));
+  });
+
+  await ok("every bound field invalidates the signature when changed", () => {
+    const text = signed(key);
+    const parsed = JSON.parse(text);
+    // A changed keyId is not a signature failure: it selects a different (untrusted) key, and that
+    // refusal is asserted separately below.
+    for (const field of ["version", "target", "sha256", "length", "antirollback"]) {
+      const tampered = Object.assign({}, parsed);
+      if (field === "length") tampered.length = parsed.length + 1;
+      else if (field === "version") tampered.version = "9.9.9";
+      else if (field === "target") tampered.target = "linux-x64";
+      else if (field === "sha256") tampered.sha256 = "b".repeat(64);
+      else tampered.antirollback = "9.9.9";
+      throwsWith(
+        () => verifyManifest(JSON.stringify(tampered), { trustedKeys: key.trusted }),
+        "Signature verification failed"
+      );
+    }
+    // Changing the key id is caught by the trust-root lookup instead.
+    const renamed = Object.assign({}, parsed, { keyId: "other-key" });
+    throwsWith(
+      () => verifyManifest(JSON.stringify(renamed), { trustedKeys: key.trusted }),
+      "Unknown or untrusted signing key"
+    );
+  });
+
+  console.log("unknown_rotated_revoked_expired_key_is_rejected");
+  await ok("an unknown keyId is refused", () => {
+    const text = signed(key);
+    throwsWith(
+      () => verifyManifest(text, { trustedKeys: { "someone-else": Object.values(key.trusted)[0] } }),
+      "Unknown or untrusted signing key"
+    );
+  });
+
+  await ok("a revoked key (removed from the trusted map) is refused", () => {
+    const text = signed(key);
+    const rotated = {}; // the key was rotated away: the map no longer contains it
+    throwsWith(() => verifyManifest(text, { trustedKeys: rotated }), "trust root is unconfigured");
+    throwsWith(
+      () => verifyManifest(text, { trustedKeys: { "new-key": Object.values(key.trusted)[0] } }),
+      "Unknown or untrusted signing key"
+    );
+  });
+
+  await ok("an expired manifest is refused", () => {
+    const expired = signed(key, { expires: Math.floor(Date.now() / 1000) - 10 });
+    throwsWith(
+      () => verifyManifest(expired, { trustedKeys: key.trusted }),
+      "Manifest has expired"
+    );
+  });
+
+  await ok("a manifest for another target is refused", () => {
+    const text = signed(key);
+    throwsWith(
+      () => verifyManifest(text, { trustedKeys: key.trusted, currentTarget: "linux-x64" }),
+      "Manifest target mismatch"
+    );
+  });
+
+  await ok("a downgrade below the antirollback floor is refused", () => {
+    // The client compares the manifest's version and floor against the installed version itself, so a
+    // signed-but-older manifest is refused before anything is downloaded.
+    const text = signed(key, { version: "1.4.0", antirollback: "1.4.0" });
+    throwsWith(() => verifyManifest(text, { trustedKeys: key.trusted }), "downgrade rejected");
+
+    // A manifest at the installed version with a future floor is also refused: the floor is a promise
+    // about what may still be installed, not a comment.
+    const floorAbove = signed(key, { version: "1.5.0", antirollback: "9.9.9" });
+    throwsWith(
+      () => verifyManifest(floorAbove, { trustedKeys: key.trusted }),
+      "antirollback"
+    );
+  });
+
+  console.log("signature_failure_never_overwrites_existing_binary");
+  await ok("an existing binary is never replaced by a download attempt", async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "kroma-trust-"));
+    const dest = path.join(dir, "kroma");
+    const original = Buffer.from("original-binary-bytes");
+    fs.writeFileSync(dest, original);
+
+    // Even with a tampered manifest in hand, an existing binary short-circuits: nothing is fetched and
+    // nothing is written.
+    const tampered = JSON.parse(signed(key));
+    tampered.version = "9.9.9";
+    const result = await downloadBinaryIfNeeded(dest, "cli", {
+      trustedKeys: key.trusted,
+      manifestText: JSON.stringify(tampered)
+    });
+    assert.strictEqual(result, true, "an existing binary reports success without downloading");
+    assert.deepStrictEqual(fs.readFileSync(dest), original, "the binary was modified");
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+
+  await ok("a failed verification creates no file at all", async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "kroma-trust-"));
+    const dest = path.join(dir, "kroma");
+    const tampered = JSON.parse(signed(key));
+    tampered.sha256 = "c".repeat(64);
+    const result = await downloadBinaryIfNeeded(dest, "cli", {
+      trustedKeys: key.trusted,
+      manifestText: JSON.stringify(tampered)
+    });
+    assert.strictEqual(result, false, "a failed verification must report failure");
+    assert.ok(!fs.existsSync(dest), "a failed verification must not leave a binary behind");
+    const leftovers = fs.readdirSync(dir);
+    assert.deepStrictEqual(leftovers, [], `a failed verification left files: ${leftovers.join(", ")}`);
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+
+  await ok("an unconfigured trust root refuses before touching the disk", async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "kroma-trust-"));
+    const dest = path.join(dir, "kroma");
+    const result = await downloadBinaryIfNeeded(dest, "cli", {
+      manifestText: signed(key)
+    });
+    assert.strictEqual(result, false);
+    assert.ok(!fs.existsSync(dest));
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+
+  console.log("production_fixture_signed_by_release_key_verifies");
+  await ok("the production entry is fail-closed until the owner installs a key", () => {
+    // This is the honest state: there is no production fixture, so the check that a *real* release
+    // candidate verifies cannot be run. It is recorded as BLOCKED rather than faked with this key.
+    const text = signed(key);
+    throwsWith(() => verifyManifest(text), "trust root is unconfigured");
+    assert.strictEqual(Object.keys(PRODUCTION_TRUSTED_KEYS).length, 0);
+  });
+
+  console.log("");
+  if (process.exitCode) {
+    console.error(`release trust-root suite FAILED after ${checks} passing check(s)`);
+  } else {
+    console.log(`all ${checks} checks passed (test channel; no production key was used)`);
+  }
+}
+
+main().catch((err) => {
+  console.error(err && err.stack ? err.stack : err);
+  process.exitCode = 1;
+});
